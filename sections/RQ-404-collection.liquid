{% schema %}
{"name": "RQ 404 Collection","tag":"div","class":"RQ-404-collection","settings": [
    {"type":"header","content":"Heading"},
        {"type":"text","id":"heading","label":"Heading","default":"Heading"},
        {"type":"textarea","id":"description","label":"Description","default":"Description"},
        {"type":"collection","id":"collection","label":"Collection"},
        {"type":"text","id":"button_text","label":"Button text"}
],"presets":[{"name":"RQ 404 Collection"}],"templates":["404"]}
{% endschema %}
{% capture RQfeaturedCollection %}{%- liquid
    assign sfcs = section.settings
    assign loadMode = "jsLazy"
    assign collection = collections[section.settings.collection].products
    assign button = sfcs.button_text
    %}
<div class="RQ-featcollMnWrapper" section="RQ-404-collection">
  <div class="RQ-featcollWidthWrapper">
    {%- if sfcs.heading != blank or sfcs.description != blank -%}<div class="RQ-fdc-hd-ds">
      {%- if sfcs.heading != blank -%}<div class="RQ-fdc-hd">{{ sfcs.heading }}</div>{%- endif -%}
      {%- if sfcs.description != blank -%}<div class="RQ-fdc-ds">{{ sfcs.description }}</div>{%- endif -%}
    </div>{%- endif -%}
    <div class="swiper mySwiper Rqfeaturedslideshow"><div class="RQ-fdc-mg-bkMn swiper-wrapper">
      {%- for pd in collection -%}
        {%- liquid
            assign title = pd.title
            assign image = pd.featured_image
            assign url = pd.url
          -%}     
        <div class="RQ-fdcBlockEach swiper-slide">
          <div class="RQ-fdcBlockEachInner">
          <spd-img class="cdv-element show_all" data-imglink="{{ imgLink | default: 0 }}" data-load-mode="{{ loadMode }}">
            <div class="spd-img-wrapper">
            {%- liquid 
              if image != blank
              assign imgWidth = "800" | abs
              assign image = image
              assign classes = 'img-primary img-all'
              assign baseSrc = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E" 
              if imgWidth == blank
              assign imgWidth = image.width
              endif
              assign imgUrl = image | image_url: width: imgWidth
              assign imgFit = "contain" | prepend: 'fit-'
              assign imgFitM = bSt.imgFitM | default: 'contain' | prepend: 'fitM-' 
              endif
          -%}
            <img {% if loadMode == 'speedLoad' -%}src="{{ imgUrl }}" {%- else %} src="{{ baseSrc }}" data-src="{{ imgUrl }}" {% endif -%}height="{{ image.height }}" width="{{ image.width }}" class="spd-img-{{ secId }}{{ loopId }}-{% increment imageId %} {{ classes }} {{ loadMode }} {{ imgFit }} {{ imgFitM | default: 'fitM-contain' }}" {{ attributes }} alt=""> 
           <button data-with-epi="true" class="swym-button swym-add-to-wishlist-view-product product_{{pd.id}}" data-swaction="addToWishlist" data-product-id="{{pd.id | json}}" data-variant-id="{{pd.variants[0].id}}" data-product-url="{{ shop.url }}{{ pd.url }}"></button>  
            </div>
          </spd-img>
          <div class="CmbbtRqDt">{%- if title != blank -%}<div class="RQ-fdc-bk-title">{{ title }}</div>{%- endif -%}
          <div class="cmbpriceCb show_mb">{% if pd.compare_at_price != blank %}<span class="cmbcpprc">{{ pd.compare_at_price | money }}</span>{% endif %}<span class="cmbprc">{{ pd.price | money }}</span></div>
          {%- if button != blank -%}<div class="RQ-fdc-bk-btn"><a href="{{ url }}">{{ button }}</a></div>{%- endif -%}</div>
        </div>
        </div>
      {%- endfor -%}
    </div><div class="swiper-button-next arrsdnxt NextButtonSlideshowfd"></div><div class="swiper-button-prev arrsdprev PrevButtonSlideShowfd"></div> <div class="swiper-pagination paginationSlideshowbannerfd"></div></div>
  </div>
</div>{% endcapture %}{{ RQfeaturedCollection | strip_newlines }}