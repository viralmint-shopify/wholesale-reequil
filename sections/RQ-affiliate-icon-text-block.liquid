{%- schema -%}
{"name": "RQ affiliate icons","tag":"div","class":"RQ-affiliate-content","settings":[
    {"type":"header","content":"Heading"},
      {"type": "text","id": "heading","label": "Heading"},
      {"type": "textarea","id": "sub_heading","label": "Sub Heading"}
],"blocks": [{"name": "Icon content brief","type": "icon_content_brief","settings":[
    {"type":"header","content":"Icon Brief"},
      {"type": "image_picker","id": "icon_mg","label": "Icon"},
      {"type": "text","id": "title","label": "Title"},
      {"type": "richtext","id": "brief","label": "Brief"},
      {"type":"text","id":"cta_text","label":"Button"},
      {"type":"url","id":"cta_link","label":"Link"}  
]}],"presets":[{"name":"RQ affiliate icons"}],"templates":["page"]}
{%- endschema -%}
{%- capture AffiliateIconTextBlock -%}{%- liquid
    assign SafIcSt = section.settings   
    assign SafIcStbk = section.blocks
    assign heading = SafIcSt.heading
    assign sub_heading = SafIcSt.sub_heading    
    assign loadMode = "jsLazy"
   -%}
<div class="RQ-affiliateiconBkSectionWrapper" section="RQ-affiliate-content">   
  <div class="RQAffiliateiconBkWP">
    {%- if heading != blank -%}<div class="RQafficbhd">{{ heading }}</div>{%- endif -%}
    {%- if sub_heading != blank -%}<div class="RQafficbshd">{{ sub_heading }}</div>{%- endif -%}
    <div class="BlockMainContainerAffiliateIbk">
      {%- for Abk in SafIcStbk -%}
          {%- liquid
              assign AbkSt = Abk.settings 
              assign icon = AbkSt.icon_mg
              assign title = AbkSt.title
              assign brief = AbkSt.brief
              assign cta_text = AbkSt.cta_text
              assign cta_link = AbkSt.cta_link
             -%}
        <div class="IConTextBlokhng"><div class="IconBlockWpMn">
          {%- if icon != blank -%}<div class="IconmmgAft">
            <spd-img class="cdv-element show_all" data-imglink="{{ imgLink | default: 0 }}" data-load-mode="{{ loadMode }}">
              <div class="spd-img-wrapper">
              {%- liquid 
                if icon != blank 
                assign imgWidth = "800" | abs
                assign image = icon
                assign classes = 'img-primary img-all'
                assign baseSrc = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E" 
                if imgWidth == blank
                assign imgWidth = image.width
                endif
                assign imgUrl = image | image_url: width: imgWidth
                assign imgFit = "contain" | prepend: 'fit-'
                assign imgFitM = bSt.imgFitM | default: 'contain' | prepend: 'fitM-' 
                endif
            -%}
              <img {% if loadMode == 'speedLoad' -%}src="{{ imgUrl }}" {%- else %} src="{{ baseSrc }}" data-src="{{ imgUrl }}" {% endif -%}height="{{ image.height }}" width="{{ image.width }}" class="spd-img-{{ secId }}{{ loopId }}-{% increment imageId %} {{ classes }} {{ loadMode }} {{ imgFit }} {{ imgFitM | default: 'fitM-contain' }}" {{ attributes }} alt=""> 
              </div>
            </spd-img>
          </div>{%- endif -%}
          {%- if title != blank -%}<div class="RQafficontxthd">{{ title }}</div>{%- endif -%}
          {%- if brief != blank -%}<div class="RQafficontxtshd">{{ brief }}</div>{%- endif -%}
          {%- if cta_text != blank -%}<div class="RQafficontxtBtn"><a href="{{ cta_link | default:'#' }}">{{ cta_text }}</a></div>{%- endif -%}          
        </div></div>
      {%- endfor -%}
    </div>
  </div>
</div>{%- endcapture -%}{{ AffiliateIconTextBlock | strip_newlines }}