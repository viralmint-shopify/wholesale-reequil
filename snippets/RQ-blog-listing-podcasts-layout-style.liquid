{%- style -%}
.breadcrumbs__list {
    padding: 0;
}
.RQBreadCrumbsLayout {
    max-width: 1113px;
}
.RQ-MnlistPodCastWp {
    max-width: 1113px;
    margin: auto;
    padding: 0 24px;
}
.RQ-MainListingpodcastTemWp {
    padding: 40px 0 28px;
}
.subheadingpodcast {
    font-size: 20px;
    line-height: 140%;
    color: #7D7B9E;
    margin: 0 0 6px;
}
.headingpodcast {
    font-weight: 600;
    font-size: 42px;
    line-height: 140%;
    color: #27235E;
    margin: 0 0 24px;
}
.Descriptionpodcast {
    font-size: 16px;
    line-height: 150%;
    letter-spacing: 0.04em;
    color: #333333;
    max-width: 884px;
}
.IframePodcastFeatured {
    line-height: 1;
}
.EpisodesPodcastListArticalWp {
    margin: 116px 0 0;
}
.Episodehading {
    font-weight: 600;
    font-size: 42px;
    line-height: 140%;
    color: #27235E;
    margin: 0 0 24px;
}
.ArticlesPodcastEpisodeEach>a {
    display: flex;
    align-items: center;
    padding: 20px;
    box-shadow: 4px 4px 13px transparent;
    transition: ease .3s;
}

.ArticleImgWoEspidodePfd img {
    width: 100%;
    display: block;
}
.ArticleImgWoEspidodePfd {
    flex: 0 0 200px;
    margin-right: 34px;
}
.TileEpisodeart {
    font-weight: 600;
    font-size: 24px;
    line-height: 140%;
    color: #27235E;
    margin: 0 0 20px;
}
.Exceptarticleep p {
    font-size: 16px;
    line-height: 150%;
    letter-spacing: 0.04em;
    color: #333333;
    opacity: 0.8;
    max-width: 702px;
    margin: 0 0 14px;
}
.iconplayepiside {
    display: flex;
    align-items: center;
}
.CombinedetailOfPodcast {
    margin: 0 0 42px;
}
.ArticlesPodcastEpisodeEach {
    margin: 0 0 36px;
}
.ArticlesPodcastEpisodeEach:last-child {
    margin: 0px;
}
body .pagination-wrapper {
    margin: 10px 0 0;
}
body .pagination__list {
    justify-content: flex-end;
}
body .pagination__item--current:after, body .pagination__item:hover:after {
    display: none;
}
body .pagination__item {
    font-size: 16px;
    line-height: 140%;
    text-align: center;
    color: #333333;
    opacity: 0.8;
    height: auto;
}
body .pagination__item.pagination__item--current {
    text-decoration-line: underline;
    color: #27235E;
    opacity: 1;
}
body .pagination__list>li:not(:last-child) {
    margin-right: 2px;
    flex: 0 0 25px;
}
.pagination__item svg.icon.icon-caret {
    position: relative;
    top: -2.5px;
}
body .pagination__item--prev .icon {
    width: 25px;
}
body .pagination__list>li {
    flex: inherit;
}

/* media css start here */

@media (min-width: 750px) {
.CombinedetailOfPodcast.mbdatre {
    display: none;
}
.ArticlesPodcastEpisodeEach a:hover {
    box-shadow: 4px 4px 13px rgb(0 0 0 / 25%);
}
}
@media (max-width: 1279px) {
.headingpodcast, .Episodehading {
    font-size: 34px;
}
.ArticleImgWoEspidodePfd {
    margin-right: 20px;
}
}
@media (max-width: 1023px) {
.RQ-MainListingpodcastTemWp {
    padding: 12px 0 28px;
}
.headingpodcast, .Episodehading {
    font-size: 28px;
}
.TileEpisodeart {
    font-size: 18px;
    margin: 0 0 8px;
}
.ArticlesPodcastEpisodeEach {
    margin: 0 0 20px;
}
.EpisodesPodcastListArticalWp {
    margin: 64px 0 0;
}
}
@media (max-width: 749px) {
.RqArticleCardInfo {
    line-height: 1;
}
.RqArticleCardInfo span {
    font-size: 12px;
    line-height: 140%;
    color: #333333;
    opacity: .8;
    display: inline-block;
}
.RqArticleCardInfo .circle-divider {
    padding-left: 17px;
    display: none;
}
.RqArticleCardInfo time {
    position: relative;
}
.RqArticleCardInfo time:before {
    content: '';
    background: #333333;
    opacity: .8;
    width: 5px;
    height: 5px;
    border-radius: 100px;
    display: inline-block;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    left: -13px;
}
.subheadingpodcast, .Exceptarticleep, .iconplayepiside {
    display: none;
}
.breadcrumbs__list {
    margin: 12px 0;
}
.headingpodcast {
    font-size: 20px;
    margin: 0 0 18px;
}
.CombinedetailOfPodcast {
    margin: 0;
}
.IframePodcastFeatured {
    margin: 0 0 24px;
}
.Descriptionpodcast {
    font-size: 14px;
}
.Episodehading {
    font-size: 20px;
    margin: 0 0 12px;
}
.ArticleImgWoEspidodePfd {
    flex: 0 0 70px;
    margin-right: 12px;
}
.TileEpisodeart {
    font-size: 14px;
    color: #333333;
    font-weight: 400;
}
.ArticlesPodcastEpisodeEach>a {
    padding: 0;
}
}

{%- endstyle -%}