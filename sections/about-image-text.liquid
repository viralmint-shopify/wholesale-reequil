  {% if section.settings.image  != blank or section.settings.video_content != blank%}
<div class="about_image_text_wraper">
  <div class="about-imagetext-inner">
<div class="imagetext_outer-wrapp">
  {% if section.settings.video_content != blank %}
  <div class="imegetext_text-wrapp fordesktop">
    {{ section.settings.video_content }}
  </div>
  {% endif %}
  
  {% if section.settings.image  != blank %}
  <div class="imagetext_inner-wrapp">
<img src="{{ section.settings.image | img_url:'master' }}">
  </div>
  {% endif %}

</div>
      {% if section.settings.video_content != blank %}
  <div class="imegetext_text-wrapp show_mb">
    {{ section.settings.video_content }}
  </div>
  {% endif %}
  </div>
</div>
{% endif %}
{% schema %}
  {
    "name": "About Image With Text",
    "settings": [
              {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
                    {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
                                {
          "type": "richtext",
          "id": "video_content",
          "label": "Content"
        }
    ],
      "presets": [
    {
      "name": "About Image With Text"
    }
  ]
  }
{% endschema %}