{%- style -%}
.ExecuteMainPodcastWrapperWxt {
    max-width: 1112px;
    margin: auto;
    padding: 0 24px;
} 
.RQBreadCrumbsLayout {
    max-width: 1112px;
}
.breadcrumbs__list {
    padding: 0;
}
.ArticleImgWoEspidodePfd img {
    display: block;
    width: 100%;
}
.ArticlesPodcastEpisodeEach>a {
    box-shadow: 4px 4px 13px transparent;
    padding: 20px;
    display: flex;
    align-items: center;
    transition: ease .3s;
}
.ArticleImgWoEspidodePfd {
    position: relative;
    flex: 0 0 303px;
    margin-right: 19px;
} 
.iconplayepiside {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    margin: auto;
    display: flex;
    justify-content: center;
    transform: translateY(-50%);
    opacity: 0.47;
}
.iconplayepiside svg {
    width: 58px;
    height: 58px;
}
.TileEpisodeart {
    font-weight: 600;
    font-size: 24px;
    line-height: 140%;
    color: #27235E;
    margin: 0 0 20px;
}
.Exceptarticleep p {
    font-size: 16px;
    line-height: 150%;
    letter-spacing: 0.04em;
    color: #333333;
    opacity: 0.8;
    margin: 0;
}
.ArticlesPodcastEpisodeEach {
    margin: 0 0 30px;
}
.ArticlesPodcastEpisodeEach:last-child {
    margin: 0px;
}
footer.mnFooterExutionWp {
    margin-top: 116px;
}
body .pagination-wrapper {
    margin: 10px 0 0;
}
body .pagination__list {
    justify-content: flex-end;
}
body .pagination__list>li:not(:last-child) {
    margin-right: 2px;
    flex: 0 0 25px;
}
body .pagination__item.pagination__item--current {
    text-decoration-line: underline;
    color: #27235E;
    opacity: 1;
}
body .pagination__item {
    font-size: 16px;
    line-height: 140%;
    text-align: center;
    color: #333333;
    opacity: 0.8;
    height: auto;
}
/* media css start here */

@media (min-width: 750px) {
.ArticlesPodcastEpisodeEach>a:hover {
    box-shadow: 4px 4px 13px rgb(0 0 0 / 25%);
}
}

@media (max-width: 1023px) {
.TileEpisodeart {
    font-size: 20px;
    margin: 0 0 10px;
}
footer.mnFooterExutionWp {
    margin-top: 64px;
}
.Exceptarticleep p {
    font-size: 14px;
}
}
 
@media (max-width: 749px) {
.ExecuteMainPodcastWrapperWxt {
    padding: 0 14px;
}
.ArticlesPodcastEpisodeEach>a {
    padding: 10px;
    display: block;
    border: 1px solid #F6F6F6;
}
.ArticleImgWoEspidodePfd {
    flex: inherit;
    margin-right: 0;
    border: 1px solid rgba(0, 0, 0, 0.1);
}
.iconplayepiside svg {
    width: 56px;
    height: 56px;
}
.TileEpisodeart {
    font-weight: 400;
    font-size: 16px;
    margin: 8px 0 0;
}
.ArticlesPodcastEpisodeEach {
    margin: 0 0 22px;
}
.iconplayepiside {
    opacity: 0.58;
}
}
  
{%- endstyle -%}