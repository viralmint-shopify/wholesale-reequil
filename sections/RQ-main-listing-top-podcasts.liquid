{% schema %}
{"name": "Main Listing Top Podcasts","class":"MainListingTopPodcasts","tag":"div","settings": [
    {"type":"header","content":"Main Top Podcast"},
      {"type":"text","id":"heading","label":"Heading"},
      {"type":"blog","id":"podcast_blog","label":"Top prodcasts"},
      {"type":"text","id":"cta_text","label":"CTA text"},
      {"type":"url","id":"cta_link","label":"CTA link"}
],"presets":[{"name":"Main Listing Top Podcasts"}],"templates":["page"]}
{% endschema %}
{%- capture MainListingTopPodcast -%}{%- liquid
    assign SstP = section.settings
    assign Heading = SstP.heading
    assign Blog = SstP.podcast_blog
    assign Button = SstP.cta_text
    assign Link = SstP.cta_link
    assign TopPodcasts = blogs[Blog].articles
    assign loadMode = "jsLazy"
  -%}
<div class="MainTopListingPodcastWrapper RqTopPodCastSec" section="RQ-main-listing-top-podcasts">
  <div class="RqPodCastWrap">
      {%- if Heading != blank or Button != blank -%}<div class="RqPodCastHead">
          {%- if Heading != blank -%}
            <h2 class="RqPodCastHeading">
              {{ Heading }}
              {% if settings.catch_the_santa == true %}
                <div class="SantaMediaMn" snippet="santa_media">
                  <div class="SantaMediaWrpr">
                    <div class="SantaMediaInit"><img src="https://cdn.shopify.com/s/files/1/0306/6262/3364/files/cartoon-grin-face-with-santa-hat-generative-ai-removebg-preview_1.png?v=1703070878"></div>
                  </div>
                </div>
              {% endif %}
            </h2>
          {%- endif -%}
          {%- if Button != blank -%}<div class="rqPodcstViewMoreBtn">
              <a href="{{ Link | default:'!#' }}">{{ Button }}</a>
          </div>{%- endif -%}
      </div>{%- endif -%}
      <div class="TopPodCastCategory swiper mySwiper RQTopProdcatsSlideshow"><div class="TopPodCastCategoryCnt swiper-wrapper">
          {%- for article in TopPodcasts limit:4 -%}
              <div class="TopPodCastCategoryItem swiper-slide">
                  <div class="TopPdCstCtgrItmBox">
                      <a href="{{ article.url }}">
                          <div class="TopPdCstImg">
                              <spd-img class="cdv-element show_all" data-imglink="{{ imgLink | default: 0 }}" data-load-mode="{{ loadMode }}">
                                <div class="spd-img-wrapper">
                                {%- liquid 
                                  if article.image != blank
                                  assign imgWidth = "800" | abs
                                  assign image = article.image
                                  assign classes = 'img-primary img-all'
                                  assign baseSrc = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E" 
                                  if imgWidth == blank
                                  assign imgWidth = image.width
                                  endif
                                  assign imgUrl = image | image_url: width: imgWidth
                                  assign imgFit = "contain" | prepend: 'fit-'
                                  assign imgFitM = bSt.imgFitM | default: 'contain' | prepend: 'fitM-' 
                                  endif
                              -%}
                                <img {% if loadMode == 'speedLoad' -%}src="{{ imgUrl }}" {%- else %} src="{{ baseSrc }}" data-src="{{ imgUrl }}" {% endif -%}height="{{ image.height }}" width="{{ image.width }}" class="spd-img-{{ secId }}{{ loopId }}-{% increment imageId %} {{ classes }} {{ loadMode }} {{ imgFit }} {{ imgFitM | default: 'fitM-contain' }}" {{ attributes }} alt=""> 
                                </div>
                              </spd-img>
                              <span class="pdCstPlBtn">
                                  <svg width="83" height="83" viewBox="0 0 83 83" fill="none" xmlns="http://www.w3.org/2000/svg">
                                  <path fill-rule="evenodd" clip-rule="evenodd" d="M41.5 83C64.4198 83 83 64.4198 83 41.5C83 18.5802 64.4198 0 41.5 0C18.5802 0 0 18.5802 0 41.5C0 64.4198 18.5802 83 41.5 83ZM32 58.3205L62 41L32 23.6795L32 58.3205Z" fill="black" fill-opacity="0.58"/>
                                  </svg>
                              </span>
                          </div>
                          <div class="TopPdCstDes">
                              <h2>{{ article.title }}</h2>
                              <div class="RqArticleCardInfo">
                                  <span class="RqArticleDate">{{ article.published_at | date: "%d. %m. %Y" }}</span>
                                  <span class="circle-divider">
                                  {%- assign words = article.content | strip_html | split:' ' -%}
                                  {%- assign readtime = words.size | divided_by: 180 | round | at_least: 1 -%}
                                  {%- if words < 360 -%}
                                    <time>1 Min</time>
                                  {%- else -%} 
                                    <time>{{ readtime }} Mins</time>
                                  {%- endif -%} 
                                  </span>
                              </div>
                          </div>
                      </a>
                  </div>
              </div>
            {%- endfor -%}                                    
          </div><div class="PaginationWithFractionRecomm"><div class="swiper-button-prev arrsdprev PrevButtonSlideShowfd"></div><div class="swiper-pagination paginationFractionWp"></div><div class="swiper-button-next arrsdnxt NextButtonSlideshowfd"></div></div></div>
  </div>
</div>{%- endcapture -%}{{ MainListingTopPodcast | strip_newlines }}