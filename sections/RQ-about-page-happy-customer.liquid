{% schema %}
{"name": "RQ Happy Customer","tag":"div","class":"RQ-about-page-happy-customer","settings": [
    {"type":"header","content":"Heading"},
        {"type":"text","id":"heading","label":"Heading"},
        {"type":"textarea","id":"description","label":"Description"}
],"blocks":[{"type":"moments","name":"Moments","settings":[
    {"type":"header","content":"Moments"}, 
        {"type":"text","id":"count","label":"Count"},
        {"type":"textarea","id":"message","label":"Message"}
]}],"presets":[{"name":"RQ Happy Customer"}],"templates":["page"]}
{% endschema %}
{% capture AboutPageHappyCustomers %}{%- liquid
    assign sabthc = section.settings
    assign sabthcbk = section.blocks
    assign heading = sabthc.heading
    assign description = sabthc.description    
    %}
<div class="RQ-abthpMnWrapper" section="RQ-about-page-happy-customer"> 
  <div class="RQ-abthpWidthWrapper">     
    {%- if heading != blank or description != blank -%}<div class="RQ-abthp-hd-ds">
      {%- if heading != blank -%}<div class="RQ-abthp-hd">{{ heading }}</div>{%- endif -%}
      {%- if description != blank -%}<div class="RQ-abthp-ds">{{ description }}</div>{%- endif -%}
    </div>{%- endif -%}
    <div class="RQ-hp-mg-bkMn">
      <div class="RQ-hp-mg-bkMnInner">
      {%- for bk in sabthcbk -%}
        {%- liquid
            assign bKs = bk.settings
            assign count = bKs.count
            assign message = bKs.message
          -%}     
        {%- if count != blank or message != blank -%}<div class="RQ-hpBlockEach">
          {%- if count != blank -%}<div class="RQ-hp-bk-count">{{ count }}</div>{%- endif -%}
          {%- if message != blank -%}<div class="RQ-hp-bk-message">{{ message }}</div>{%- endif -%}
        </div>{%- endif -%}
      {%- endfor -%}
      </div>
    </div>  
  </div>
</div>{% endcapture %}{{ AboutPageHappyCustomers | strip_newlines }}