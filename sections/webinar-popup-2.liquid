</div>
    <div class="webinar-image-text-wrapper">
<div class="popup_inner_image">
  <a {% if section.settings.popup_url != blank %}href="{{ section.settings.popup_url }}"{% endif %}>
   {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | img_url:'master' }}" class="for-desktop">
     {% else %}
     {% if section.settings.mobile_image != blank %}
      <img src="{{ section.settings.mobile_image | img_url:'master' }}" class="for-desktop">
    {% endif %}
     {% endif %}
     {% if section.settings.mobile_image != blank %}
       <img src="{{ section.settings.mobile_image | img_url:'master' }}" class="for-mobile">
       {% else %}
        {% if section.settings.image != blank %}
       <img src="{{ section.settings.image | img_url:'master' }}" class="for-mobile">
    {% endif %}
       {% endif %}
    
  </a>
</div>
    </div>
  </div>
</div>
{% endif %}
{% schema %}
  {
    "name": "Webinar Popup",
    "settings": [
              {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
                    {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image"
        },
                   {
          "type": "url",
          "id": "popup_url",
          "label": "Popup URL"
        }
    ]
  }
{% endschema %}

