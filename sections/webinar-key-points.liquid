{% if section.blocks.size > 0 %}
<div class="webinar-key-points-wrapp">
  <div class="key_points_inner_wrapp">
    {% if section.settings.heading != blank %}
    <div class="key-heading">
      <h2>{{ section.settings.heading }}</h2>
    </div>
    {% endif %}
    <div class="bottom_all_coloms_wrapp">
      {% for block in section.blocks %}
          {% if block.settings.image != blank or block.settings.content != blank  %}
        <div class="multicolumn_inner_rpeater">
          <div class="custom_outer-key-points">
                    {% if block.settings.image != blank %}
          <div class="key-image">
            <img src="{{ block.settings.image | img_url:'master' }}">
          </div>
          {% endif %}
        {% if block.settings.content != blank %}
          <div class="key_text"><p>{{ block.settings.content }}</p></div>
          {% endif %}
          </div>

        </div>
            {% endif %}
        {% endfor %}
    </div>
  </div>
</div>
{% endif %}
{% schema %}
  {
    "name": "Key Points",
    "settings": [
                          {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        }
    ],
      "blocks": [
    {
      "type": "column",
      "name": "Column",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "image"
        },
                {
          "type": "text",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ],
      "presets": [
    {
      "name": "Key Points"
    }
  ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

