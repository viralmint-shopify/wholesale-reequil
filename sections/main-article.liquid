{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}
{% render 'blog-listing-article-style' %}

<article class="article-template" itemscope itemtype="http://schema.org/BlogPosting">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when '@app' -%}
        <div class="page-width page-width--narrow">
          {% render block %}
        </div>
      {%- when 'featured_image'-%}
        {%- if article.image -%}
          <div class="article-template__hero-container" {{ block.shopify_attributes }}>
            <div class="article-template__hero-{{ block.settings.image_height }} media"
              itemprop="image"
              {% if block.settings.image_height == 'adapt' and article.image %} style="padding-bottom: {{ 1 | divided_by: article.image.aspect_ratio | times: 100 }}%;"{% endif %}
            >
              <img
                srcset="{% if article.image.width >= 350 %}{{ article.image | image_url: width: 350 }} 350w,{% endif %}
                  {% if article.image.width >= 750 %}{{ article.image | image_url: width: 750 }} 750w,{% endif %}
                  {% if article.image.width >= 1100 %}{{ article.image | image_url: width: 1100 }} 1100w,{% endif %}
                  {% if article.image.width >= 1500 %}{{ article.image | image_url: width: 1500 }} 1500w,{% endif %}
                  {% if article.image.width >= 2200 %}{{ article.image | image_url: width: 2200 }} 2200w,{% endif %}
                  {% if article.image.width >= 3000 %}{{ article.image | image_url: width: 3000 }} 3000w,{% endif %}
                  {{ article.image | image_url }} {{ article.image.width }}w"
                sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw"
                src="{{ article.image | image_url: width: 1100 }}"
                loading="eager"
                width="{{ article.image.width }}"
                height="{{ article.image.height }}"
                alt="{{ article.image.alt | escape }}">
            </div>
          </div>
        {%- endif -%}

        {%- when 'content'-%}
          <div class="article-template__content page-width page-width--narrow rte" itemprop="articleBody" {{ block.shopify_attributes }}>
              {{ article.content }}
          </div>
      
        {%- when 'title'-%}
          <header class="page-width page-width--narrow" {{ block.shopify_attributes }}><h1 class="article-template__title" itemprop="headline">{{ article.title | escape }}</h1></header>

        {%- when 'share' -%}

        <div class="DetailsCombineAuthoreWpr">
          <div class="ArticleDateTileField">
          {% comment %}<div class="Authorimagearticle">
            <span class="article__author--avatar">
              <img src="{{ article.user.image | img_url: 'master' }}" alt="{{ article.author }}">
            </span> 
          </div>{% endcomment %}
          <div class="DataWithAuthorDetails">
            {%- if block.settings.blog_show_author -%}
              <span class="authorname cpalternate caption-with-letter-spacing" itemprop="author" itemscope itemtype="http://schema.org/Person">
                <span itemprop="name">Author : {% if article.author contains 'Manasi' %}Dr{% endif %} {{ article.author }}</span>
              </span>
            {%- endif -%}
            {%- if block.settings.blog_show_date -%}
              <span class="publishedArtcile cpalternate caption-with-letter-spacing" itemprop="dateCreated pubdate datePublished">{{ article.published_at | time_tag: format: 'date' }}</span>
            {%- endif -%}  
          </div>
          <span class="AuthorNameBio cpalternate show_mb">{{ article.user.bio }}</span>
          <div class="SharingArticleWap article-template__social-sharing" {{ block.shopify_attributes }}>
            <share-button class="share-button" {{ block.shopify_attributes }}>
              <button class="share-button__button hidden">
                {{ block.settings.share_label | escape }}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect opacity="0.1" width="24" height="24" rx="4" fill="#27235E"/><path d="M18.4642 12.8025C18.1792 12.8025 17.9392 12.585 17.9017 12.3C17.7217 10.605 16.8067 9.06752 15.3967 8.09252C15.1417 7.91252 15.0817 7.56752 15.2542 7.31252C15.4342 7.05752 15.7867 6.99752 16.0342 7.17002C17.7142 8.33252 18.7942 10.1625 19.0117 12.18C19.0417 12.4875 18.8242 12.765 18.5092 12.8025C18.5017 12.8025 18.4792 12.8025 18.4642 12.8025Z" fill="#27235E"/><path d="M5.61987 12.84C5.59737 12.84 5.58237 12.84 5.55987 12.84C5.25237 12.8025 5.02737 12.525 5.05737 12.2175C5.25987 10.2 6.33237 8.37751 7.98987 7.20001C8.24487 7.02001 8.59737 7.08001 8.77737 7.33501C8.95737 7.59001 8.89737 7.94251 8.64237 8.12251C7.24737 9.10501 6.34737 10.6425 6.17487 12.3375C6.15237 12.6225 5.90487 12.84 5.61987 12.84Z" fill="#27235E"/><path d="M12.045 19.9575C10.935 19.9575 9.87747 19.7025 8.88747 19.2075C8.60997 19.065 8.49747 18.7275 8.63997 18.45C8.78247 18.1725 9.11997 18.06 9.39747 18.2025C11.0175 19.02 12.9675 19.035 14.6025 18.2475C14.88 18.1125 15.2175 18.2325 15.3525 18.51C15.4875 18.7875 15.3675 19.125 15.09 19.26C14.13 19.725 13.11 19.9575 12.045 19.9575Z" fill="#27235E"/><path d="M12.0459 9.33C10.5834 9.33 9.39844 8.145 9.39844 6.6825C9.39844 5.22 10.5834 4.035 12.0459 4.035C13.5084 4.035 14.6934 5.22 14.6934 6.6825C14.6934 8.145 13.5009 9.33 12.0459 9.33ZM12.0459 5.1675C11.2059 5.1675 10.5234 5.85 10.5234 6.69C10.5234 7.53 11.2059 8.2125 12.0459 8.2125C12.8859 8.2125 13.5684 7.53 13.5684 6.69C13.5684 5.85 12.8784 5.1675 12.0459 5.1675Z" fill="#27235E"/><path d="M6.62406 18.5025C5.16156 18.5025 3.97656 17.3175 3.97656 15.855C3.97656 14.4 5.16156 13.2075 6.62406 13.2075C8.08656 13.2075 9.27156 14.3925 9.27156 15.855C9.27156 17.31 8.08656 18.5025 6.62406 18.5025ZM6.62406 14.3325C5.78406 14.3325 5.10156 15.015 5.10156 15.855C5.10156 16.695 5.78406 17.3775 6.62406 17.3775C7.46406 17.3775 8.14656 16.695 8.14656 15.855C8.14656 15.015 7.46406 14.3325 6.62406 14.3325Z" fill="#27235E"/><path d="M17.3741 18.5025C15.9116 18.5025 14.7266 17.3175 14.7266 15.855C14.7266 14.4 15.9116 13.2075 17.3741 13.2075C18.8366 13.2075 20.0216 14.3925 20.0216 15.855C20.0141 17.31 18.8291 18.5025 17.3741 18.5025ZM17.3741 14.3325C16.5341 14.3325 15.8516 15.015 15.8516 15.855C15.8516 16.695 16.5341 17.3775 17.3741 17.3775C18.2141 17.3775 18.8966 16.695 18.8966 15.855C18.8891 15.015 18.2141 14.3325 17.3741 14.3325Z" fill="#27235E"/></svg>
              </button>
              <details id="Details-{{ block.id }}-{{ section.id }}">
                <summary class="share-button__button">
                  {{ block.settings.share_label | escape }}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect opacity="0.1" width="24" height="24" rx="4" fill="#27235E"/><path d="M18.4642 12.8025C18.1792 12.8025 17.9392 12.585 17.9017 12.3C17.7217 10.605 16.8067 9.06752 15.3967 8.09252C15.1417 7.91252 15.0817 7.56752 15.2542 7.31252C15.4342 7.05752 15.7867 6.99752 16.0342 7.17002C17.7142 8.33252 18.7942 10.1625 19.0117 12.18C19.0417 12.4875 18.8242 12.765 18.5092 12.8025C18.5017 12.8025 18.4792 12.8025 18.4642 12.8025Z" fill="#27235E"/><path d="M5.61987 12.84C5.59737 12.84 5.58237 12.84 5.55987 12.84C5.25237 12.8025 5.02737 12.525 5.05737 12.2175C5.25987 10.2 6.33237 8.37751 7.98987 7.20001C8.24487 7.02001 8.59737 7.08001 8.77737 7.33501C8.95737 7.59001 8.89737 7.94251 8.64237 8.12251C7.24737 9.10501 6.34737 10.6425 6.17487 12.3375C6.15237 12.6225 5.90487 12.84 5.61987 12.84Z" fill="#27235E"/><path d="M12.045 19.9575C10.935 19.9575 9.87747 19.7025 8.88747 19.2075C8.60997 19.065 8.49747 18.7275 8.63997 18.45C8.78247 18.1725 9.11997 18.06 9.39747 18.2025C11.0175 19.02 12.9675 19.035 14.6025 18.2475C14.88 18.1125 15.2175 18.2325 15.3525 18.51C15.4875 18.7875 15.3675 19.125 15.09 19.26C14.13 19.725 13.11 19.9575 12.045 19.9575Z" fill="#27235E"/><path d="M12.0459 9.33C10.5834 9.33 9.39844 8.145 9.39844 6.6825C9.39844 5.22 10.5834 4.035 12.0459 4.035C13.5084 4.035 14.6934 5.22 14.6934 6.6825C14.6934 8.145 13.5009 9.33 12.0459 9.33ZM12.0459 5.1675C11.2059 5.1675 10.5234 5.85 10.5234 6.69C10.5234 7.53 11.2059 8.2125 12.0459 8.2125C12.8859 8.2125 13.5684 7.53 13.5684 6.69C13.5684 5.85 12.8784 5.1675 12.0459 5.1675Z" fill="#27235E"/><path d="M6.62406 18.5025C5.16156 18.5025 3.97656 17.3175 3.97656 15.855C3.97656 14.4 5.16156 13.2075 6.62406 13.2075C8.08656 13.2075 9.27156 14.3925 9.27156 15.855C9.27156 17.31 8.08656 18.5025 6.62406 18.5025ZM6.62406 14.3325C5.78406 14.3325 5.10156 15.015 5.10156 15.855C5.10156 16.695 5.78406 17.3775 6.62406 17.3775C7.46406 17.3775 8.14656 16.695 8.14656 15.855C8.14656 15.015 7.46406 14.3325 6.62406 14.3325Z" fill="#27235E"/><path d="M17.3741 18.5025C15.9116 18.5025 14.7266 17.3175 14.7266 15.855C14.7266 14.4 15.9116 13.2075 17.3741 13.2075C18.8366 13.2075 20.0216 14.3925 20.0216 15.855C20.0141 17.31 18.8291 18.5025 17.3741 18.5025ZM17.3741 14.3325C16.5341 14.3325 15.8516 15.015 15.8516 15.855C15.8516 16.695 16.5341 17.3775 17.3741 17.3775C18.2141 17.3775 18.8966 16.695 18.8966 15.855C18.8891 15.015 18.2141 14.3325 17.3741 14.3325Z" fill="#27235E"/></svg>
                </summary>
                <div id="Article-share-{{ section.id }}" class="share-button__fallback motion-reduce">
                  <div class="field">
                    <span id="ShareMessage-{{ section.id }}" class="share-button__message hidden" role="status">
                    </span>
                    <input type="text"
                          class="field__input"
                          id="url"
                          value="{{ request.origin | append: article.url }}"
                          placeholder="{{ 'general.share.share_url' | t }}"
                          onclick="this.select();"
                          readonly
                    >
                    <label class="field__label" for="url">{{ 'general.share.share_url' | t }}</label>
                  </div>
                  <button class="share-button__close hidden no-js-hidden">
                    {% render 'icon-close' %}
                    <span class="visually-hidden">{{ 'general.share.close' | t }}</span>
                  </button>
                  <button class="share-button__copy no-js-hidden">
                    {% render 'icon-clipboard' %}
                    <span class="visually-hidden">{{ 'general.share.copy_to_clipboard' | t }}</span>
                  </button>
                </div>
              </details>
            </share-button>
            <script src="{{ 'share.js' | asset_url }}" defer="defer"></script>
          </div>      
          </div>
          <span class="AuthorNameBio cpalternate show_des">{{ article.user.bio }}</span>


         </div>
        {%- when 'related_products' -%}
        {%- if article.metafields.custom.related_product_list.value != blank -%}       
          <div class="RelatedProductsWrapper" {{ block.shopify_attributes }}>
            <div class="WrapperRelatedproductEx">
              {%- if block.settings.heading != blank -%}
              <div class="WrapperheadingRelated">
                <div class="hdrel">{{ block.settings.heading }}</div>
              </div>
              {%- endif -%}
              {%- assign loadMode = 'jsLazy' -%}
              {%- assign button = 'SHOP NOW'-%}
              <div class="swiper mySwiper MainRelatedArticlepodcasts"><div class="TabbingContentEztar RqTabOneContentRw swiper-wrapper">
                {%- for pd in article.metafields.custom.related_product_list.value -%}
                  <div class="CollectionRqDataWp swiper-slide"><div class="CollectionRqDataInner">
                    <a href="{{ pd.url }}"><spd-img class="cdv-element show_all" data-imglink="{{ imgLink | default: 0 }}" data-load-mode="{{ loadMode }}">
                      <div class="spd-img-wrapper">
                      {%- liquid 
                        if pd.featured_image != blank
                        assign imgWidth = "800" | abs
                        assign image = pd.featured_image
                        assign classes = 'img-primary img-all'
                        assign baseSrc = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E" 
                        if imgWidth == blank
                        assign imgWidth = image.width
                        endif
                        assign imgUrl = image | image_url: width: imgWidth
                        assign imgFit = "contain" | prepend: 'fit-'
                        assign imgFitM = bSt.imgFitM | default: 'contain' | prepend: 'fitM-' 
                        endif
                    -%}
                      <img {% if loadMode == 'speedLoad' -%}src="{{ imgUrl }}" {%- else %} src="{{ baseSrc }}" data-src="{{ imgUrl }}" {% endif -%}height="{{ image.height }}" width="{{ image.width }}" class="spd-img-{{ secId }}{{ loopId }}-{% increment imageId %} {{ classes }} {{ loadMode }} {{ imgFit }} {{ imgFitM | default: 'fitM-contain' }}" {{ attributes }} alt=""> 
                      </div>
                    </spd-img></a>  
                    {%- capture discount -%}
                    {%- assign DiscountComparePrice = pd.selected_or_first_available_variant.compare_at_price | money_without_currency | remove:',' | round -%}
                    {%- assign DiscountComparePrice = DiscountComparePrice | times: 1.0 -%}
                    {%- assign DiscountPrice = pd.selected_or_first_available_variant.price | money_without_currency | remove:',' | round -%}  
                    {{ DiscountComparePrice | minus:DiscountPrice | times:100 | divided_by:DiscountComparePrice | round }}%
                    {%- endcapture -%}                    
                    <div class="CmbbtRqDt">{%- if pd.title != blank -%}<a href="{{ pd.url }}"><div class="RQ-fdc-bk-title">{{ pd.title }}</div></a>{%- endif -%}
                    <div class="cmbpriceCb">{% if pd.compare_at_price > pd.price %}<span class="cmbcpprc">{{ pd.compare_at_price | money }}</span>{% endif %}<span class="cmbprc">{{ pd.price | money }}</span>{% if pd.selected_or_first_available_variant.compare_at_price > pd.selected_or_first_available_variant.price %}<span class="PriceWithpercentage">| {{discount | strip}} off</span>{% endif %}</div>
                    <span class="stamped-product-reviews-badge stamped-main-badge" data-id="{{ pd.id }}"
                      data-product-sku="{{ pd.handle }}" data-product-title="{{pd.title}}"
                      data-product-type="{{pd.type}}" style="display: block;">
                    </span>                       
                    {%- if button != blank -%}<div class="RQ-fdc-bk-btn"><a href="{{ pd.url }}">{{ button }}</a></div>{%- endif -%}</div>
                  </div></div>
                {%- endfor -%}
              </div><div class="PaginationWithFractionRecomm"><div class="swiper-button-prev arrsdprev PrevButtonSlideShowfd"></div><div class="swiper-pagination paginationFractionWp"></div><div class="swiper-button-next arrsdnxt NextButtonSlideshowfd"></div></div></div>
            </div>
          </div>       
          {%- endif -%}           
    {%- endcase -%}
  {%- endfor -%}

                 
  {%- assign EpisodeHeading = 'Next in the list' -%}{% assign loadMode = "jsLazy" %}
  <div class="RQ-MnlistPodCastWp">  
    <div class="EpisodesPodcastListArticalWp">
      <div class="ExecuteMainPodcastWrapperWxt">
        <div class="RqNextListVwMre">{%- if EpisodeHeading != blank -%}<div class="Episodehading">{{ EpisodeHeading }}</div>{%- endif -%}<div class="rqPodcstViewMoreBtn"><a href="/blogs/care-tips">View More</a></div></div>
        <div class="AllEpisodeEachMainWp">{% assign CurrentArticleHandle = article.handle %}
          {%- for article in blogs[blog.handle].articles limit:6-%}
            {% unless article.handle == CurrentArticleHandle %}            
            <div class="ArticlesPodcastEpisodeEach">
              <a href="{{ article.url }}">
                <div class="ArticleImgWoEspidodePfd">
                  <spd-img class="cdv-element show_all" data-imglink="{{ imgLink | default: 0 }}" data-load-mode="{{ loadMode }}">
                  <div class="spd-img-wrapper">
                  {%- liquid 
                    if article.image != blank
                    assign imgWidth = "800" | abs
                    assign image = article.image
                    assign classes = 'img-primary img-all'
                    assign baseSrc = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E" 
                    if imgWidth == blank
                    assign imgWidth = image.width
                    endif
                    assign imgUrl = image | image_url: width: imgWidth
                    assign imgFit = "contain" | prepend: 'fit-'
                    assign imgFitM = bSt.imgFitM | default: 'contain' | prepend: 'fitM-' 
                    endif
                  -%}
                  <img {% if loadMode == 'speedLoad' -%}src="{{ imgUrl }}" {%- else %} src="{{ baseSrc }}" data-src="{{ imgUrl }}" {% endif -%}height="{{ image.height }}" width="{{ image.width }}" class="spd-img-{{ secId }}{{ loopId }}-{% increment imageId %} {{ classes }} {{ loadMode }} {{ imgFit }} {{ imgFitM | default: 'fitM-contain' }}" {{ attributes }} alt=""> 
                  </div>
                 </spd-img>
                </div>
                <div class="MainConeEpisode">
                  <div class="TileEpisodeart">{{ article.title }}</div>
                  <div class="RqArticleCardInfo show_mb">
                      <span class="RqArticleDate">{{ article.published_at | date: "%d. %m. %Y" }}</span>
                  </div>                  
                  {%- if article.excerpt.size > 0 or article.content.size > 0 -%}<div class="Exceptarticleep">
                    <p>
                      {%- if article.excerpt.size > 0 -%}
                        {{ article.excerpt | strip_html | truncatewords: 30 }}
                      {%- else -%}
                        {{ article.content | strip_html | truncatewords: 30 }}
                      {%- endif -%}
                    </p>
                  </div>{%- endif -%}
                </div>
              </a>
            </div>
            {% endunless %}              
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>                    

 {% comment %} <div class="article-template__back element-margin-top center">
    <a href="{{ blog.url }}" class="article-template__link link animate-arrow">
      <span class="icon-wrap">{% render 'icon-arrow' %}</span>
      {{ 'blogs.article.back_to_blog' | t: title: blog.title }}
    </a>
  </div>
  {%- if blog.comments_enabled? -%}
    <div class="article-template__comment-wrapper background-secondary">
      <div id="comments" class="page-width page-width--narrow">
        {%- if article.comments_count > 0 -%}
          {%- assign anchorId = '#Comments-' | append: article.id -%}

          <h2 id="Comments-{{ article.id }}" tabindex="-1">{{ 'blogs.article.comments' | t: count: article.comments_count }}</h2>
          {% paginate article.comments by 5 %}
            <div class="article-template__comments">
              {%- if comment.status == 'pending' and comment.content -%}
                <article id="{{ comment.id }}" class="article-template__comments-comment">
                  {{ comment.content }}
                  <footer class="right">
                    <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span>
                  </footer>
                </article>
              {%- endif -%}

              {%- for comment in article.comments -%}
                <article id="{{ comment.id }}" class="article-template__comments-comment">
                  {{ comment.content }}
                  <footer class="right">
                    <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span><span class="caption-with-letter-spacing">{{ comment.created_at | time_tag: format: 'date' }}</span>
                  </footer>
                </article>
              {%- endfor -%}
              {% render 'pagination', paginate: paginate, anchor: anchorId %}
            </div>
          {% endpaginate %}
        {%- endif -%}
        {% form 'new_comment', article %}
          {%- liquid
            assign post_message = 'blogs.article.success'
            if blog.moderated? and comment.status == 'unapproved'
              assign post_message = 'blogs.article.success_moderated'
            endif
          -%}
          <h2>{{ 'blogs.article.comment_form_title' | t }}</h2>
          {%- if form.errors -%}
            <div class="form__message" role="alert">
              <h3 class="form-status caption-large text-body" tabindex="-1" autofocus>
                {% render 'icon-error' %} {{ 'templates.contact.form.error_heading' | t }}
              </h3>
            </div>
            <ul class="form-status-list caption-large">
              {%- for field in form.errors -%}
                <li>
                  <a href="#CommentForm-{{ field }}" class="link">
                    {%- if form.errors.translated_fields[field] contains 'author' -%}
                      {{ 'blogs.article.name' | t }}
                    {%- elsif form.errors.translated_fields[field] contains 'body'-%}
                     {{ 'blogs.article.message' | t }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] }}
                    {%- endif -%}
                    {{ form.errors.messages[field] }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- elsif form.posted_successfully? -%}
            <div class="form-status-list form__message" role="status">
              <h3 class="form-status" tabindex="-1" autofocus>{% render 'icon-success' %} {{ post_message | t }}</h3>
            </div>
          {%- endif -%}

          <div{% if blog.moderated? == false %} class="article-template__comments-fields"{% endif %}>
            <div class="article-template__comment-fields">
              <div class="field field--with-error">
                <input
                  type="text"
                  name="comment[author]"
                  id="CommentForm-author"
                  class="field__input"
                  autocomplete="name"
                  value="{{ form.author }}"
                  aria-required="true"
                  required
                  {% if form.errors contains 'author' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-author-error"
                  {% endif %}
                  placeholder="{{ 'blogs.article.name' | t }}"
                >
                <label class="field__label" for="CommentForm-author">{{ 'blogs.article.name' | t }} <span aria-hidden="true">*</span></label>
                {%- if form.errors contains 'author' -%}
                  <small id="CommentForm-author-error">
                    <span class="form__message">{% render 'icon-error' %}{{ 'blogs.article.name' | t }} {{ form.errors.messages['author'] }}.</span>
                  </small>
                {%- endif -%}
              </div>
              <div class="field field--with-error">
                <input
                  type="email"
                  name="comment[email]"
                  id="CommentForm-email"
                  autocomplete="email"
                  class="field__input"
                  value="{{ form.email }}"
                  autocorrect="off"
                  autocapitalize="off"
                  aria-required="true"
                  required
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-email-error"
                  {% endif %}
                  placeholder="{{ 'blogs.article.email' | t }}"
                >
                <label class="field__label" for="CommentForm-email">{{ 'blogs.article.email' | t }} <span aria-hidden="true">*</span></label>
                {%- if form.errors contains 'email' -%}
                  <small id="CommentForm-email-error">
                    <span class="form__message">{% render 'icon-error' %}{{ 'blogs.article.email' | t }} {{ form.errors.messages['email'] }}.</span>
                  </small>
                {%- endif -%}
              </div>
            </div>
            <div class="field field--with-error">
              <textarea
                rows="5"
                name="comment[body]"
                id="CommentForm-body"
                class="text-area field__input"
                aria-required="true"
                required
                {% if form.errors contains 'body' %}
                  aria-invalid="true"
                  aria-describedby="CommentForm-body-error"
                {% endif %}
                placeholder="{{ 'blogs.article.message' | t }}"
              >{{ form.body }}</textarea>
                <label class="form__label field__label" for="CommentForm-body">{{ 'blogs.article.message' | t }} <span aria-hidden="true">*</span></label>
            </div>
            {%- if form.errors contains 'body' -%}
              <small id="CommentForm-body-error">
                <span class="form__message">{% render 'icon-error' %}{{ 'blogs.article.message' | t }} {{ form.errors.messages['body'] }}.</span>
              </small>
            {%- endif -%}
          </div>
          {%- if blog.moderated? -%}
            <p class="article-template__comment-warning caption">{{ 'blogs.article.moderated' | t }}</p>
          {%- endif -%}
          <input type="submit" class="button" value="{{ 'blogs.article.post' | t }}">
        {% endform %}
      </div>
  </div>
  {%- endif -%}{% endcomment %}
</article>

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Article",
    "articleBody": {{ article.content | strip_html | json }},
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ request.origin | append: page.url | json }}
    },
    "headline": {{ article.title | json }},
    {% if article.excerpt != blank %}
      "description": {{ article.excerpt | strip_html | json }},
    {% endif %}
    {% if article.image %}
      "image": [
        {{ article | image_url: width: article.image.width | prepend: "https:" | json }}
      ],
    {% endif %}
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "dateCreated": {{ article.created_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "author": {
      "@type": "Person",
      "name": {{ article.author | json }}
    },
    "publisher": {
      "@type": "Organization",
      {% if settings.share_image %}
        "logo": {
          "@type": "ImageObject",
          "height": {{ settings.share_image.height | json }},
          "url": {{ settings.share_image | image_url: width: settings.share_image.width | prepend: "https:" | json }},
          "width": {{ settings.share_image.width | json }}
        },
      {% endif %}
      "name": {{ shop.name | json }}
    }
  }
  </script>


