{% schema %}
{"name":"Guide Multi articles","tag":"div","class":"RQ-multi-types-articles","settings":[
    {"type": "text","id": "heading","label": "Heading"},
    {"type": "text","id": "sub_heading","label": "Sub heading"},
    {"type":"textarea","id": "blog_filter","label":"Tab","default": "Hyperpigmentation,Dark Underarms","info": "EX. Hyperpigmentation,Dark Underarms"}
],"presets":[{"name":"Guide Multi articles"}],"templates":["blog"]}
{% endschema %}
{%- capture mainMultiArticlesWp -%}{%- liquid
    assign bArMsSt = section.settings   
    assign heading = bArMsSt.heading
    assign sub_heading = bArMsSt.sub_heading
    assign tab_data = bArMsSt.blog_filter
    assign loadMode = "jsLazy"
   -%}
  <div class="MainGuideBlogArticlesWrapperList" section="RQ-multi-types-articles-tab">
    <div class="WrapperArtcilesguides">
      <div class="HeaderArticlesWrapper">
        {%- if heading != blank -%}<div class="guidehdGt">{{ heading }}</div>{%- endif -%}
        {%- if sub_heading != blank -%}<div class="guidedshf">{{ sub_heading }}</div>{%- endif -%}
      </div> 
      <div class="BlogsArtcilesListWp">
        {%- assign customFilterTags = tab_data | split: ',' -%}
        {%- assign current_tags_handle = current_tags | handle -%}
        {%- for customFilter in customFilterTags -%}
        {%- for tag in blog.all_tags -%}
        {%- assign tag_handle = tag | handle -%}
            {%- assign customFilter_handle = customFilter | handle -%}
            {%- assign current_tag = tag -%}
            {%- if tag_handle == customFilter_handle -%}
            {%- capture articleGrid -%}
              {% for article in blog.articles %}
                  {% if article.tags contains current_tag %}
                      <div class="blog__post article swiper-slide">
                        <article class="Guidesarticle-card">
                          <a href="{{ article.url }}" class="article-content motion-reduce">
                            <div class="article-card__image-wrapper">
                              <div class="article-card__image media media--landscape">
                                <spd-img class="cdv-element show_all" data-imglink="{{ imgLink | default: 0 }}" data-load-mode="{{ loadMode }}">
                                  <div class="spd-img-wrapper">
                                  {%- liquid 
                                    if article.image != blank 
                                    assign imgWidth = "800" | abs
                                    assign image = article.image
                                    assign classes = 'img-primary img-all'
                                    assign baseSrc = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E" 
                                    if imgWidth == blank
                                    assign imgWidth = image.width
                                    endif
                                    assign imgUrl = image | image_url: width: imgWidth
                                    assign imgFit = "contain" | prepend: 'fit-'
                                    assign imgFitM = bSt.imgFitM | default: 'contain' | prepend: 'fitM-' 
                                    endif
                                -%}
                                  <img {% if loadMode == 'speedLoad' -%}src="{{ imgUrl }}" {%- else %} src="{{ baseSrc }}" data-src="{{ imgUrl }}" {% endif -%}height="{{ image.height }}" width="{{ image.width }}" class="spd-img-{{ secId }}{{ loopId }}-{% increment imageId %} {{ classes }} {{ loadMode }} {{ imgFit }} {{ imgFitM | default: 'fitM-contain' }}" {{ attributes }} alt=""> 
                                  </div>
                                </spd-img> 
                              </div>
                            </div>
                          </a>
                          <div class="article-card__info">
                            <header class="article-card__header">
                              <a href="{{ article.url }}">
                                <h2 class="article-card__title">{{ article.title }}</h2>
                              </a>
                              <p class="article-card__excerpt rte-width">
                                {%- if article.excerpt.size > 0 -%}
                                  {{ article.excerpt | strip_html | truncatewords: 30 }}
                                {%- else -%}
                                  {{ article.content | strip_html | truncatewords: 30 }}
                                {%- endif -%}
                              </p>
                              <div class="blog-date-auther-part">
                                <span class="caption-with-letter-spacing auther">{% if article.author contains 'Manasi' %}Dr{% endif %} {{ article.author }}</span>
                                <span class="block2"></span>
                                <span class="caption-with-letter-spacing date">{{ article.published_at | date: "%d. %m. %Y" }}</span>
                                <span class="block2"></span>
                                 {%- assign words = article.content | strip_html | split:' ' -%}
                                  {%- assign readtime = words.size | divided_by: 180 | round | at_least: 1 -%}
                                  {%- if words < 360 -%}
                                    <span class="caption-with-letter-spacing read-time">1 Min Read</span>
                                  {%- else -%} 
                                    <span class="caption-with-letter-spacing read-time">{{ readtime }} Min Read</span>
                                  {%- endif -%}                                 
                              </div>
                            </header>
                          </div>
                        </article>
                        <label class="image-label">{{ tag }}</label>
                      </div>
                  {% endif %}
              {% endfor %}
            {%- endcapture -%}
            {%- if articleGrid != blank -%}
            <div class="QuestionHolderWraoper">
              {%- if articleGrid != blank -%}
              <div class="BlogTitleWp">{{ tag | downcase }}</div>
              {%- endif -%}
              <ul class="custom-tabs">
              {% assign custom_tags = '' %}
              {% for article in blog.articles %}
              {% if article.tags contains current_tag %}
              {% for tagssssss in article.tags %}
                {% assign tegs = tagssssss %}
                  {% unless custom_tags contains tegs %}
                    {% assign custom_tags = custom_tags | join: ',' %}
                    {% assign custom_tags = custom_tags | append: ',' | append: tegs %} 
                    {% assign custom_tags = custom_tags | split: ',' %}
                    {% assign teg_handles = tegs | handle %}
                    {%- capture blogurl -%}
                    {{ blog.url }}/tagged/{{ tegs | handle }}
                    {%- endcapture -%}
                    {% assign blogurlcapture =  blogurl | split: '/' | last %}
                    {%- capture Current_Tag_Handle -%}
                    {{ current_tags | handle}}
                    {%- endcapture -%}
                    <li class="{% if blogurlcapture == Current_Tag_Handle %}active{% endif %}">
                      <a href="{{ blog.url }}/tagged/{{ tegs | handle }}">{{ tegs | downcase }}</a>
                    </li>
                  {% endunless %}
              {% endfor %}
              {% endif %}
              {% endfor %}
              </ul>
              {%- if articleGrid != blank -%}
              <div class="swiper mySwiper RqslideshowBanner"><div id="{{ tag | handle }}" class="sub-question-list swiper-wrapper">
                  {{articleGrid}}
              </div><div class="swiper-button-next arrsdnxt NextButtonSlideshow"></div><div class="swiper-button-prev arrsdprev PrevButtonSlideShow"></div><div class="swiper-pagination paginationSlideshowbanner"></div></div>
              {%- endif -%}
           </div>
            {%- endif -%}
            {%- endif -%}
        {% endfor %}
        {%- endfor -%}
      </div>
    </div>
  </div>{%- endcapture -%}{{ mainMultiArticlesWp | strip_newlines }}