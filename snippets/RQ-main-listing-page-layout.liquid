{%- style -%}
/* Santa Hide Out Start */
.MainTopListingPodcastWrapper .SantaMediaInit img {
  width: 53px;
  height: 53px;
}
.RqPodCastMain .SantaMediaInit img{
  width: 40px;
  height: 40px;
}
.MainTopListingPodcastWrapper .RqPodCastHeading, .RqPodCastMain .RqPodCastHeading {
  display: flex;
  align-items: center;
}
/* Santa Hide Out End */
.breadcrumbs__list {
    padding: 0;
}
.RQBreadCrumbsLayout {
    max-width: 1113px;
}
.MainListingPodcastWrapper {
    margin-top: 8px;
} 
.ExecutionPodCastWp {
    max-width: 1113px;
    margin: auto;
    padding: 0 24px;
}
.IframePodacst {
    line-height: 1;
}
.mySwiper {
    overflow: visible;
}
.posubhd {
    font-weight: 600;
    font-size: 20px;
    line-height: 140%;
    text-transform: uppercase;
    color: #7D7B9E;
}
.poshd {
    font-weight: 600;
    font-size: 42px;
    line-height: 140%;
    color: #27235E;
}
.HeadiingPodcastMn {
    margin: 0 0 22px;
}
.TopExpertSession .TopPdCstDes h2 {
    font-weight: 600;
    font-size: 24px;
} 
.RqTopBlogs .TopPdCstDes h2 {
    font-weight: 600;
    font-size: 24px;
    margin: 0 0 8.94px;
}
.RqTopBlogs .TopPdCstDes p {
    font-size: 16px;
    line-height: 150%;
    letter-spacing: 0.04em;
    color: #333333;
    margin: 0;
}
.RqPodCastWrap {
    padding: 116px 24px 0px;
    max-width: 1112px;
    margin: auto;
    overflow: hidden;
} 
.PaginationWithFractionRecomm {
    display: flex;
    align-items: center;
    max-width: 100px;
    justify-content: center;
    margin: 24px auto auto;
}
.PrevButtonSlideShowfd:after, .NextButtonSlideshowfd:after {
    display: none;
}
.PrevButtonSlideShowfd {
    display: block !important;
    width: 20px;
    height: 20px;
    background-image: url(https://cdn.shopify.com/s/files/1/0306/6262/3364/files/arrow-left.png?v=1673261335);
    background-repeat: no-repeat;
    position: static !important;
    background-size: 20px;
    margin: 0;
}
.NextButtonSlideshowfd {
    display: block !important;
    width: 20px;
    height: 20px;
    background-image: url(https://cdn.shopify.com/s/files/1/0306/6262/3364/files/arrow-right.png?v=1673261335);
    background-repeat: no-repeat;
    position: static !important;
    background-size: 20px;
    margin: 0;
}
.paginationFractionWp {
    position: static;
    font-size: 14px;
    line-height: 100%;
    color: #828282;
}
.RqPodCastHead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 0 24px;
}
.RqPodCastHead h2 {
    font-weight: 600;
    font-size: 42px;
    line-height: 140%;
    color: #27235E;
    margin: 0;
} 
.rqPodcstViewMoreBtn {
    padding-left: 10px;
}
.rqPodcstViewMoreBtn a {
    font-weight: 400;
    font-size: 18px;
    line-height: 150%;
    letter-spacing: 0.04em;
    text-decoration-line: underline !important;
    color: #27235E;
}
.TopPdCstCtgrItmBox {
    padding: 12px;
    box-shadow: 4px 4px 13px transparent;
    transition: ease .3s;
}
.TopPdCstCtgrItmBox:hover {
    box-shadow: 4px 4px 13px rgba(0, 0, 0, 0.25);
} 
.TopPdCstImg {
    position: relative;
    margin: 0 0 12px;
}
.TopPdCstImg img {
    width: 100%;
    display: block;
}
.RqTopPodCastSec .TopPdCstImg img {
    height: auto !important;
    object-fit: cover;
}
.RQExpertSessionSlideshow .TopPdCstImg img,
.RQTopBlogsSlideshow .TopPdCstImg img {
    height: auto !important;
    object-fit: cover;
}
.RqTopBlogs {
    padding-bottom: 68px;
}
.pdCstPlBtn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    left: 0;
    right: 0;
    max-width: 83px;
    margin: auto;
    cursor: pointer;
    display: flex;
    align-items: center;
}
.TopPdCstDes h2 {
    font-size: 16px;
    line-height: 140%;
    color: #27235E;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
}
.RqArticleCardInfo {
    margin: 12px 0 0;
    line-height: 1;
}
.RqArticleCardInfo span {
    font-size: 14px;
    line-height: 140%;
    color: #333333;
    opacity: .8;
    display: inline-block;
}
.RqArticleCardInfo time {
    position: relative;
}
.RQTopBlogsSlideshow .RqArticleCardInfo .circle-divider {
    display: inline-block;
}  
.RqArticleCardInfo .circle-divider {
    padding-left: 17px;
    display: none;
}
.RqTopPodCastSec .RqArticleCardInfo .circle-divider {
    display: none;
}  
.RqArticleCardInfo time:before {
    content: '';
    background: #333333;
    opacity: .8;
    width: 5px;
    height: 5px;
    border-radius: 100px;
    display: inline-block;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    left: -13px;
}
/* media css start here */

@media (min-width: 750px) {
.RqTopBlogs .RqArticleCardInfo span {
    font-size: 12px;
}
.HeadiingPodcastMn.mbheadingpbst {
    display: none;
}
} 
@media (max-width: 1279px) {
.RqTopPodCastSec .TopPdCstImg img {
    height: 282px;
}
.poshd, .RqPodCastHead h2 {
    font-size: 34px;
}
}
@media (max-width: 1023px) {
.poshd {
    font-size: 28px;
}
.posubhd {
    font-size: 16px;
}
.RqTopPodCastSec .TopPdCstImg img {
    height: 218px;
}
.RQExpertSessionSlideshow .TopPdCstImg img, .RQTopBlogsSlideshow .TopPdCstImg img {
    height: 194px;
}
.RqTopBlogs {
    padding-bottom: 16px;
}
.RqPodCastWrap {
    padding: 64px 24px 0px;
}
.RqPodCastHead h2 {
    font-size: 24px;
}
.RqPodCastHead {
    margin: 0 0 16px;
}
.rqPodcstViewMoreBtn a {
    font-size: 14px;
}
.pdCstPlBtn {
    max-width: 50px;
    height: 50px;
}
.TopPdCstDes h2, .RqTopBlogs .TopPdCstDes p {
    font-size: 14px;
}
.TopExpertSession .TopPdCstDes h2, 
.RqTopBlogs .TopPdCstDes h2 {
    font-size: 16px;
}
.TopPdCstCtgrItmBox {
    padding: 10px;
}
}
@media (max-width: 768px) {
.RqTopPodCastSec .TopPdCstImg img {
    height: 201px;
}  
.RQExpertSessionSlideshow .TopPdCstImg img, .RQTopBlogsSlideshow .TopPdCstImg img {
    height: 180px;
}  
}
@media (max-width: 749px) {
.RqTopPodCastSec .RqArticleCardInfo span {
    font-size: 12px;
}
.RqTopBlogs {
    padding-bottom: 38px;
}
.posubhd {
    font-size: 12px;
}
.poshd {
    font-size: 20px;
}
.HeadiingPodcastMn.mbheadingpbst {
    margin: 14px 0 8px;
}
.HeadiingPodcastMn {
    margin: 0 0 14px;
}
.ExecutionPodCastWp .RqArticleCardInfo span {
    font-size: 12px;
}
.TopPdCstCtgrItmBox:hover {
    box-shadow: none;
}
.MainListingPodcastWrapper {
    margin-top: 12px;
}
.RqTopPodCastSec .RqPodCastHead {
    margin: 0 0 19px;
}
.TopPdCstDes h2 {
    font-weight: 500;
}
.RqTopPodCastSec .TopPodCastCategoryItem:first-child .TopPdCstImg img {
    height: 312px;
}
.TopPodCastCategoryItem:first-child {
    margin-bottom: 24px;
}
.TopPodCastCategoryItem {
    margin-bottom: 20px;
}
.TopPodCastCategoryItem:last-child {
    margin-bottom: 0px;
}
.TopPdCstCtgrItmBox>a {
    display: flex;
    align-items: center;
}
.TopPdCstImg {
    position: relative;
    margin: 0 12px 0 0px;
    flex: 0 0 70px;
}
.RqTopPodCastSec .TopPdCstImg img {
    height: 70px;
}
.RqTopPodCastSec .pdCstPlBtn {
    display: none;
}
.RqTopPodCastSec .TopPodCastCategoryItem:first-child .pdCstPlBtn {
    display: flex;
    max-width: 54px;
    height: 54px;
}
.pdCstPlBtn svg {
    width: 54px;
    height: 54px;
    margin: auto;
}
/* .pdCstPlBtn svg path {
    fill: #fff;
    fill-opacity: 0.8;
} */
.RQExpertSessionSlideshow .TopPodCastCategoryItem:first-child .TopPdCstImg img {
    height: 176px;
}
.RQExpertSessionSlideshow .TopPdCstImg img, .RQTopBlogsSlideshow .TopPdCstImg img {
    height: 72px;
}
.RQExpertSessionSlideshow .TopPodCastCategoryItem:first-child .pdCstPlBtn svg {
    width: 54px;
    height: 54px;
}
.RQExpertSessionSlideshow .pdCstPlBtn svg {
    width: 14px;
    height: 14px;
}
.RQExpertSessionSlideshow .TopPdCstImg,
.RQTopBlogsSlideshow .TopPdCstImg {
    margin: 0 6px 0 0px;
    flex: 0 0 130px;
}
.TopExpertSession .TopPdCstDes h2 {
    font-weight: 400;
    font-size: 12px;
    color: #333333;
}
.TopExpertSession .TopPodCastCategoryItem {
    margin-bottom: 24px;
}
.TopExpertSession .TopPodCastCategoryItem:last-child {
    margin-bottom: 0px;
}
.RQTopBlogsSlideshow .TopPodCastCategoryItem:first-child .TopPdCstImg img {
    height: 180px;
}
.RQTopBlogsSlideshow .TopPodCastCategoryItem:first-child .TopPdCstImg {
    margin: 0 0 8px;
}
.RqTopBlogs .TopPodCastCategoryItem:first-child .TopPdCstDes h2 {
    margin: 0 0 6px;
}
.RqTopBlogs .TopPodCastCategoryItem:first-child .TopPdCstDes p {
    display: block;
}
.TopPodCastCategoryItem:first-child .RqArticleCardInfo span {
    font-size: 12px;
}
.RqArticleCardInfo span {
    font-size: 10px;
}
.RqTopBlogs .TopPdCstDes p {
    font-size: 12px;
    display: none;
}
.RqTopBlogs .TopPodCastCategoryItem:first-child .RqArticleCardInfo {
    margin: 6px 0 0;
}
.RqTopBlogs .RqArticleCardInfo {
    margin: 7px 0 0;
}
.RqTopBlogs .TopPdCstDes h2 {
    font-weight: 400;
    font-size: 12px;
    color: #333333;
    margin: 0 0 7px;
}
.TopPodCastCategoryItem:first-child .TopPdCstCtgrItmBox>a {
    display: block;
}
.TopPodCastCategoryItem:first-child .TopPdCstImg {
    margin: 0 0 14px;
}
.TopPodCastCategoryItem:first-child .TopPdCstDes h2 {
    font-size: 16px;
    font-weight: 600;
    color: #27235E;
}
.RqArticleCardInfo {
    margin: 8px 0 0;
}
.breadcrumbs__list {
    margin: 12px 0;
}
.PaginationWithFractionRecomm {
    display: none;
}
.TopPodCastCategoryCnt {
    display: block;
}
.TopPdCstCtgrItmBox {
    padding: 0;
}
.RqPodCastHead h2 {
    font-size: 20px;
}
.rqPodcstViewMoreBtn a {
    font-size: 12px;
    letter-spacing: 0;
} 
}

{%- endstyle -%}