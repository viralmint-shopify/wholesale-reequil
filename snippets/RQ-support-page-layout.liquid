{%- style -%}
/* Ticket raised popup css start */

#freshworks-container #launcher-frame {
  top: 790px;
}
  
.SuceesfullymessageAppear {
    text-align: center;
    margin-top: 0px;
}
  .TabDetailsInnerObj p {
    margin: 0;
}
.GIFDecorateRaised img {
    width: 100%;
    max-width: 100px;
    height: 100px;
    object-fit: contain;
    display: block;
    margin: auto;
}
  iframe#launcher-frame {
    display: none;
}
.TicketRiasedhd {
    font-weight: 600;
    font-size: 20px;
    line-height: 140%;
    text-align: center;
    letter-spacing: 0.02em;
    color: #333333;
    margin: 0 0 14px;
}
.MessageBusinessHour {
    font-weight: 400;
    font-size: 14px;
    line-height: 140%;
    text-align: center;
    letter-spacing: 0.04em;
    color: rgba(51, 51, 51, 0.8);
    max-width: 390px;
    margin: auto;
}
.ButtonClosedView {
    margin: 24px 0 0;
}
.ButtonClosedView span {
    background: #27235E;
    padding: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 160px;
    margin: auto;
    height: 46px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #FFFFFF;
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    cursor: pointer;
    transition: ease .5s;
}
.ButtonClosedView span:hover {
    background: #524f7e;
}
/* Ticket raised popup css end */
/* Raise a Ticket popup css start */
.SuccesfullyFormSubmit .RaiseTicketPopupHd, .SuccesfullyFormSubmit .RqHeadingSvgIconWp {
    display: none;
}
.RqSupportPagePopUpModal {
    background: #FFFFFF;
    box-shadow: 2px 3px 12px rgb(0 0 0 / 10%);
    padding: 36px 40px;
    max-width: 595px;
    margin: auto;
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    left: 0;
    right: 0;
    z-index: 911;
    display: none;
}
.ticketPopUpOpen .RqSupportPagePopUpModal {
    display: block;
}
.ticketPopUpOpen {
    overflow: hidden;
}
.ticketPopUpOpen:before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.26);
    z-index: 911;
}
.CrossSupportpopup {
    position: absolute;
    top: 13px;
    right: 13px;
    display: flex;
    align-items: center;
    cursor: pointer;
}
.RqHeadingSvgIconWp {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 0 10px;
}
.hdwpmn {
    font-weight: 600;
    font-size: 20px;
    line-height: 140%;
    text-align: center;
    letter-spacing: 0.02em;
    color: #333333;
    margin: 0 0 10px;
}
.dswpmn {
    font-weight: 400;
    font-size: 14px;
    line-height: 140%;
    text-align: center;
    letter-spacing: 0.04em;
    color: rgba(51, 51, 51, 0.8);
}
.RaiseTicketPopupHd {
    margin: 0 0 32px;
}
.ContactPageIntializeWp .field:before, .ContactPageIntializeWp .field:after {
  display: none;
}
.ContactPageIntializeWp .field input, .ContactPageIntializeWp .field select {
    background: #FFFFFF;
    border: 1px solid rgba(39, 35, 94, 0.1);
    margin: 0;
    padding: 8px 20px;
    color: #828282;
    font-weight: 400;
    font-size: 12px;
    line-height: 150%;
    border-radius: 0;
    outline: none;
    box-shadow: none;
    height: 46px;
    width: 100%;
}
.ContactPageIntializeWp .field select {
    background-image: url(https://cdn.shopify.com/s/files/1/0306/6262/3364/files/arrow-down_9bb20a15-37ed-4efc-8719-75d1e52fe28b.png?v=1677760557) !important;
    background-repeat: no-repeat;
    background-position: right 14px center;
    -webkit-appearance: none;
    padding-right: 35px;
}
.contact__button {
    margin-top: 32px;
    text-align: center;
}
.ContactPageIntializeWp .field .field__label {
    font-weight: 400;
    font-size: 12px;
    line-height: 150%;
    color: #828282;
    top: 14px;
    letter-spacing: 0;
} 
.ContactPageIntializeWp .ConcenrnSelection .field__input + .field__label,
.ContactPageIntializeWp .ConcenrnSelection .field__input + .field__label,
.ContactPageIntializeWp .ConcenrnSelection.field select + .field__label {
    top: -10px;
    left: 12px;
    background: #FFFFFF;
    padding: 5px;
    font-weight: 500;
    font-size: 10px;
    line-height: 140%;
    color: #27235E;
}

.contact__button button.button {
    min-height: 46px;
    min-width: 160px;
}
.ContactPageIntializeWp .field input::placeholder, .ContactPageIntializeWp .field textarea::placeholder {
    color: #828282;
    font-size: 12px;
    opacity: 1;
    font-weight: 400;
}
.ContactPageIntializeWp .field textarea {
    background: #FFFFFF;
    border: 1px solid rgba(39, 35, 94, 0.1);
    font-weight: 400;
    font-size: 12px;
    line-height: 150%;
    color: #828282;
    min-height: 138px;
    padding: 14px 20px;
}
.ContactPageIntializeWp .field {
    margin: 0 0 24px;
}
/* Raise a Ticket popup css end */
.RQBreadCrumbsLayout {
    display: none;
}
.RQ-Support-MainWrapper {
    padding: 116px 0 0;
}
/* Support page css start here */
.rqSupportWrap {
    max-width: 940px;
    margin: auto;
    padding: 0 24px;
}
.rqSupHeading h2 {
    font-weight: 600;
    font-size: 52px;
    line-height: 120%;
    text-align: center;
    color: #27235E;
    margin: 0 0 20px;
}
.rqSupHeading p {
    font-size: 20px;
    line-height: 150%;
    text-align: center;
    letter-spacing: 0.04em;
    color: #333333;
    margin: 0;
}
.rqSupHeading {
    margin: 0 0 60px;
}
.rqSupTrackSec {
    display: flex;
    flex-wrap: wrap;
    margin-left: -20px;
}
.rqSupTrackItem {
    width: 50%;
    padding-left: 20px;
}
.rqSupTrackItemInner {
    padding: 36px 40px;
    text-align: center;
    min-height: 338px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    transition: ease .3s;
}
.rqSupTrackItemInner:hover {
    box-shadow: 2px 3px 12px rgb(0 0 0 / 10%);
}
.rqTrackIcon {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 0 6px;
}
.rqTracktopHead h2 {
    font-weight: 600;
    font-size: 20px;
    line-height: 140%;
    text-align: center;
    letter-spacing: 0.02em;
    color: #333333;
    margin: 0 0 22px;
}
.rqTracktopHead p {
    font-size: 14px;
    line-height: 140%;
    text-align: center;
    letter-spacing: 0.04em;
    color: rgba(51, 51, 51, 0.8);
    max-width: 355px;
    margin: auto;
}
.rqTracktopHead {
    min-height: 150px;
}
.rqTrackField input {
    border: 1px solid rgba(39, 35, 94, 0.1);
    padding: 13px 20px;
    width: 100%;
    max-width: 356px;
    margin: auto;
    font-size: 12px;
    line-height: 150%;
    color: #828282;
    display: none;
}
.trackBtn {
    margin: 28px 0 0;
}
.trackBtn a {
    text-align: center;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #FFFFFF !important;
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    background: #27235E;
    display: inline-block;
    padding: 13px 35.1px;
}
.trackBtn a:hover {
    background: #524f7e;
}
/* Support page css end here */
/* support faq section css start */
.RQ-support-headingPg, .FaqBlockWithTabSupportMain {
    max-width: 1112px;
    padding: 0 24px;
    margin: auto;
}
.RQ-support-headingPg {
    margin-bottom: 24px;
}
.RQSupportPageMainWrapper {
    margin: 116px 0 68px;
}
.RQhdSport {
    font-weight: 600;
    font-size: 32px;
    line-height: 140%;
    letter-spacing: 0.02em;
    color: #27235E;
    margin: 0 0 20px;
}
.RQdssport {
    font-size: 18px;
    line-height: 140%;
    letter-spacing: 0.04em;
    color: #333333;
}
.TabbingVirewSupportFaq {
    display: flex;
    align-items: flex-start;
    overflow: auto;
}
.TabbingVirewSupportFaq::-webkit-scrollbar {
    display: none;
}
.BlockSupportFq {
    margin-right: 16px;
    min-width: fit-content;
}
.BlockSupportFq span {
    border-radius: 8px;
    display: inline-block;
    padding: 9px 23.1px;
    color: #333333;
    font-size: 18px;
    line-height: 140%;
    text-align: center;
    border: 1px solid rgba(39, 35, 94, 0.25);
    cursor: pointer;
}
.BlockSupportFq.active span {
    background: #27235E;
    color: #fff;
    border: 1px solid #27235E;
}
.TabAccordionDtl {
    display: none;
    padding-bottom: 18px;
}
.TabAccorionInnerExecution {
    display: none;
}
.TabAccorionInnerExecution.active {
    display: block;
}
.TabbingBriefAccordionContent {
    margin: 32px 0 0;
}
.TabAccorionVwMn {
    border-bottom: 0.5px solid #E0E0E0;
}
.TabDetailsInnerObj {
    font-size: 18px;
    line-height: 165%;
    letter-spacing: 0.04em;
    color: #333333;
    max-width: 742px;
}
span.minusIocnSvg {
    display: none;
    align-items: center;
    cursor: pointer;
}
span.addIocnSvg {
    display: flex;
    align-items: center;
    cursor: pointer;
}
.TabAccordionQs {
    font-size: 18px;
    line-height: 140%;
    display: flex;
    align-items: center;
    color: #27235E;
    justify-content: space-between;
    cursor: pointer;
    padding: 18px 0;
}
.TabAccorionInnerExecution .TabAccorionVwMn:first-child {
    border-top: 0.5px solid #E0E0E0;
}
.TabAccorionVwMn.active .TabAccordionDtl {
    display: block;
}
.TabAccorionVwMn.active span.minusIocnSvg {
    display: flex;
}
.TabAccorionVwMn.active span.addIocnSvg {
    display: none;
}
/* support faq section css end */

