<div class="custom_vid_wrapp  {% if product.metafields.custom.ugc_videos != blank %}video_exist{% else %}without_videos{% endif %}">
  <div class="vide_sec_inner-wrapp ">
    <div class="heading_with_text">
      {% if section.settings.heading != blank %}
      <div class="heading">
        <h2>{{ section.settings.heading }}{% if section.settings.heading_image != blank %}<img src="{{ section.settings.heading_image | img_url:'master' }}">{% endif %}</h2>
      </div>
      {% endif %}
      {% if  section.settings.content  != blank %}
      <div class="top_content_main">
        {{ section.settings.content }}
      </div>
        {% endif %}
    </div>
    {% if product.metafields.custom.ugc_videos != blank %}
    <div class="all_ctm_vid_wrapper {% if product.id == 9525498183938 or product.id == 9525494710530 or product.id == 9525483143426 or product.id == 9525495791874 %}hidden{% endif %}">
          <div class="swiper mySwiper video_slider_wrapper {% if product.metafields.custom.ugc_videos.value.size > 1 %}custom_testi_cus_slider{% else %}without-slider-video-pdp{% endif %}"> 
      <div class="swiper-wrapper">

            {% for block in product.metafields.custom.ugc_videos.value %}
{% assign video_url = block %}
        {% if video_url %}
        <div class="collection-page-video swiper-slide">
          <div class="all_video_wrapp show_video">
   <div class="video_main_wrapper_main">       
  <div class="video_main_wrapper">
             {% if video_url contains 'vimeo' %}
        {%assign videoid = video_url | split : '/'%}
        <iframe src="https://player.vimeo.com/video/{{videoid.last}}" webkitallowfullscreen="" mozallowfullscreen="" allowfullscreen="" width="1200" height="600" id="video" data-ready="true"> </iframe>
        {%- elsif video_url contains "youtube"  or video_url contains "youtu.be"  -%}
        <iframe src="{{video_url }}" width="560" height="315">  </iframe>
        {% else %}
              
            <video width="560" height="315" controls="true" preload="true">
              <source src="{{video_url}}" type="video/mp4">
              <source src="{{video_url}}" type="video/ogg">
            </video>
        {% endif %}
          </div>
   </div>
</div>

  
      </div>
         {% endif %}

      
      {% endfor %}
      </div>

    </div>
    </div>
{% endif %}
  </div>
  
</div>
{% schema %}
  {
    "name": "Why Reequil",
    "settings": [
                    {
          "type": "text",
          "id": "heading",
          "label": "t:sections.image-with-text.blocks.heading.settings.heading.label"
        },
                          {
          "type": "image_picker",
          "id": "heading_image",
          "label": "Heading image"
        },
                          {
          "type": "richtext",
          "id": "content",
          "label": "Contemt"
        }
    ],
      "presets": [
    {
      "name": "Why Reequil"
    }
      ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
  
{% endjavascript %}