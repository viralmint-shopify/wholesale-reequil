} 
.PrevButtonSlideShowfdOffer {
    display: block !important;
    width: 20px;
    height: 20px;
    background-image: url(https://cdn.shopify.com/s/files/1/0306/6262/3364/files/arrow-left.png?v=1673261335);
    background-repeat: no-repeat;
    position: static !important;
    background-size: 20px;
    margin: 0;
}
.NextButtonSlideshowfdOffer {
    display: block !important;
    width: 20px;
    height: 20px;
    background-image: url(https://cdn.shopify.com/s/files/1/0306/6262/3364/files/arrow-right.png?v=1673261335);
    background-repeat: no-repeat;
    position: static !important;
    background-size: 20px;
    margin: 0;
}
.PrevButtonSlideShowfdOffer:after, .NextButtonSlideshowfdOffer:after {
    display: none !important;
}
