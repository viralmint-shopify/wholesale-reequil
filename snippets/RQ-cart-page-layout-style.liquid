}
.RQ-fdc-bk-title {
    font-size: 14px;
    line-height: 150%;
    letter-spacing: 0.04em;
    color: #333333;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
