<script>
  $(".bottom_main_wrapper .show_all_ingrediant").click(function() {
    $(this).hide();
    $(this).parents(".sidebar_content").find(".side_content").slideDown();
    $(this).parents(".sidebar_content").find(".hide_all_ingrediant").show();
    
});

$(".bottom_main_wrapper .hide_all_ingrediant").click(function() {
    $(this).hide();
    $(this).parents(".sidebar_content").find(".side_content").hide();
        $(this).parents(".sidebar_content").find(".show_all_ingrediant").show();
    
    
});
  $(".iber_additional_info_wrapp ul li").slice(0, 3).show();
$(".iber_additional_info_wrapp ul li a").click(function(e) {
    e.preventDefault();
  var read_more_text = $(this).text();
 if(read_more_text == 'Read more'){
   
   $(".iber_additional_info_wrapp ul li:hidden").slice(0, 3).slideDown();
    if ($(".iber_additional_info_wrapp ul li:hidden").length == 0) {
      $(this).addClass("readmore_btn");
       $(".iber_additional_info_wrapp ul li a").removeClass("readless_btn");
  }
 }else{
        $(".iber_additional_info_wrapp ul li").slice(3, 5).slideUp();
    $(".iber_additional_info_wrapp ul li a").removeClass("readmore_btn");
   $(this).addClass("readless_btn");
  }
});
  $(".iber_additional_info_wrapp ul li .readless_content_here").click(function(e) {
    e.preventDefault();
  
});
$(document).on("click","li.next a", function() {
   $(".main_reviews_wrapper") .addClass("load-more-trigger");
});
</script>
