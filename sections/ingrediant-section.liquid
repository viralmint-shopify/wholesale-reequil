 {% if section.settings.heading != blank or  section.settings.content != blank or  section.settings.image != blank %}
<div class="custom_new-sec-wrapper">
  <div class="custom_inner_wrapper">
    {% if section.settings.heading != blank %}
    <div class="heading for_mobile">
      <h2>{{ section.settings.heading }}</h2>
    </div>
    {% endif %}
    <div class="bottom_main_wrapper">
      {% if section.settings.image != blank %}
      <div class="image_wrapper">
        <img src="{{ section.settings.image | img_url:'master' }}">
      </div>
      {% endif %}
         {% if section.settings.heading != blank or  section.settings.content != blank%}
      <div class="sidebar_content">
            {% if section.settings.heading != blank %}
    <div class="heading sidebar_content_innner for_desktop">
      <h2>{{ section.settings.heading }}</h2>
    </div>
    {% endif %}
    {% if section.settings.content != blank %}
      <a class="show_all_ingrediant">View All Ingredients</a>
    <div class="side_content" style="display:none;">
      {{ section.settings.content }}
    </div>
        <a class="hide_all_ingrediant" style="display:none;">Hide all Ingredients</a>
        {% endif %}
      </div>
      {% endif %}
    </div>
  </div>
</div>
{% endif %}
{% schema %}
  {
    "name": "Ingrediant Image Text",
    "settings": [
              {
          "type": "text",
          "id": "heading",
          "label": "t:sections.image-with-text.blocks.heading.settings.heading.label"
        },
                    {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
                    {
          "type": "richtext",
          "id": "content",
          "label": "Contemt"
        }
    ],
      "presets": [
    {
      "name": "Ingrediant Image Text"
    }
  ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
  $(".bottom_main_wrapper .show_all_ingrediant").click(function() {
    $(this).hide();
    $(this).parents(".sidebar_content").find(".side_content").slideDown();
    $(this).parents(".sidebar_content").find(".hide_all_ingrediant").show();
    
});

$(".bottom_main_wrapper .hide_all_ingrediant").click(function() {
    $(this).hide();
    $(this).parents(".sidebar_content").find(".side_content").hide();
        $(this).parents(".sidebar_content").find(".show_all_ingrediant").show();
    
    
});
{% endjavascript %}