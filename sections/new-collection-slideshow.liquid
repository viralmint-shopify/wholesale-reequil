{% schema %}
{"name": "RQ Collection Slideshow","tag":"div","class":"RQ-collection-banner-slideshow","settings": [
    {"type":"header","content":"Want banner?"}, 
    {"type": "checkbox","id": "activateCollectionBanner","label": "Have to activate?","default":true}
],"blocks":[{"type":"image","name":"Image","settings":[
    {"type":"header","content":"Banner"}, 
        {"type":"image_picker","id":"desktop_image","label":"Image (Desktop)"},
        {"type":"image_picker","id":"mobile_image","label":"Image (Mobile)"},
        {"type":"text","id":"title","label":"Custom title"},
        {"type":"textarea","id":"description","label":"Custom description"},
        {"type":"text","id":"cta_text","label":"CTA text"},
        {"type":"url","id":"cta_link","label":"CTA link","info":"It will also works on Image"}
]}],"presets":[{"name":"RQ Collection Slideshow"}],"templates":["collection"]}
{% endschema %}
{% capture RQCollectionBannerSlideshow %}{%- liquid
    assign sps = section.settings
    assign WantBanner = sps.activateCollectionBanner
    assign spdbk = section.blocks
    assign loadMode = "jsLazy"
    %}
{%- if WantBanner -%}
<div class="RQ-collectionBannerMnWrapper new-collection-slideshow" section="RQ-collection-banner-slideshow">
  <div class="RQ-collectionBannerWidthWrapper">
  {%- if spdbk.size > 0 -%}
    <div class="RQ-collectionBn-mgbknMn swiper mySwiper RqslideshowBannerCollections"><div class="RQ-ColB-mg-bkMn swiper-wrapper">
      {%- for bk in spdbk -%}
