  </div>
  <div class="chat_box_content_inner">
    {%- if section.settings.heading2 != blank -%}
    <div class="chat_box_heading">
      <h2>{{ section.settings.heading2 }}</h2>
    </div>
    {%- endif -%}
    <div class="chat-box-links_main">
      {% for block in section.blocks %}
         {% if block.settings.chat_box_icon  != blank or  block.settings.chat_box_text  != blank%}
        <div class="chat_box-inner-rpeater">
         <a {% if block.settings.chat_box_text_url != blank %}href="{{ block.settings.chat_box_text_url }}" {% endif %} class="{{ block.settings.custom_class }}"> <div class="chatbox-icon_text_wrapp">
        {% if block.settings.chat_box_icon  != blank %}
            <div class="chat_box-icons">
             <img src="{{ block.settings.chat_box_icon | img_url:'master' }}">
            </div>
            {% endif %}
         {% if block.settings.chat_box_text  != blank %}
        <div class="chat_box_text">
          {{ block.settings.chat_box_text }}
        </div>
            {% endif %}
          </div>
         </a>
        </div>
      {% endif %}
        {% endfor %}
    </div>
  </div>
</div>
{% endif %}
  {% if section.settings.ph_number != blank %}

<div class="call_now_button_data" style="display:none;">
    <div class="call_cross_popup-btn">
    <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
