{% schema %}
{"name":"RQ affiliate main","tag":"div","class":"RQ-affiliate-main","settings":[],
    "blocks":[{"type":"image_slide","name":"Image Slide","settings":[
                  {"type":"header","content":"Desktop/Mobile Image"},
                      {"type":"text","id":"heading","label":"Main Heading"},
                      {"type":"image_picker","id":"image","label":"Image (Desktop)"},
                      {"type":"image_picker","id":"mb_image","label":"Mobile image"},
                      {"type":"text","id":"cta_text","label":"Button"},
                      {"type":"url","id":"cta_link","label":"Link"}
              ]},
               {"type":"video_slide","name":"Video Slide","settings":[
                   {"type":"header","content":"Video (Desktop/Mobile With cover images)"},
                      {"type":"text","id":"heading","label":"Main Heading"},
                      {"type": "video_url","id": "video_url","label": "Video URL","accept": ["youtube","vimeo"]},
                      {"type":"image_picker","id":"cover_image","label":"Cover image (Desktop)"},
                      {"type":"image_picker","id":"cover_image_mb","label":"Cover image (Mobile)"},
                      {"type":"text","id":"cta_text","label":"Button"},
                      {"type":"url","id":"cta_link","label":"Link"}
              ]}]
}
{% endschema %}
{%- capture MainAffiliateWrapperSection -%}{%- liquid
    assign SafSt = section.settings   
    assign SafStbk = section.blocks
    assign loadMode = "jsLazy"
   -%}
<div class="RQ-affiliateMainSectionWrapper" section="RQ-affiliate-main">   
  <div class="RQAffiliateWP">
    <div class="swiper mySwiper RqslideshowBanner"><div class="BlockMainContainerAffiliate swiper-wrapper">
      {%- for Abk in SafStbk -%}
        {%- case Abk.type -%}
          {%- when 'image_slide' -%}
          {%- liquid
              assign AbkSt = Abk.settings 
              assign mg_heading = AbkSt.heading
              assign mg_desktop_image = AbkSt.image
              assign mg_mobile_image = AbkSt.mb_image
              assign mg_cta_text = AbkSt.cta_text
              assign mg_cta_link = AbkSt.cta_link
             -%}
            <div class="BlockWrapperLandingContent ImageSlideWp swiper-slide">
              {%- if mg_heading != blank -%}<div class="Wpsdhd">{{ mg_heading }}</div>{%- endif -%}
                {%- if mg_desktop_image != blank or mg_mobile_image != blank -%}<div class="WpSlideImageEx">
                    <spd-img class="cdv-element show_all show_des CoverMg" data-imglink="{{ imgLink | default: 0 }}" data-load-mode="{{ loadMode }}">
                      <div class="spd-img-wrapper">
                      {%- liquid 
                        if mg_desktop_image != blank 
                        assign imgWidth = "800" | abs
                        assign image = mg_desktop_image
                        assign classes = 'img-primary img-all'
                        assign baseSrc = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E" 
                        if imgWidth == blank
                        assign imgWidth = image.width
                        endif
                        assign imgUrl = image | image_url: width: imgWidth
                        assign imgFit = "contain" | prepend: 'fit-'
                        assign imgFitM = bSt.imgFitM | default: 'contain' | prepend: 'fitM-' 
                        endif
                    -%}
                      <img {% if loadMode == 'speedLoad' -%}src="{{ imgUrl }}" {%- else %} src="{{ baseSrc }}" data-src="{{ imgUrl }}" {% endif -%}height="{{ image.height }}" width="{{ image.width }}" class="spd-img-{{ secId }}{{ loopId }}-{% increment imageId %} {{ classes }} {{ loadMode }} {{ imgFit }} {{ imgFitM | default: 'fitM-contain' }}" {{ attributes }} alt=""> 
                      </div>
                    </spd-img>
                    <spd-img class="cdv-element show_all show_mb CoverMg" data-imglink="{{ imgLink | default: 0 }}" data-load-mode="{{ loadMode }}">
                      <div class="spd-img-wrapper">
                      {%- liquid 
                        if mg_mobile_image != blank 
                        assign imgWidth = "800" | abs
                        assign image = mg_mobile_image
                        assign classes = 'img-primary img-all'
                        assign baseSrc = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E" 
                        if imgWidth == blank
                        assign imgWidth = image.width
                        endif
                        assign imgUrl = image | image_url: width: imgWidth
                        assign imgFit = "contain" | prepend: 'fit-'
                        assign imgFitM = bSt.imgFitM | default: 'contain' | prepend: 'fitM-' 
                        endif
                    -%}
                      <img {% if loadMode == 'speedLoad' -%}src="{{ imgUrl }}" {%- else %} src="{{ baseSrc }}" data-src="{{ imgUrl }}" {% endif -%}height="{{ image.height }}" width="{{ image.width }}" class="spd-img-{{ secId }}{{ loopId }}-{% increment imageId %} {{ classes }} {{ loadMode }} {{ imgFit }} {{ imgFitM | default: 'fitM-contain' }}" {{ attributes }} alt=""> 
                      </div>
                    </spd-img>                  
                </div>{%- endif -%}
                {%- if mg_cta_text != blank -%}<div class="ButtonAffwp"><a href="{{ mg_cta_link | default:'#' }}">{{ mg_cta_text }}</a></div>{%- endif -%}
            </div>
          {%- when 'video_slide' -%}
          {%- liquid
              assign AbkSt = Abk.settings 
              assign vd_heading = AbkSt.heading
              assign vd_url = AbkSt.video_url
              assign vd_desktop_image = AbkSt.cover_image
              assign vd_mobile_image = AbkSt.cover_image_mb
              assign vd_cta_text = AbkSt.cta_text
              assign vd_cta_link = AbkSt.cta_link
             -%}
            <div class="BlockWrapperLandingContent VideoSlideWp swiper-slide">
              {%- if vd_heading != blank -%}<div class="Wpsdhd">{{ vd_heading }}</div>{%- endif -%}
                {%- if vd_desktop_image != blank or vd_mobile_image != blank or vd_url != blank -%}<div class="WpSlideImageEx">
                    <spd-img class="cdv-element show_all show_des CoverMg" data-imglink="{{ imgLink | default: 0 }}" data-load-mode="{{ loadMode }}">
                      <div class="spd-img-wrapper">
                      {%- liquid 
                        if vd_desktop_image != blank 
                        assign imgWidth = "800" | abs
                        assign image = vd_desktop_image
                        assign classes = 'img-primary img-all'
                        assign baseSrc = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E" 
                        if imgWidth == blank
                        assign imgWidth = image.width
                        endif
                        assign imgUrl = image | image_url: width: imgWidth
                        assign imgFit = "contain" | prepend: 'fit-'
                        assign imgFitM = bSt.imgFitM | default: 'contain' | prepend: 'fitM-' 
                        endif
                    -%}
                      <img {% if loadMode == 'speedLoad' -%}src="{{ imgUrl }}" {%- else %} src="{{ baseSrc }}" data-src="{{ imgUrl }}" {% endif -%}height="{{ image.height }}" width="{{ image.width }}" class="spd-img-{{ secId }}{{ loopId }}-{% increment imageId %} {{ classes }} {{ loadMode }} {{ imgFit }} {{ imgFitM | default: 'fitM-contain' }}" {{ attributes }} alt=""> 
                      </div>
                    </spd-img>
                    <spd-img class="cdv-element show_all show_mb CoverMg" data-imglink="{{ imgLink | default: 0 }}" data-load-mode="{{ loadMode }}">
                      <div class="spd-img-wrapper">
                      {%- liquid 
                        if vd_mobile_image != blank 
                        assign imgWidth = "800" | abs
                        assign image = vd_mobile_image
                        assign classes = 'img-primary img-all'
                        assign baseSrc = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E" 
                        if imgWidth == blank
                        assign imgWidth = image.width
                        endif
                        assign imgUrl = image | image_url: width: imgWidth
                        assign imgFit = "contain" | prepend: 'fit-'
                        assign imgFitM = bSt.imgFitM | default: 'contain' | prepend: 'fitM-' 
                        endif
                    -%}
                      <img {% if loadMode == 'speedLoad' -%}src="{{ imgUrl }}" {%- else %} src="{{ baseSrc }}" data-src="{{ imgUrl }}" {% endif -%}height="{{ image.height }}" width="{{ image.width }}" class="spd-img-{{ secId }}{{ loopId }}-{% increment imageId %} {{ classes }} {{ loadMode }} {{ imgFit }} {{ imgFitM | default: 'fitM-contain' }}" {{ attributes }} alt=""> 
                      </div>
                    </spd-img>  
                    <span class="PlayIconVd{% if vd_url contains 'youtube' %} YoutubeInt{% elsif vd_url contains 'vimeo' %} VimeoInt{% endif %}">
                      <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-play" width="40" height="40" viewBox="0 0 40 40" fill="none"><circle opacity="0.6" cx="20" cy="20" r="20" fill="black"/><path d="M25.1925 23.312C28.1247 21.687 28.1247 19.0307 25.1925 17.4057L22.8305 16.0932L20.4684 14.7807C17.5362 13.1557 15.1416 14.4839 15.1416 17.7339V20.3432V22.9526C15.1416 25.5464 16.6729 26.9214 18.7906 26.5307" fill="#E0E0E0"/></svg>
                    </span>
                    {%- if vd_url != blank -%}{%- if vd_url contains 'youtube' or vd_url contains 'vimeo' -%}
                      {%- if vd_url contains "youtube" -%}
                        {%- assign YoutubeId = vd_url | split : '/watch?v=' | last -%}
                        <iframe class="js-product-video" src="//www.youtube.com/embed/{{ YoutubeId }}?rel=0&showinfo=0&controls=0&vq=720" width="100%" height="100%" frameborder="0" allowfullscreen></iframe>
                      {%- endif -%}
                      {%- if vd_url contains "vimeo" -%}
                        {% assign VimeoId = vd_url | split : 'vimeo.com/' | last %}
                        <iframe class="js-product-video" src="//player.vimeo.com/video/{{ VimeoId }}?byline=0&portrait=0&badge=0&muted=1" width="100%" height="100%" frameborder="0" allowfullscreen allow="autoplay"></iframe>
                      {%- endif -%}
                    {%- endif -%}{%- endif -%}                        
                </div>{%- endif -%}
                {%- if vd_cta_text != blank -%}<div class="ButtonAffwp"><a href="{{ vd_cta_link | default:'#' }}">{{ vd_cta_text }}</a></div>{%- endif -%}
            </div>
          {%- endcase -%} 
      {%- endfor -%}
    </div><div class="swiper-button-next arrsdnxt NextButtonSlideshow"></div><div class="swiper-button-prev arrsdprev PrevButtonSlideShow"></div> <div class="swiper-pagination paginationSlideshowbanner"></div></div>
  </div>
</div>{%- endcapture -%}{{ MainAffiliateWrapperSection | strip_newlines }}