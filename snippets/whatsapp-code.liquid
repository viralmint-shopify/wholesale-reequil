  <script>
    $(document).on("click",".custom_chat_icon",function() {
       $(".call_now_button_data").hide();
    $(".chat_box_content-wrapp").toggle();
    if($(".chat_box_content-wrapp").is(":visible")){
       $('body').addClass("chat-box-open");
    } else{
      $('body').removeClass("chat-box-open");
    }
     
});
        $(document).on("click",".chat_box_content-wrapp .cross_popup-btn",function() {
    $(".chat_box_content-wrapp").hide();
      $('body').removeClass("chat-box-open");
          
});
    $(document).on("click",".bot_popup-btn",function() {
    $(this).parents(".chat_bot-icon-wrapp").hide();
      $(".chat_box_content-wrapp").hide();
       $('body').removeClass("chat-box-open");
});
    setInterval(function () { $(".chat_bot-icon-wrapp").show();}, 15000);
$(document).on("click","a.get_call_here",function(e) {
    if ($(window).width() > 749){
    e.preventDefault();
    var mobile_number = $(this).attr("href");
    $(".call_now_button_data").show();
    $(".chat_box_content-wrapp").hide();
       $('body').addClass("chat-box-open");
    $(".call_now_button_data a.button").attr("href",mobile_number);
    }
});
    $(document).on("click",".call_now_button_data .call_cross_popup-btn svg",function(e) {
   $(".call_now_button_data").hide();
        $('body').removeClass("chat-box-open");
});
    
  </script>
