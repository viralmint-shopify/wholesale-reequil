{% schema %}
{"name": "RQ Slideshow Banner","tag":"div","class":"RQ-slideshow-banner","settings": [
    {"type":"header","content":"Heading"},
        {"type":"text","id":"heading","label":"Heading","default":"Heading"},
        {"type":"textarea","id":"description","label":"Description","default":"Description"},
    {"type":"header","content":"CTA button"},    
        {"type":"text","id":"cta_text","label":"CTA text","default":"Button"}
],"blocks":[{"type":"image","name":"Image and Heading","limit":10,"settings":[
    {"type":"header","content":"Image"}, 
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"image_picker","id":"image_mb","label":"Image (Mobile)"},
    {"type":"header","content":"Heading"},
        {"type":"text","id":"heading","label":"Heading (Desktop)"},
        {"type":"text","id":"mb_heading","label":"Heading (Mobile)"},
        {"type":"text","id":"mobile_over_heading","label":"Banner Over Heading (Mobile)"},
        {"type":"url","id":"cta_link_banner","label":"CTA Link Banner"}
]},{"type":"video","name":"Video and Heading","limit":4,"settings":[
    {"type":"header","content":"Mp4"}, 
        {"type":"text","id":"mp4_video_url","label":"Mp4 Video"},
        {"type":"text","id":"mp4_video_url_mb","label":"Mp4 Video (Mobile)"},
    {"type":"header","content":"Youtube / Vimeo"}, 
        {"type": "textarea","id": "yv_url","label": "Youtube / vimeo Iframe"},
        {"type": "textarea","id": "yv_url_mb","label": "Youtube / vimeo Iframe (Mobile)"}, 
    {"type":"header","content":"Heading"},
        {"type":"text","id":"heading","label":"Heading (Desktop)"},
        {"type":"text","id":"mb_heading","label":"Heading (Mobile)"},
        {"type":"text","id":"mobile_over_heading","label":"Banner Over Heading (Mobile)"},
        {"type":"url","id":"cta_link_banner","label":"CTA Link Banner"}
]}],"presets":[{"name":"RQ Slideshow Banner"}],"templates":["index"]}
{% endschema %}
{%- liquid
    assign sds = section.settings
    assign sdsbk = section.blocks
    assign button = sds.cta_text
    assign loadMode = "jsLazy"
    %}
{% capture RQSlideshowBanner %}<div class="RQ-slideshowMnWrapper" section="RQ-slideshow-banner">
  <div class="RQ-slideshowWidthWrapper">
    {%- if sds.heading != blank or sds.description != blank -%}<div class="RQ-sd-hd-ds">
      {%- if sds.heading != blank -%}<div class="RQ-sd-hd">{{ sds.heading }}</div>{%- endif -%}
      {%- if sds.description != blank -%}<div class="RQ-sd-ds">{{ sds.description }}</div>{%- endif -%}
    </div>{%- endif -%}
    <div class="swiper mySwiper RqslideshowBanner"><div class="RQ-sd-mg-bkMn swiper-wrapper">
      {%- for bk in sdsbk -%}
        {%- liquid
            assign bKs = bk.settings
            assign image = bKs.image
            assign imagemb = bKs.image_mb
            assign heading = bKs.heading
            assign mbheading = bKs.mb_heading
            assign bannerlink = bKs.cta_link_banner
            assign MobileOverHeading = bKs.mobile_over_heading
            assign btype = bk.type
            assign mpvideourl = bKs.mp4_video_url
            assign mpvideourl_mb = bKs.mp4_video_url_mb
            assign YVvideourl = bKs.yv_url
            assign YVvideourl_mb = bKs.yv_url_mb
          -%}     
        <div class="RQ-sdBlockEach swiper-slide">
          {%- if bannerlink != blank -%}<a href="{{ bannerlink | default:'#' }}">{%- endif -%}<div class="MainOuterPrepareWp {%if btype == 'image'%}{%else%}VideoIntSlideRQ{%endif%}"><div class="SlideImagePaotRW">

            {%- if btype == 'image' -%}
             <spd-img class="cdv-element show_des" data-imglink="{{ imgLink | default: 0 }}" data-load-mode="{{ loadMode }}">
              <div class="spd-img-wrapper">
              {%- liquid 
                if image != blank
                assign imgWidth = "1500" | abs
                assign image = image
                assign classes = 'img-primary img-all'
                assign baseSrc = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E" 
                if imgWidth == blank
                assign imgWidth = image.width
                endif
                assign imgUrl = image | image_url: width: imgWidth
                assign imgFit = "contain" | prepend: 'fit-'
                assign imgFitM = bSt.imgFitM | default: 'contain' | prepend: 'fitM-' 
                endif
            -%}
              <img {% if loadMode == 'speedLoad' -%}src="{{ imgUrl }}" {%- else %} src="{{ baseSrc }}" data-src="{{ imgUrl }}" {% endif -%}height="{{ image.height }}" width="{{ image.width }}" class="spd-img-{{ secId }}{{ loopId }}-{% increment imageId %} {{ classes }} {{ loadMode }} {{ imgFit }} {{ imgFitM | default: 'fitM-contain' }}" {{ attributes }} alt=""> 
              </div>
            </spd-img>
            <spd-img class="cdv-element show_mb" data-imglink="{{ imgLink | default: 0 }}" data-load-mode="{{ loadMode }}">
              <div class="spd-img-wrapper">
              {%- liquid 
                if imagemb != blank
                assign imgWidth = "800" | abs
                assign image = imagemb
                assign classes = 'img-primary img-all'
                assign baseSrc = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E" 
                if imgWidth == blank
                assign imgWidth = image.width
                endif
                assign imgUrl = image | image_url: width: imgWidth
                assign imgFit = "contain" | prepend: 'fit-'
                assign imgFitM = bSt.imgFitM | default: 'contain' | prepend: 'fitM-' 
                endif
            -%}
              <img {% if loadMode == 'speedLoad' -%}src="{{ imgUrl }}" {%- else %} src="{{ baseSrc }}" data-src="{{ imgUrl }}" {% endif -%}height="{{ image.height }}" width="{{ image.width }}" class="spd-img-{{ secId }}{{ loopId }}-{% increment imageId %} {{ classes }} {{ loadMode }} {{ imgFit }} {{ imgFitM | default: 'fitM-contain' }}" {{ attributes }} alt=""> 
              </div>
            </spd-img>
          {%- else -%}  
            <div class="VideoIntializeSLideShow">
              <div class="SlideRqVideoExecution">
                {%- if mpvideourl != blank -%}
                  <video class="show_des" controls muted autoplay loop>
                    <source src="{{ mpvideourl }}" type="video/mp4">
                  </video>
                  <video class="show_mb" controls muted autoplay loop>
                    <source src="{{ mpvideourl_mb }}" type="video/mp4">
                  </video>
                 {%- else -%}
                  {%- if YVvideourl contains "youtube" -%}
                    <div class="show_des">{{ YVvideourl }}</div>
                  {%- endif -%}
                  {%- if YVvideourl contains "vimeo" -%}
                    <div class="show_des">{{ YVvideourl }}</div>
                  {%- endif -%}
              
                  {%- if YVvideourl_mb contains "youtube" -%}
                    <div class="show_mb">{{ YVvideourl_mb }}</div>
                  {%- endif -%}
                  {%- if YVvideourl contains "vimeo" -%}
                    <div class="show_mb">{{ YVvideourl_mb }}</div> 
                  {%- endif -%}
                {%- endif -%}         
              </div>
            </div>
          {%- endif -%}
          {%- if MobileOverHeading != blank -%}<div class="BannerSlideShowMbOver show_mb"><div class="BannerOverhdmb">{{ MobileOverHeading }}</div></div>{%- endif -%}
          </div>       
          <div class="ButtonContentPart {% if mbheading == blank %}CenterButtonBro{% endif %}">
          {%- if heading != blank -%}<div class="RQ-sd-bk-title show_des">{{ heading }}</div>{%- endif -%}
          {%- if mbheading != blank -%}<div class="RQ-sd-bk-title show_mb">{{ mbheading }}</div>{%- endif -%}
          <div class="RQ-sd-mg-btncta"><span>{{ button }}</span></div></div></div>
          {%- if bannerlink != blank -%}</a>{%- endif -%}
        </div>
      {%- endfor -%}</div><div class="swiper-button-next arrsdnxt NextButtonSlideshow"></div><div class="swiper-button-prev arrsdprev PrevButtonSlideShow"></div> <div class="swiper-pagination paginationSlideshowbanner"></div></div>
  </div>
</div>{% endcapture %}{{ RQSlideshowBanner | strip_newlines }}