      <div class="new-collection-images two-colomn-images-wrapp{% if article.metafields.custom.bridge_section_image_ == blank  %}  here_only_contemt{% endif %}  {% if article.tags contains 'Bottom_Author' or article.tags contains 'bottom_author'%}author_is_bottom{% endif %}">
  <div class="two-images-inner">
    {% if block.settings.heading != blank %}
    <div class="two-images-heading">
      <h2>{{ block.settings.heading }}</h2>
    </div>
    {% endif %}
         {% if article.metafields.custom.bridge_section_image_ != blank %}   
    <div class="two-images-grid-wrapp">
      {% for images in article.metafields.custom.bridge_section_image_.value %}
         {% if images  != blank %}
              <div class="images_with_content">
        <div class="custom-images-here">
          <img src="{{ images | img_url:'master' }}">
        </div>
              {% assign images_loop = forloop.index | plus:1 %}
        <div class="images-content for-desktop">
          {% assign content_main = article.metafields.custom.bridge_section_body_text | metafield_tag  %}    
           {% assign content_main2 = content_main | split:"<strong>"%} 
                 {% for content_main2 in content_main2 %}
                   {% unless forloop.index == 1 %}
                    {% if images_loop == forloop.index %}
      <p><strong>{{content_main2 | split:"</strong>" | first}}</strong> <br/>{{content_main2 | split:"</strong>" | last | strip_html}}</p>
          {% endif %}
                     {% endunless %}
                   {% endfor %}
        </div>
                

      </div>
        {% endif %}
        {% endfor %}
    </div>
           {% else %}
           {% if article.metafields.custom.bridge_section_body_text != blank %}
