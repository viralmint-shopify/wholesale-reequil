{% schema %}
{"name": "RQ Product best paired","tag":"div","class":"RQ-productBestPairedMn","settings": [
    {"type":"header","content":"Heading"},
        {"type":"text","id":"heading","label":"Heading"},
    {"type":"header","content":"Offer products"},
      {"type":"header","content":"Product [One]"},
    {"type":"checkbox","id":"quick_add_one","label":"Enable Quick Add","default":true},
    {"type":"product","id":"product_one","label":"Product"},
      {"type":"header","content":"Product [Two]"},
    {"type":"checkbox","id":"quick_add_two","label":"Enable Quick Add","default":true},
    {"type":"product","id":"product_two","label":"Product"},
      {"type":"header","content":"Product [Three]"},
    {"type":"checkbox","id":"quick_add_three","label":"Enable Quick Add","default":true},
    {"type":"product","id":"product_three","label":"Product"},
      {"type":"header","content":"Product [Four]"},
    {"type":"checkbox","id":"quick_add_four","label":"Enable Quick Add","default":true},
    {"type":"product","id":"product_four","label":"Product"},
      {"type":"header","content":"Product [Five]"},
    {"type":"checkbox","id":"quick_add_five","label":"Enable Quick Add","default":true},
    {"type":"product","id":"product_five","label":"Product"},
      {"type":"header","content":"Product [Six]"},
    {"type":"checkbox","id":"quick_add_six","label":"Enable Quick Add","default":true},
    {"type":"product","id":"product_six","label":"Product"}  
],"presets":[{"name":"RQ Product best paired"}],"templates":["product"]}
{% endschema %}
{% capture RQProductBestPaired %}{%- liquid
    assign sfcs = section.settings
    assign loadMode = "jsLazy"
    assign button = "SHOP NOW"
    if product.metafields.my_fields.other_products_title != blank
    assign heading = product.metafields.my_fields.other_products_title
    else
    assign heading = sfcs.heading
    endif
    if product.metafields.my_fields.other_products_1 != blank
    assign product_one = all_products[product.metafields.my_fields.other_products_1]
    else
    assign product_one = all_products[sfcs.product_one]
    endif    
    if product.metafields.my_fields.other_products_2 != blank
    assign product_two = all_products[product.metafields.my_fields.other_products_2]
    else
    assign product_two = all_products[sfcs.product_two]
    endif
    if product.metafields.my_fields.other_products_3 != blank
    assign product_three = all_products[product.metafields.my_fields.other_products_3]
    else
    assign product_three = all_products[sfcs.product_three]
    endif    
    if product.metafields.my_fields.other_products_4 != blank
    assign product_four = all_products[product.metafields.my_fields.other_products_4]
    else
    assign product_four = all_products[sfcs.product_four]
    endif
    if product.metafields.my_fields.other_products_5 != blank
    assign product_five = all_products[product.metafields.my_fields.other_products_5]
    else
    assign product_five = all_products[sfcs.product_five]
    endif
    if product.metafields.my_fields.other_products_6 != blank
    assign product_six = all_products[product.metafields.my_fields.other_products_6]
    else
    assign product_six = all_products[sfcs.product_six]
    endif
    %}
<div class="RQ-productBestPairedMnWp" section="product-best-paired">
  <div class="RQ-featcollWidthWrapper">
    {%- if heading != blank -%}<div class="RQ-fdc-hd-ds">
      {%- if heading != blank -%}<div class="RQ-fdc-hd">{{ heading }}</div>{%- endif -%}
    </div>{%- endif -%}
     <div class="swiper mySwiper ProductBestPairedMainSlideShow"><div class="RQ-fdc-mg-bkMn swiper-wrapper">
        {%- if product_one != blank -%}<div class="RQ-fdcBlockEach swiper-slide">
          <div class="RQ-fdcBlockEachInner">
          <a href="{{ product_one.url }}"><spd-img class="cdv-element show_all" data-imglink="{{ imgLink | default: 0 }}" data-load-mode="{{ loadMode }}">
            <div class="spd-img-wrapper">
            {%- liquid 
              if product_one.featured_image != blank
              assign imgWidth = "800" | abs
              assign image = product_one.featured_image
              assign classes = 'img-primary img-all'
              assign baseSrc = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E" 
              if imgWidth == blank
              assign imgWidth = image.width
              endif
              assign imgUrl = image | image_url: width: imgWidth
              assign imgFit = "contain" | prepend: 'fit-'
              assign imgFitM = bSt.imgFitM | default: 'contain' | prepend: 'fitM-' 
              endif
              assign show_quick_add = section.settings.quick_add_one
          -%}
            <img {% if loadMode == 'speedLoad' -%}src="{{ imgUrl }}" {%- else %} src="{{ baseSrc }}" data-src="{{ imgUrl }}" {% endif -%}height="{{ image.height }}" width="{{ image.width }}" class="spd-img-{{ secId }}{{ loopId }}-{% increment imageId %} {{ classes }} {{ loadMode }} {{ imgFit }} {{ imgFitM | default: 'fitM-contain' }}" {{ attributes }} alt=""> 
          <!-- <button data-with-epi="true" class="swym-button swym-add-to-wishlist-view-product product_{{product_one.id}}" data-swaction="addToWishlist" data-product-id="{{product_one.id | json}}" data-variant-id="{{product_one.variants[0].id}}" data-product-url="{{ shop.url }}{{ product_one.url }}"></button>   -->
          </div>
          </spd-img></a>
          {%- capture discount -%}
          {%- assign DiscountComparePrice = product_one.selected_or_first_available_variant.compare_at_price | money_without_currency | remove:',' | round -%}
          {%- assign DiscountComparePrice = DiscountComparePrice | times: 1.0 -%}
          {%- assign DiscountPrice = product_one.selected_or_first_available_variant.price | money_without_currency | remove:',' | round -%}  
          {{ DiscountComparePrice | minus:DiscountPrice | times:100 | divided_by:DiscountComparePrice | round }}%
          {%- endcapture -%}          
          <div class="CmbbtRqDt">{%- if product_one.title != blank -%}<a href="{{ product_one.url }}"><div class="RQ-fdc-bk-title">{{ product_one.title }}</div></a>{%- endif -%}
            <div class="cmbpriceCb"><a href="{{ product_one.url }}">{% if product_one.compare_at_price > product_one.price %}<span class="cmbcpprc">{{ product_one.compare_at_price | money }}</span>{% endif %}<span class="cmbprc">{{ product_one.price | money }}</span>{% if product_one.selected_or_first_available_variant.compare_at_price > product_one.selected_or_first_available_variant.price %}<span class="PriceWithpercentage">| {{discount | strip}} off</span>{% endif %}</a></div>
            <span class="stamped-product-reviews-badge stamped-main-badge" data-id="{{ product_one.id }}"
              data-product-sku="{{ product_one.handle }}" data-product-title="{{product_one.title}}"
              data-product-type="{{product_one.type}}" style="display: block;">
            </span>
            {% if show_quick_add == true %}
              {% render 'quick-add-button', card_product : product_one %}
            {% else %}
              {%- if button != blank -%}<div class="RQ-fdc-bk-btn"><a href="{{ product_six.url }}">{{ button }}</a></div>{%- endif -%}
            {% endif %}
          </div>
          </div>
        </div>{%- endif -%}
