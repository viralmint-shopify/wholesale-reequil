{% schema %}
{"name": "RQ Customer Reviews","tag":"div","class":"RQ-about-page-customer-reviews","settings": [
    {"type":"header","content":"Heading"},
        {"type":"text","id":"heading","label":"Heading"},
        {"type":"textarea","id":"description","label":"Description"},
    {"type":"header","content":"Founder Details"},
        {"type":"textarea","id":"founder_thoughts","label":"Thought"},
        {"type":"image_picker","id":"founder_image","label":"Image"},
        {"type":"text","id":"founder_name","label":"Name"},
        {"type":"text","id":"founder","label":"Founder"},
    {"type":"header","content":"Shopping Message"},
        {"type":"text","id":"s_title","label":"Title"},
        {"type":"textarea","id":"s_description","label":"Description"},
        {"type":"text","id":"cta_text","label":"CTA text"},
        {"type":"url","id":"cta_link","label":"CTA link"}
],"blocks":[{"type":"reviews","name":"Reviews","settings":[
    {"type":"header","content":"Reviews"}, 
        {"type":"text","id":"title","label":"Title"},
        {"type":"textarea","id":"brief","label":"Brief"},
        {"type":"text","id":"author_name","label":"Author Name"}
]}],"presets":[{"name":"RQ Customer Reviews"}],"templates":["page"]}
{% endschema %}
{% capture RQAboutCustomerReviews %}{%- liquid
    assign loadMode = "jsLazy"
    assign sabcrc = section.settings
    assign sabcrcbk = section.blocks
    assign heading = sabcrc.heading
    assign description = sabcrc.description   
    assign fthought = sabcrc.founder_thoughts
    assign image = sabcrc.founder_image
    assign fname = sabcrc.founder_name
    assign founder = sabcrc.founder
    assign s_title = sabcrc.s_title
    assign s_description = sabcrc.s_description
    assign button = sabcrc.cta_text
    assign link = sabcrc.cta_link
    %}
<div class="RQ-abtcrMnWrapper" section="RQ-about-page-customer-reviews"> 
  <div class="RQ-abtcrWidthWrapper">     
    {%- if heading != blank or description != blank -%}<div class="RQ-abtcr-hd-ds">
      {%- if heading != blank -%}<div class="RQ-abtcr-hd">{{ heading }}</div>{%- endif -%}
      {%- if description != blank -%}<div class="RQ-abtcr-ds">{{ description }}</div>{%- endif -%}
    </div>{%- endif -%}    
    {%- if fthought != blank or fname != blank or founder != blank -%}<div class="RQ-abtcr-founderMn">
      {%- if fthought != blank -%}<div class="RQ-abtcr-fthgt">{{ fthought }}</div>{%- endif -%}
      <div class="RQ-abt-ambMnFdDt">
        <spd-img class="cdv-element show_all founderImage" data-imglink="{{ imgLink | default: 0 }}" data-load-mode="{{ loadMode }}">
          <div class="spd-img-wrapper">
          {%- liquid 
            if image != blank
            assign imgWidth = "800" | abs
            assign image = image
            assign classes = 'img-primary img-all'
            assign baseSrc = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E" 
            if imgWidth == blank
            assign imgWidth = image.width
            endif
            assign imgUrl = image | image_url: width: imgWidth
            assign imgFit = "contain" | prepend: 'fit-'
            assign imgFitM = bSt.imgFitM | default: 'contain' | prepend: 'fitM-' 
            endif
        -%}
          <img {% if loadMode == 'speedLoad' -%}src="{{ imgUrl }}" {%- else %} src="{{ baseSrc }}" data-src="{{ imgUrl }}" {% endif -%}height="{{ image.height }}" width="{{ image.width }}" class="spd-img-{{ secId }}{{ loopId }}-{% increment imageId %} {{ classes }} {{ loadMode }} {{ imgFit }} {{ imgFitM | default: 'fitM-contain' }}" {{ attributes }} alt=""> 
          </div>
        </spd-img><div class="RQ-abtcr-fnmOuter">
        {%- if fname != blank -%}<div class="RQ-abtcr-fnm">{{ fname }}</div>{%- endif -%}
        {%- if founder != blank -%}<div class="RQ-abtcr-fdr">{{ founder }}</div>{%- endif -%}</div>
      </div>
    </div>{%- endif -%}
    <div class="swiper mySwiper Rqhappyiconscustomer"><div class="RQ-crcd-mg-bkMn swiper-wrapper">
      {%- for bk in sabcrcbk -%}
        {%- liquid
            assign bKs = bk.settings
            assign title = bKs.title
            assign brief = bKs.brief
            assign name = bKs.author_name
          -%}     
        {%- if title != blank or brief != blank or name != blank -%}<div class="RQ-crfBlockEach swiper-slide">
          {%- if title != blank -%}<div class="RQ-crf-bk-count">{{ title }}</div>{%- endif -%}
          {%- if brief != blank -%}<div class="RQ-crf-bk-message">{{ brief }}</div>{%- endif -%}
          {%- if name != blank -%}<div class="RQ-crf-bk-nm">{{ name }}</div>{%- endif -%}
        </div>{%- endif -%}
      {%- endfor -%}
    </div><div class="swiper-pagination paginationSlideshowbannerp"></div></div>
    {%- if s_description != blank or button != blank or s_title != blank -%}<div class="RQ-Bottom-abctlsmsg">
    {%- if s_title != blank -%}<div class="RQ-bottmmsgTile">{{ s_title }}</div>{%- endif -%}
      {%- if s_description != blank or button != blank-%}<div class="RQ-bottomcmb-bt">
        {%- if s_description != blank -%}<div class="RQ-btmmsg">{{ s_description }}</div>{%- endif -%}
        {%- if button != blank -%}<div class="RQ-anCrvg"><a href="{{ link }}">{{ button }}</a></div>{%- endif -%}
      </div>{%- endif -%}
    </div>{%- endif -%}
  </div>
</div>{% endcapture %}{{ RQAboutCustomerReviews | strip_newlines }}