{%- style -%}
.WholeSale_Form h2.title {
    text-align: center;
    font-size: 28px;
    font-weight: 600;
}
.WholeSale_Form.contact.page-width {
    max-width: 1060px;
}
.WholeSale_Form .contact__button {
    text-align: center;
}
.WholeSale_Form .contact__button .button {
    border-radius: 3px;
}
.WholeSale_Form.contact .field:before, .WholeSale_Form.contact .field:after {
	display: none;
}
.WholeSale_Form.contact .field input, .WholeSale_Form.contact .field textarea {
    padding: 0 0px !important;
    border-bottom: 1px solid #27235e;
}
.WholeSale_Form.contact .field .field__label {
    position: static;
    font-size: 16px !important;
    color: #27235e;
    letter-spacing: 0;
}
.WholeSale_Form.contact .field {
    display: flex;
    flex-direction: column-reverse;
} 
  
{%- endstyle -%}