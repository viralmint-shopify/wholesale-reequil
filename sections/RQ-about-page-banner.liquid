{% schema %}
{"name": "RQ About page banner","tag":"div","class":"RQ-about-page-banner","settings": [
    {"type":"header","content":"Heading"},
        {"type":"text","id":"heading","label":"Heading"},
        {"type":"textarea","id":"description","label":"Description"},
    {"type":"header","content":"Image and Description"},
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"textarea","id":"bottom_description","label":"Description (Image Bottom)"},
    {"type":"header","content":"Message Bar"},
        {"type":"text","id":"message_count","label":"Number"},
        {"type":"text","id":"message","label":"Message"}
],"presets":[{"name":"RQ About page banner"}],"templates":["page"]}
{% endschema %}
{% capture RQAboutPageBanner %}{%- liquid
    assign sabts = section.settings
    assign heading = sabts.heading
    assign description = sabts.description
    assign image = sabts.image
    assign image_bottom_description = sabts.bottom_description
    assign count = sabts.message_count
    assign message = sabts.message
    assign loadMode = "jsLazy"
    %}
<div class="RQ-abtBnMnWrapper" section="RQ-about-page-banner"> 
  <div class="RQ-abtBnWidthWrapper">    
    {%- if heading != blank or description != blank -%}<div class="RQ-abtBn-hd-ds">
      {%- if heading != blank -%}<div class="RQ-abtBn-hd">{{ heading }}</div>{%- endif -%}
      {%- if description != blank -%}<div class="RQ-abtBn-ds">{{ description }}</div>{%- endif -%}
    </div>{%- endif -%}
    <spd-img class="cdv-element show_all" data-imglink="{{ imgLink | default: 0 }}" data-load-mode="{{ loadMode }}">
      <div class="spd-img-wrapper">
      {%- liquid 
        if image != blank
        assign imgWidth = "800" | abs
        assign image = image
        assign classes = 'img-primary img-all'
        assign baseSrc = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E" 
        if imgWidth == blank
        assign imgWidth = image.width
        endif
        assign imgUrl = image | image_url: width: imgWidth
        assign imgFit = "contain" | prepend: 'fit-'
        assign imgFitM = bSt.imgFitM | default: 'contain' | prepend: 'fitM-' 
        endif
    -%}
      <img {% if loadMode == 'speedLoad' -%}src="{{ imgUrl }}" {%- else %} src="{{ baseSrc }}" data-src="{{ imgUrl }}" {% endif -%}height="{{ image.height }}" width="{{ image.width }}" class="spd-img-{{ secId }}{{ loopId }}-{% increment imageId %} {{ classes }} {{ loadMode }} {{ imgFit }} {{ imgFitM | default: 'fitM-contain' }}" {{ attributes }} alt=""> 
      </div>
    </spd-img>
    {%- if image_bottom_description != blank -%}<div class="RQ-abtBn-mbds">{{ image_bottom_description }}</div>{%- endif -%}
    {%- if count != blank or message != blank -%}<div class="RQ-abtnMsgBar">
      {%- if count != blank -%}<div class="RQ-abMct">{{ count }}</div>{%- endif -%}
      {%- if message != blank -%}<div class="RQ-abMds">{{ message }}</div>{%- endif -%}
    </div>{%- endif -%}
  </div>
</div>{% endcapture %}{{ RQAboutPageBanner | strip_newlines }}