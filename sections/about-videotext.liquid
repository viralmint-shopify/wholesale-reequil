<div class="about_video_main_wrapper">
  <div class="about-page-video-inner">

          {% if section.settings.heading != blank %}
    <div class="video_heading_wraper show_mb">
      <div class="video_heading">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>
    {% endif %}
    
    {% if section.settings.image != blank %}
    <div class="main_background_image">
         {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | img_url:'master' }}" class="show_des">
           {% else %}
            {% if section.settings.mob_image != blank %}
       <img src="{{ section.settings.mob_image | img_url:'master' }}" class="show_des">
      {% endif %}
      {% endif %}
               {% if section.settings.mob_image != blank %}
      <img src="{{ section.settings.mob_image | img_url:'master' }}" class="show_mb">
           {% else %}
                  {% if section.settings.image != blank %}
       <img src="{{ section.settings.image | img_url:'master' }}" class="show_mb">
      {% endif %}
      {% endif %}
      
          {% if section.settings.heading != blank %}
    <div class="video_heading_wraper show_des">
      <div class="video_heading">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>
    {% endif %}
    </div>
      {% if section.settings.mob_subheading != blank %}
    <div class="mobile_subheading_main show_mb">
      <p>{{ section.settings.mob_subheading }}</p>
    </div>
    {% endif %}
    {% endif %}
      {% if section.settings.video_content != blank or section.settings.video_url != blank %}
        <div class="vide_text_outer-main">
            {% if section.settings.mobile_video_heading != blank %}
  <div class="video_side_text-wrapp show_mb">
   <h2>{{ section.settings.mobile_video_heading }}</h2>
  </div>
  {% endif %}
<div class="video_text_outer-wrapp">
  {% if section.settings.video_url != blank %}
    {% assign aboutvideo = section.settings.video_url %}
  <div class="video_inner-wrapp">
     <div class="placeholder_image_video">
    {% if aboutvideo contains 'vimeo' %}
        {%assign videoid = aboutvideo | split : '/'%}
        <iframe src="https://player.vimeo.com/video/{{videoid.last}}" webkitallowfullscreen="" mozallowfullscreen="" allowfullscreen="" id="video" data-ready="true" class="resizelistener"> </iframe>
        {%- elsif aboutvideo contains "youtube"  or aboutvideo contains "youtu.be"  -%}
        <iframe id="video" src="{{aboutvideo }}"  class="resizelistener">  </iframe>
        {% else %}
   
     <video  {% if section.settings.placeholder_image != blank %}poster="{{ section.settings.placeholder_image | img_url:'master' }}"{% endif %}>
  <source src="{{ section.settings.video_url }}" type="video/mp4">
  <source src="{{ section.settings.video_url }}" type="video/ogg">
</video>
   
      {% endif %}
  </div>
     </div>
  {% endif %}
  {% if section.settings.video_content != blank %}
  <div class="video_side_text-wrapp hide_heading_here">
    {{ section.settings.video_content }}
  </div>
  {% endif %}
</div>
</div>
    {% endif %}
  </div>
</div>
{% schema %}
  {
    "name": "About Video With Text",
    "settings": [
                          {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
                                {
          "type": "image_picker",
          "id": "mob_image",
          "label": "Mobile Image"
        },
              {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
                    {
          "type": "text",
          "id": "mob_subheading",
          "label": "Mobile Subheading"
        },
                    {
          "type": "image_picker",
          "id": "placeholder_image",
          "label": "Placeholder Image"
        },
                          {
          "type": "url",
          "id": "video_url",
          "label": "Video URL"
        },
                                {
          "type": "richtext",
          "id": "video_content",
          "label": "Video Content"
        },
           {
          "type": "text",
          "id": "mobile_video_heading",
          "label": "Mobile Video Heading"
        }
    ],
      "presets": [
    {
      "name": "About Video With Text"
    }
  ]
  }
{% endschema %}