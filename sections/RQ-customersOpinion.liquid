{% schema %}
  {
    "name": "RQ-customersOpinion",
    "settings": [
      {"type":"text","id":"heading","label":"Heading"}
    ],
    "blocks":[
      {"type":"opinion","name":"Opinion",
        "settings":[
          {"type":"checkbox","id":"enableQuotesIcon","label":"Enable Quotes Icon"},
          {"type":"text","id":"customerName","label":"Customer Name"},
          {"type":"text","id":"customerType","label":"Customer Type"},
          {"type":"textarea","id":"para","label":"Paragraph"}
        ]
      }
    ],
    "presets":[{"name": "RQ-customersOpinion"}]
  }
{% endschema %}

{% if section.settings.heading != blank or section.blocks.size > 0 %}
  <div class="RQ_CstmrOpionMN" section="RQ-customersOpinion">
    <div class="RQ_CstmrOpionWrpr">
      {% if section.settings.heading != blank %}<div class="RQ_CstmrOpionHeading">{{ section.settings.heading }}</div>{% endif %}
      {% if section.blocks.size > 0 %}
        <div class="RQ_CstmrOpionListMN{% if section.blocks.size > 3 %} swiper mySwiper{% endif %}">
          <div class="RQ_CstmrOpionListWrpr{% if section.blocks.size > 3 %} swiper-wrapper{% endif %}">
            {% for block in section.blocks %}
              {% if block.settings.enableQuotesIcon == true or block.settings.para != blank or block.settings.customerName != blank or block.settings.customerType != blank %}
                <div class="RQ_CstmrOpionItemMN{% if section.blocks.size > 3 %} swiper-slide{% endif %}">
                  <div class="RQ_CstmrOpionItemWrpr">
                    {% if block.settings.enableQuotesIcon == true %}<div class="RQ_CstmrOpionItemIcon"><span>,,</span></div>{% endif %}
                    {% if block.settings.para != blank %}<div class="RQ_CstmrOpionItemPara">{{ block.settings.para }}</div>{% endif %}
                    {% if block.settings.customerName != blank or block.settings.customerType != blank %}
                      <div class="RQ_CstmrDetailsMN">
                        {% if block.settings.customerName != blank %}<div class="RQ_CstmrName">{{ block.settings.customerName }}</div>{% endif %}
                        {% if block.settings.customerType != blank %}<div class="RQ_CstmrType">{{ block.settings.customerType }}</div>{% endif %}
                      </div>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
          {% if section.blocks.size > 3 %}<div class="swiper-pagination"></div>{% endif %}
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}