{% if product.tags contains 'Jitter' or product.tags contains 'jitter' %}
  <script>
    document.addEventListener('DOMContentLoaded', ()=>{
      function SetUpStorageFiveMinute(name,value,minutes) {
          if (minutes) {
              var date = new Date(); date.setTime(date.getTime()+(minutes*60*1000)); var expires = "; expires="+date.toGMTString();
          } else { var expires = ""; }
          document.cookie = name+"="+value+expires+"; path=/";
      }
      function DebugAfterFiveEach(name) {
          var dc = document.cookie; var prefix = name + "="; var begin = dc.indexOf("; " + prefix);
          if (begin == -1) {
              begin = dc.indexOf(prefix);
              if (begin != 0) return null;
          }else{
                begin += 2;
                var end = document.cookie.indexOf(";", begin);
                if (end == -1) { end = dc.length; }
          }
          return decodeURI(dc.substring(begin + prefix.length, end));
      }    
      var FounderWayCookie = DebugAfterFiveEach("{{product.handle}}");
      if (FounderWayCookie == null) {
        document.querySelector('.animated_pdp-gif').classList.remove('hidden');
        setTimeout( ()=>{
          document.querySelector('.animated_pdp-gif').classList.add('hidden');
          SetUpStorageFiveMinute("{{product.handle}}", "true", 5)
        },6000)      
      }
    })
  </script>  
{% endif %}  
                        
