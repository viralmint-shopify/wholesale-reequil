{% schema %}
{"name": "RQ Customer Reviews","tag":"div","class":"RQ-customer-reviews","settings": [
    {"type":"header","content":"Heading"},
        {"type":"text","id":"heading","label":"Heading","default":"Heading"} 
],"blocks":[{"type":"reviews","name":"Reviews","settings":[
    {"type":"header","content":"Reviews"}, 
        {"type":"textarea","id":"reviews","label":"Review"},
        {"type":"text","id":"author_name","label":"Author name"},
        {"type":"image_picker","id":"star_image","label":"Star image"}
]}],"presets":[{"name":"RQ Customer Reviews"}],"templates":["index"]}
{% endschema %}
{% capture RQCustomerReviews %}{%- liquid
  assign scrs = section.settings
  assign scrbk = section.blocks
  assign heading = scrs.heading
  assign loadMode = "jsLazy"
%}
  <div class="RQ-reviewsMnWrapper" section="RQ-customer-reviews"> 
    <div class="RQ-abtBnWidthWrapper">    
        {%- if heading != blank -%}<div class="RQ-abtBn-hd-ds">
          {%- if heading != blank -%}<div class="RQ-abtBn-hd">{{ heading }}</div>{%- endif -%}
        </div>{%- endif -%}  
      <div class="RqCustRslideshowMN">
        <div class="swiper mySwiper RqcustomerRslideshow">
          <div class="RQ-rewviewsWidthWrapper swiper-wrapper">
            {%- for bk in scrbk -%}
              {%- liquid
                assign bKs = bk.settings
                assign reviews = bKs.reviews
                assign author = bKs.author_name
                assign starImage = bKs.star_image
              -%}
              <div class="RQ-reviewsMnall swiper-slide">
                <div class="RQ-reviewsMnallInner">{%- if reviews != blank -%}<div class="RQ-reviews-ds">{{ reviews }}</div>{%- endif -%}
                  <div class="RQ-reviews-dsOuter">
                    {%- if author != blank -%}<div class="RQ-reviews-aut">{{ author }}</div>{%- endif -%}
                    <spd-img class="cdv-element show_all" data-imglink="{{ imgLink | default: 0 }}" data-load-mode="{{ loadMode }}">
                      <div class="spd-img-wrapper">
                      {%- liquid 
                        if starImage != blank
                        assign imgWidth = "112" | abs
                        assign image = starImage
                        assign classes = 'img-primary img-all'
                        assign baseSrc = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E" 
                        if imgWidth == blank
                        assign imgWidth = image.width
                        endif
                        assign imgUrl = image | image_url: width: imgWidth
                        assign imgFit = "contain" | prepend: 'fit-'
                        assign imgFitM = bSt.imgFitM | default: 'contain' | prepend: 'fitM-' 
                        endif
                    -%}
                      <img {% if loadMode == 'speedLoad' -%}src="{{ imgUrl }}" {%- else %} src="{{ baseSrc }}" data-src="{{ imgUrl }}" {% endif -%}height="{{ image.height }}" width="{{ image.width }}" class="spd-img-{{ secId }}{{ loopId }}-{% increment imageId %} {{ classes }} {{ loadMode }} {{ imgFit }} {{ imgFitM | default: 'fitM-contain' }}" {{ attributes }} alt=""> 
                      </div>
                    </spd-img>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
          {% if settings.catch_the_santa == true %}
            <div class="SantaMediaMn" snippet="santa_media">
              <div class="SantaMediaWrpr">
                <div class="SantaMediaInit"><img src="https://cdn.shopify.com/s/files/1/0306/6262/3364/files/love_1.png?v=1703070877"></div>
              </div>
            </div>
          {% endif %}
          <div class="swiper-button-next arrsdnxt NextButtonSlideshowcr"></div><div class="swiper-button-prev arrsdprev PrevButtonSlideShowcr"></div> <div class="swiper-pagination paginationSlideshowbannercr"></div>
        </div>
      </div>
    </div>
  </div>
{% endcapture %}
{{ RQCustomerReviews | strip_newlines }}