    height: 100%;
    z-index: 92;
    background: rgba(108, 108, 108, 0.80);
}
.cv_popup_inner .cross_icon {
    position: absolute;
    top: 20px;
    right: 20px;
    cursor: pointer;
}
.cv_poup_image {
    color: #27235E;
    text-align: center;
    font-size: 100px;
    font-weight: 900;
    line-height: 165.411px;
    letter-spacing: -2px;
}
.cv_poup_image .endPrt {
    font-size: 130px;
    line-height: 1;
    letter-spacing: -2.6px;
    display: block;
}
.AnimateMediaMN {
    position: absolute;
    z-index: -1;
    transform: rotate(90deg);
}
.AnimateMediaMN img {
    width: 100%;
    height: auto;
    max-width: 400px;
}
.AnimateMediaMN:first-child {
    left: -10%;
    top: -120px;
    transform: rotate(180deg);
}
.AnimateMediaMN:nth-child(2) {
    left: -10%;
    top: 10px;
}
.AnimateMediaMN:nth-child(3) {
    left: 10%;
    top: -120px;
}
.AnimateMediaMN:nth-child(4) {
    top: -120px;
    right: 0;
    margin: auto;
}
.AnimateMediaMN:nth-child(5) {
    top: 40px;
    left: 10%;
}
.AnimateMediaMN:nth-child(6) {
    top: 0;
    right: 0;
}
.AnimateMediaMN:nth-child(7) {
    top: -20px;
    margin: auto;
}
.AnimateMediaMN:nth-child(8) {
    left: -120px;
    top: 250px;
}
.AnimateMediaMN:nth-child(9) {
    right: 100px;
    top: 120px;
}
.AnimateMediaMN:nth-child(10) {
    right: 300px;
    top: 120px;
}
.AnimateMediaMN:nth-child(11) {
    right: 300px;
    bottom: 0;
}
.AnimateMediaMN:nth-child(12) {
    left: 20%;
    bottom: -120px;
    transform: rotate(45deg);
}
.AnimateMediaMN:nth-child(13) {
    right: 0;
    bottom: -120px;
}
.AnimateMediaMN:nth-child(14) {
    left: 0;
    bottom: 0;
}
.AnimateMediaMN:nth-child(15) {
    left: -150px;
    bottom: 0;
}
.AnimateMediaMN:nth-child(16) {
    right: -150px;
    bottom: 0;
}
.AnimateMediaMN:nth-child(17) {
    right: -150px;
    bottom: 100px;
}
.AnimateMediaMN:nth-child(18) {
    right: -100px;
    bottom: -100px;
}
.AnimateMediaMN:nth-child(19) {
    top: -100px;
    left: 0px;
    right: 0;
}
.AnimateMediaMN:nth-child(20) {
    top: -250px;
    left: 0px;
    right: 0;
}
/* Happy new year popup css end */
