{%- style -%}
.RQguideExWP {
    padding: 26px 24px 0px;
    max-width: 1112px;
    margin: auto;
    position: relative;
} 
.ArtcileGuideMg .spd-img-wrapper img {
    width: 100%;
    display: block;
    transition: ease .5s;
    cursor: pointer;
} 
.ArtcileGuideMg .spd-img-wrapper img:hover {
    transform: scale(1.07);
} 
.ArtcileGuideMg {
    overflow: hidden;
    margin: 0 0 17px;
}
.AtitleWpgd {
    text-align: center;
    font-size: 32px;
    margin: 0 auto 24px;
    max-width: 500px;
    color: #27235e;
    line-height: 38px;
}
.AtitleWpgdButton {
    text-align: center;
}
.AtitleWpgdButton a {
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    display: inline-block;
    text-transform: uppercase;
    color: #FFFFFF;
    background: #27235E;
    padding: 13px;
    width: 100%;
    max-width: 168px;
}
.AtitleWpgdButton a:hover {
    background: #524f7e;
}
.WrapperArtcilesguides {
  max-width: 1112px;
  margin: auto;
  position: relative;
  padding: 67px 24px 30px;
}
.guidehdGt {
    font-size: 32px;
    color: #27235e;
    line-height: 38px;
}
.guidedshf {
    font-size: 16px;
    color: #828282;
}
.HeaderArticlesWrapper {
    margin: 0 0 21px;
}
.BlogTitleWp {
    font-size: 24px;
    line-height: 28px;
    margin: 0 0 10px;
    color: #27235e;
    text-transform: capitalize;
}
ul.custom-tabs {
    list-style: none;
    margin: 0 0 48px;
    padding: 0 0 2px;
    display: flex;
    overflow: auto;
    position: relative;
}
ul.custom-tabs::-webkit-scrollbar {
    display: none;
}
ul.custom-tabs li {
    min-width: fit-content;
    margin-right: 10px;
}
ul.custom-tabs li a {
    padding: 7px 14.21px;
    font-size: 16px;
    line-height: 140%;
    display: inline-block;
    text-align: center;
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    text-transform: capitalize;
}
ul.custom-tabs li a:hover {
    background: #27235e;
    color: #fff;
}
ul.custom-tabs li.active a {
    background: #27235E;
    color: #fff;
    border: 1px solid #27235E;
}
.Guidesarticle-card .article-card__image.media {
    padding-bottom: 0 !important;
    background: transparent;
}
.Guidesarticle-card .article-card__image spd-img {
    position: static !important;
}
.Guidesarticle-card .article-card__image spd-img img {
    display: block;
    width: 100%;
    height: 308px;
    object-fit: cover;
    transition: ease .5s;
}
.Guidesarticle-card .article-card__image spd-img img:hover {
    transform: scale(1.07);
}
.Guidesarticle-card {
    display: flex;
}
.Guidesarticle-card .article-card__title {
    font-size: 16px;
    margin: 0 0 8px;
    line-height: 24px;
    font-weight: 500;
    color: #333333;
}
.Guidesarticle-card .article-card__excerpt {
    font-size: 16px;
    line-height: 24px;
    color: #828282;
}
.blog-date-auther-part span {
    font-size: 14px;
    text-transform: capitalize;
    color: #828282;
    letter-spacing: normal;
    display: inline-block;
    margin-bottom: 2px;
}
.blog-date-auther-part span.caption-with-letter-spacing {
    white-space: nowrap;
    position: relative;
    padding-left: 22px;
    margin-right: 11px;
}
.blog-date-auther-part span.caption-with-letter-spacing:first-child {
    padding-left: 0;
}
.blog-date-auther-part .caption-with-letter-spacing:before {
    width: 6px;
    display: inline-block;
    height: 6px;
    margin: 0;
    border-radius: 10px;
    background-color: #27235e;
    position: absolute;
    content: "";
    top: 5px;
    left: 0;
}
.blog-date-auther-part span.caption-with-letter-spacing:first-child:before {
  display: none;
}
.article-card__info {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    width: 50%;
    padding: 0 26px;
    background-color: #fff;
}
.Guidesarticle-card .article-content {
    width: 50%;
}
label.image-label {
    color: #fff;
    text-transform: uppercase;
    background-color: #27235e;
    min-width: 134px;
    padding: 11px 24px;
    display: inline-block;
    text-align: center;
    border-radius: 100px;
    position: absolute;
    top: 20px;
    left: 20px;
    font-weight: 500;
    box-sizing: border-box;
}
.QuestionHolderWraoper {
    margin-bottom: 70px;
    position: relative;
}
.QuestionHolderWraoper:last-child {
    margin-bottom: 0px;
}
footer.mnFooterExutionWp {
    margin-top: 40px;
}
.mySwiper.RqslideshowBanner {
    position: static;
}
.swiper-button-next.arrsdnxt {
    display: block;
    width: 32px;
    height: 32px;
    background-image: url(https://cdn.shopify.com/s/files/1/0306/6262/3364/files/arrow-right.png?v=1673261335);
    right: -60px;
    background-repeat: no-repeat;
    transform: translateY(-50%);
    margin: 0;
    top: calc(50% + 60px);
}
.swiper-button-prev.arrsdprev {
    display: block;
    width: 32px;
    height: 32px;
    background-image: url(https://cdn.shopify.com/s/files/1/0306/6262/3364/files/arrow-left.png?v=1673261335);
    left: -60px;
    background-repeat: no-repeat;
    transform: translateY(-50%);
    margin: 0;
    top: calc(50% + 60px);
}
.swiper-button-prev.arrsdprev:after, .swiper-button-next.arrsdnxt:after {
  display: none;
}
.blog-date-auther-part .block2 {
    display: none;
}
.swiper-pagination.swiper-pagination-bullets {
    position: static;
    font-size: 0;
    margin: 24px 0 0;
}
.swiper-pagination .swiper-pagination-bullet {
    background: #D9D9D9 !important;
    opacity: 1;
    width: 6px;
    height: 6px;
    margin: 0 3px !important;
    outline: none;
    box-shadow: none;
}
.swiper-pagination .swiper-pagination-bullet.swiper-pagination-bullet-active {
    background: #27235E !important;
}
/* media css start here */

@media (min-width: 750px) {
.swiper-pagination.swiper-pagination-bullets {
   display: none !important;
}
}
@media (max-width: 1279px) {
.swiper-button-next.arrsdnxt {
    right: 10px;
}
.swiper-button-prev.arrsdprev {
    left: 10px;
}
}
@media (max-width: 1023px) {
.guidehdGt {
    font-size: 28px;
}
ul.custom-tabs li a {
    padding: 7px 10.21px;
    font-size: 12px;
}
label.image-label {
    font-size: 12px;
    min-width: 96px;
    padding: 4px 21px;
    line-height: 16px;
    top: 10px;
    left: 10px;
}
.Guidesarticle-card .article-card__excerpt {
    font-size: 14px;
}
.Guidesarticle-card .article-card__image spd-img img {
    height: 230px;
}
.blog-date-auther-part span {
    font-size: 12px;
}
.blog-date-auther-part .caption-with-letter-spacing:before {
    width: 4px;
    height: 4px;
}
}
@media (max-width: 749px) {
.swiper-pagination.swiper-pagination-bullets {
    margin: 24px auto 0;
    transform: inherit !important;
}
.RQguideExWP {
    padding: 50px 0px 0px;
}
.AtitleWpgd {
    margin-bottom: 20px;
    letter-spacing: .2px;
    font-size: 24px;
    line-height: 115%;
    padding: 0 18px;
}
.guidedshf {
    font-size: 14px;
}
.guidehdGt {
    font-size: 24px;
}
ul.custom-tabs {
    margin: 0 0 20px;
}
.article-card__info {
    padding: 10px 20px;
    width: 100%;
    box-sizing: border-box;
}
.Guidesarticle-card {
    display: block;
}
.Guidesarticle-card .article-card__title {
    font-size: 14px;
    line-height: 21px;
    margin: 0 0 8px;
}
.Guidesarticle-card .article-content {
    width: 100%;
}
.Guidesarticle-card .article-card__image spd-img img {
    height: auto;
}
.swiper-button-next.arrsdnxt, .swiper-button-prev.arrsdprev {
    display: none;
}
.Guidesarticle-card .article-card__excerpt {
    font-size: 12px;
    line-height: 18px;
    margin-bottom: 8px;
}
.blog-date-auther-part span.caption-with-letter-spacing {
    padding-left: 15px;
    margin-right: 10px;
}
.blog-date-auther-part .caption-with-letter-spacing:before {
    left: -2px;
}
.WrapperArtcilesguides {
    padding: 50px 20px 30px;
}
.AtitleWpgdButton a {
    max-width: 165px;
}
.QuestionHolderWraoper {
    margin-bottom: 30px;
}

}
  
{%- endstyle -%}