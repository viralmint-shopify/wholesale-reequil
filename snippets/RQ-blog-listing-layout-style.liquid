{%- style -%}
.MainBlogSepationWp {
    display: flex;
    flex-wrap: wrap;
    margin-left: -32px;
}
.TopPodCastCategoryItem {
    width: 50%;
    padding-left: 32px;
    margin-bottom: 32px;
}
.RQ-blog-listingMainWrapper {
    max-width: 1052px;
    margin: auto;
    padding: 8px 24px 36px;
}
.RQBreadCrumbsLayout {
    max-width: 1140px;
}
.breadcrumbs__list {
    padding: 0;
}
.TopPdCstCtgrItmBox>a {
    padding: 12px;
    box-shadow: 4px 4px 13px transparent;
    transition: ease .3s;
    display: block;
}
.TopPdCstImg img {
    width: 100%;
    display: block;
    height: 262px;
    object-fit: cover;
}
.TopPdCstDes h2 {
    font-weight: 600;
    font-size: 24px;
    line-height: 140%;
    color: #27235E;
    margin: 0 0 4px;
}
.TopPdCstDes {
    margin: 12px 0 0;
}
.TopPdCstDes p {
    font-size: 16px;
    line-height: 150%;
    letter-spacing: 0.04em;
    color: #333333;
    margin: 0 0 8px;
}
.RqArticleCardInfo {
    line-height: 1;
}
.RqArticleCardInfo span {
    font-size: 12px;
    line-height: 140%;
    color: #333333;
    opacity: .8;
    display: inline-block;
}
.RqArticleCardInfo .circle-divider {
    padding-left: 17px;
}
.RqArticleCardInfo time {
    position: relative;
}
.RqArticleCardInfo time:before {
    content: '';
    background: #333333;
    opacity: .8;
    width: 5px;
    height: 5px;
    border-radius: 100px;
    display: inline-block;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    left: -13px;
}
body .pagination-wrapper {
    margin: 0;
}
body .pagination__list {
    justify-content: flex-end;
}
body .pagination__item--current:after, body .pagination__item:hover:after {
    display: none;
}
body .pagination__item {
    font-size: 16px;
    line-height: 140%;
    text-align: center;
    color: #333333;
    opacity: 0.8;
    height: auto;
}
body .pagination__item.pagination__item--current {
    text-decoration-line: underline;
    color: #27235E;
    opacity: 1;
}
body .pagination__list>li:not(:last-child) {
    margin-right: 2px;
    flex: 0 0 25px;
}
.pagination__item svg.icon.icon-caret {
    position: relative;
    top: -2.5px;
}
body .pagination__item--prev .icon {
    width: 25px;
}
body .pagination__list>li {
    flex: inherit;
}
/* media css start here */

@media (min-width: 750px) {
.TopPdCstCtgrItmBox>a:hover {
    box-shadow: 4px 4px 13px rgb(0 0 0 / 25%);
}
}

@media (max-width: 1023px) {
.TopPodCastCategoryItem {
    padding-left: 15px;
    margin-bottom: 24px;
}
.MainBlogSepationWp {
    margin-left: -15px;
}
.TopPdCstDes h2 {
    font-size: 20px;
}
.TopPdCstImg img {
    height: 170px;
}
}
 
@media (max-width: 749px) {
.TopPdCstImg img {
    height: 180px;
} 
.TopPdCstDes {
    margin: 8px 0 0;
}
.TopPdCstDes h2 {
    font-size: 16px;
    margin: 0 0 6px;
}
.TopPdCstDes p {
    font-size: 12px;
    margin: 0 0 6px;
}
.TopPodCastCategoryItem {
    width: 100%;
}
.RQ-blog-listingMainWrapper {
    padding: 12px 14px 4px;
}
.breadcrumbs__list {
    margin: 12px 0;
}
.TopPdCstCtgrItmBox>a {
    padding: 10px;
    box-shadow: 0px 0px 5px rgb(0 0 0 / 25%);
}
}

{%- endstyle -%}