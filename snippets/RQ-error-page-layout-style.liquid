{%- style -%}
.template-404 #MainContent {
    padding: 64px 0 68px;
} 
.RqErrorInnerWrap {
    max-width: 882px;
    margin: auto;
    padding: 0 24px;
    text-align: center;
}
.RqErrorBannerMg img {
    width: 100%;
    max-width: 353px;
    display: block;
    margin: auto;
}
.RqErrorBannerMg {
    margin: 0 0 64px;
}
.RqErrorHeading {
    font-weight: 600;
    font-size: 32px;
    line-height: 140%;
    letter-spacing: 0.02em;
    color: #27235E;
    margin: 0 0 20px;
}
.RqErorrDescrition {
    font-size: 18px;
    line-height: 140%;
    letter-spacing: 0.04em;
    color: #333333;
    margin: 0 0 34px;
}
.RqErorrDescrition a {
    letter-spacing: 0.04em;
    text-decoration-line: underline;
    color: #27235E;
    font-weight: 600;
}
.RqErorrDescrition a:hover {
    color: #524f7e;
}
.RqErrorCtaText a {
    background: #27235E;
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    display: inline-block;
    text-align: center;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #FFFFFF;
    width: 100%;
    max-width: 148px;
    padding: 12px 10px;
}
.RqErrorCtaText a:hover {
    background: #524f7e;
}

/* Bestseller section css start */
.RQ-featcollMnWrapper {
    margin: 116px 0 0;
}
.RQ-featcollWidthWrapper {
    max-width: 1112px;
    margin: auto;
    position: relative;
    padding: 0 24px;
}
.RQ-fdc-hd {
    font-weight: 600;
    font-size: 32px;
    line-height: 140%;
    letter-spacing: 0.02em;
    color: #27235E;
    margin: 0 0 34px;
} 
.RQ-fdcBlockEachInner img {
    width: 100%;
    display: block;
}
/* .RQ-fdcBlockEachInner {
    border: 1px solid #D5D5D5;
} */
.RQ-fdc-bk-title {
    font-size: 12px;
    line-height: 18px;
    text-transform: capitalize;
    color: #333333;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    padding-right: 7px;
}
.CmbbtRqDt {
    padding: 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 36px;
}
.RQ-fdc-bk-btn {
    min-width: 80px;
}
.RQ-fdc-bk-btn a {
    background: #27235E;
    display: block;
    color: #fff;
    text-align: center;
    font-weight: 500;
    font-size: 10px;
    line-height: 20px;
    padding: 3px;
    text-transform: uppercase;
}
.RQ-fdc-bk-btn a:hover {
    background: #524f7e;
}
.swiper-pagination.swiper-pagination-bullets {
    position: static;
    font-size: 0;
    margin: 24px 0 0;
}
.swiper-pagination .swiper-pagination-bullet {
    background: #D9D9D9 !important;
    opacity: 1;
    width: 6px;
    height: 6px;
    margin: 0 3px !important;
    outline: none;
    box-shadow: none;
}
.swiper-pagination .swiper-pagination-bullet.swiper-pagination-bullet-active {
    background: #27235E !important;
}
.swiper.mySwiper {
    position: static;
}
.swiper-button-next.arrsdnxt {
    display: block;
    width: 32px;
    height: 32px;
    background-image: url(https://cdn.shopify.com/s/files/1/0306/6262/3364/files/arrow-right.png?v=1673261335);
    right: -30px;
    background-repeat: no-repeat;
}
.swiper-button-prev.arrsdprev {
    display: block;
    width: 32px;
    height: 32px;
    background-image: url(https://cdn.shopify.com/s/files/1/0306/6262/3364/files/arrow-left.png?v=1673261335);
    left: -30px;
    background-repeat: no-repeat;
}
.swiper-button-next:after, .swiper-button-prev:after {
  display: none !important;
}
/* Bestseller section css end */

/* media css start here */
@media (max-width: 1279px) {
/* Bestseller media css start */
.RQ-featcollWidthWrapper {
    max-width: 950px;
}
.swiper-button-next.arrsdnxt {
    right: -20px;
}
.swiper-button-prev.arrsdprev {
    left: -20px;
}
/* Bestseller media css end */
}
@media (max-width: 1023px) {
/* Bestseller media css start */
.RQ-featcollWidthWrapper {
    max-width: 900px;
}
.swiper-button-next.arrsdnxt {
    right: -15px;
}
.swiper-button-prev.arrsdprev {
    left: -15px;
}
/* Bestseller media css end */
}
@media (max-width: 989px) {
/* Bestseller media css start */
.RQ-featcollWidthWrapper {
    max-width: 750px;
}
.swiper-button-next.arrsdnxt {
    right: -10px;
}
.swiper-button-prev.arrsdprev {
    left: -10px;
}
/* Bestseller media css end */
}
@media (max-width: 768px) {
/* Bestseller media css start */
.RQ-featcollWidthWrapper {
    max-width: 730px;
}
/* Bestseller media css end */
}
@media (max-width: 749px) {
/* Bestseller media css start */
.RQ-fdc-bk-title {
    font-size: 14px;
    line-height: 140%;
    padding: 12px 8px 0px;
    letter-spacing: 0.04em;
    min-height: 40px;
} 
.RQ-fdc-bk-btn {
    min-width: inherit;
    margin-top: 22px;
}
.cmbpriceCb {
    padding: 10px 8px 0;
}
span.cmbcpprc {
    font-weight: 600;
    font-size: 16px;
    line-height: 100%;
    text-decoration-line: line-through;
    color: #333333;
    opacity: 0.8;
    margin-right: 8px;
}
span.cmbprc {
    font-weight: 600;
    font-size: 16px;
    line-height: 100%;
    color: #333333;
    opacity: 0.8;
}
.CmbbtRqDt {
    padding: 0;
    min-height: inherit;
    display: block;
}
.RQ-fdcBlockEachInner {
    padding: 4px;
}
.RQ-fdc-bk-btn a {
    font-size: 12px;
    padding: 9px 5px;
}
.swiper-pagination.swiper-pagination-bullets {
    display: none;
}
/* Bestseller media css end */
.template-404 #MainContent {
    padding: 64px 0 28px;
}
.RqErrorBannerMg img {
    max-width: 240px;
}
.swiper-button-next.arrsdnxt, .swiper-button-prev.arrsdprev {
    display: none !important;
}
.RqErrorHeading {
    font-size: 20px;
    margin: 0 0 16px;
}
.RqErorrDescrition {
    font-size: 14px;
    max-width: 274px;
    margin: auto auto 24px;
}
.RqErrorCtaText a {
    font-size: 12px;
    max-width: 128px;
    padding: 8px 8px;
}
.RQ-featcollMnWrapper {
    margin: 64px 0 0;
}
.RQ-fdc-hd {
    font-size: 20px;
    margin: 0 0 14px;
}

}
  
{%- endstyle -%}