{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}
{% render 'blog-listing-article-style' %}
{% render 'new-article-style' %}
<div class="progress-bar-container">
  <div class="progress-bar"></div>
</div>
<style>
  .progress-bar-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
    display:none;
  height: 5px;
  background-color: #f0f0f0;
  z-index: 9999;
}
.progress-bar-container .progress-bar {
    display: block !IMPORTANT;
}
.progress-bar {
  height: 100%;
  background-color: #27235E;
  transition: all 0.3s ease;
}

</style>
<article class="article-template" itemscope itemtype="http://schema.org/BlogPosting">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when '@app' -%}
        <div class="page-width page-width--narrow">
          {% render block %}
        </div>
  {% when 'mobile_sec' %}
                <header class="new-article-title for-mobile" {{ block.shopify_attributes }}>
          <h1 class="article-template__title" itemprop="headline">{{ article.title | escape }}</h1>
                    {% if article.tags contains 'Bottom_Author' or article.tags contains 'bottom_author'  %}
    <p class="single_author_date">{{ article.published_at | time_tag: format: 'date' }} </p>
    {% endif %}
          </header>

   {% unless article.tags contains 'Bottom_Author' or article.tags contains 'bottom_author'%}
                <div class="author_data_wrapp for-mobile">
      <div class="author_share_wrapper">
            <div class="autor_image_content_wrapp">
      {% if block.settings.author_image  != blank %}
      <div class="author_image"><img src="{{ block.settings.author_image | img_url:'master' }}"></div>
        {% endif %}
      <div class="author_content">
      <div class="author_name_desination">
      <p><strong>{% if article.author contains 'Manasi' %}Dr{% endif %} {{ article.author }}</strong></p>
        <p>{{ block.settings.author_designation }} | {{ article.published_at | time_tag: format: 'date' }} </p>
      </div>
      </div>
      </div>
         {% if block.settings.author_description != blank %}
        <div class="author_content">
            <p>{{ block.settings.author_description }}</p>
        </div>
         {% endif %}
      </div>
                </div>
  {% endunless %}
      {%- when 'featured_image'-%}
        {%- if article.image -%}
          <div class="article-template__hero-container" {{ block.shopify_attributes }}>
            <div class="article-template__hero-{{ block.settings.image_height }} media"
              itemprop="image"
              {% if block.settings.image_height == 'adapt' and article.image %} style="padding-bottom: {{ 1 | divided_by: article.image.aspect_ratio | times: 100 }}%;"{% endif %}
            >
              <img
                srcset="{% if article.image.width >= 350 %}{{ article.image | image_url: width: 350 }} 350w,{% endif %}
                  {% if article.image.width >= 750 %}{{ article.image | image_url: width: 750 }} 750w,{% endif %}
                  {% if article.image.width >= 1100 %}{{ article.image | image_url: width: 1100 }} 1100w,{% endif %}
                  {% if article.image.width >= 1500 %}{{ article.image | image_url: width: 1500 }} 1500w,{% endif %}
                  {% if article.image.width >= 2200 %}{{ article.image | image_url: width: 2200 }} 2200w,{% endif %}
                  {% if article.image.width >= 3000 %}{{ article.image | image_url: width: 3000 }} 3000w,{% endif %}
                  {{ article.image | image_url }} {{ article.image.width }}w"
                sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw"
                src="{{ article.image | image_url: width: 1100 }}"
                loading="eager"
                width="{{ article.image.width }}"
                height="{{ article.image.height }}"
                alt="{{ article.image.alt | escape }}">
            </div>
          <header class="new-article-title page-width page-width--narrow for-desktop" {{ block.shopify_attributes }}>
          <h1 class="article-template__title" itemprop="headline">{{ article.title | escape }}</h1>
          {% if article.published_at %}
          <p>{{ article.published_at | time_tag: format: 'date' }} {% if article.metafields.custom.reading_time %}| {{ article.metafields.custom.reading_time }}{% endif %}</p>
            {% endif %}
          </header>
          </div>
        {%- endif -%}

        {%- when 'content'-%}
      <div class="new-article-content_wrapp">
                 <div class="article-template__content page-width page-width--narrow rte" itemprop="articleBody" {{ block.shopify_attributes }}>
              {{ article.content }}
          </div> 
      </div>

