{%- style -%}
.RqNextListVwMre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 0 24px;
}
.rqPodcstViewMoreBtn {
    padding-left: 10px;
}
.rqPodcstViewMoreBtn a {
    font-weight: 400;
    font-size: 18px;
    line-height: 150%;
    letter-spacing: 0.04em;
    text-decoration-line: underline !important;
    color: #27235E;
}
/* for review text css start here */
.RelatedProductsWrapper span.stamped-badge-caption {
    margin-left: 3px;
    font-size: 12px;
    line-height: 100%;
    color: #333333;
    opacity: 0.8;
    position: relative;
    top: -1px;
}
body .RelatedProductsWrapper span.stamped-badge-caption:before {
    content: '(' !important;
}
body .stamped-badge-caption[data-reviews][data-label][data-version="2"]:after {
    content: ')' !important;
}
body .stamped-badge-caption[data-reviews][data-label][data-version="2"]>span {
    font-weight: 400;
    font-size: 14px;
    line-height: 150%;
    text-decoration-line: underline;
    color: #27235E;
    text-transform: capitalize;
    margin-left: 10px;
    display: none !important;
}
/* for review text css start here */
.RelatedProductsWrapper, .EpisodesPodcastListArticalWp {
    max-width: 1112px;
    margin: auto;
    padding: 0 24px;
}
.RQBreadCrumbsLayout {
    max-width: 1112px;
}
.breadcrumbs__list {
    padding: 0;
}
.mySwiper {
    overflow: visible;
}
.WrapperRelatedproductEx {
    overflow: hidden;
}
.hdrel {
    font-weight: 600;
    font-size: 32px;
    line-height: 140%;
    letter-spacing: 0.02em;
    color: #27235E;
    margin: 0 0 24px;
}
/* .CollectionRqDataInner {
    border: 1px solid #D5D5D5;
} */
.CmbbtRqDt {
    padding: 10px;
}
.CollectionRqDataInner .spd-img-wrapper img {
    display: block;
    width: 100%;
}
.RQ-fdc-bk-title {
    text-transform: capitalize;
    margin: 0 0 10px;
    min-height: 45px;
    font-weight: 400;
    font-size: 16px;
    line-height: 140%;
    color: #333333;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
}
.RQ-fdc-bk-btn {
    width: 100%;
    display: block;
    margin: 10px 0 0;
}
.RQ-fdc-bk-btn a {
    background: #27235E;
    color: #fff;
    text-align: center;
    font-weight: 500;
    line-height: normal;
    padding: 2px;
    height: 38px;
    font-size: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
}
.RQ-fdc-bk-btn a:hover {
    background: #524f7e;
}
.PaginationWithFractionRecomm {
    display: flex;
    align-items: center;
    max-width: 100px;
    justify-content: center;
    margin: 24px auto auto;
}
.PrevButtonSlideShowfd {
    display: block !important;
    width: 20px;
    height: 20px;
    background-image: url(https://cdn.shopify.com/s/files/1/0306/6262/3364/files/arrow-left.png?v=1673261335);
    background-repeat: no-repeat;
    position: static !important;
    background-size: 20px;
    margin: 0;
}
.NextButtonSlideshowfd {
    display: block !important;
    width: 20px;
    height: 20px;
    background-image: url(https://cdn.shopify.com/s/files/1/0306/6262/3364/files/arrow-right.png?v=1673261335);
    background-repeat: no-repeat;
    position: static !important;
    background-size: 20px;
    margin: 0;
}
.PrevButtonSlideShowfd:after, .NextButtonSlideshowfd:after {
    display: none !important;
}
.paginationFractionWp {
    position: static;
    font-size: 14px;
    line-height: 100%;
    color: #828282;
}
footer.mnFooterExutionWp {
    margin-top: 116px;
}
.RQ-MnlistPodCastWp {
    margin: 116px 0 0;
}
.ArticlesPodcastEpisodeEach {
    margin: 0 0 30px;
}
.ArticlesPodcastEpisodeEach:last-child {
    margin: 0px;
}
.ArticlesPodcastEpisodeEach>a {
    box-shadow: 4px 4px 13px transparent;
    padding: 20px;
    display: flex;
    align-items: center;
    transition: ease .3s;
}
.ArticleImgWoEspidodePfd {
    position: relative;
    flex: 0 0 303px;
    margin-right: 19px;
}
.ArticleImgWoEspidodePfd img {
    display: block;
    width: 100%;
}
.iconplayepiside {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    margin: auto;
    display: flex;
    justify-content: center;
    transform: translateY(-50%);
    opacity: 0.47;
} 
.iconplayepiside svg {
    width: 58px;
    height: 58px;
}
.TileEpisodeart {
    font-weight: 600;
    font-size: 24px;
    line-height: 140%;
    color: #27235E;
    margin: 0 0 20px;
}
.Exceptarticleep p {
    font-size: 16px;
    line-height: 150%;
    letter-spacing: 0.04em;
    color: #333333;
    opacity: 0.8;
    margin: 0;
}
.Episodehading {
    font-weight: 600;
    font-size: 32px;
    line-height: 140%;
    letter-spacing: 0.02em;
    color: #27235E;
    margin: 0px;
}
.article-template__content.ContentBlockWrapperPodcast {
    max-width: 1112px;
    margin: auto !important;
    padding: 0 24px;
}
.ContentBlockWrapperPodcast iframe {
    margin-bottom: 24px;
    width: 100%;
    height: 500px;
} 
.ContentBlockWrapperPodcast h2 {
    font-weight: 600;
    font-size: 42px;
    line-height: 140%;
    color: #27235E;
    margin: 0 0 24px;
} 
.ContentBlockWrapperPodcast p {
    font-weight: 400;
    font-size: 16px;
    line-height: 150%;
    letter-spacing: 0.04em;
    color: #333333;
    margin: 0;
/*     max-width: 884px; */
} 
.ContentBlockWrapperPodcast.rte a {
    color: #27235E;
    text-decoration: underline !important;
}
.RelatedProductsWrapper {
  margin-top: 116px;
}
.cmbpriceCb {
    width: 100%;
}
.cmbpriceCb .cmbcpprc {
    margin-right: 8px;
    font-weight: 400;
    font-size: 20px;
    line-height: 100%;
    text-decoration-line: line-through;
    color: #333333;
    opacity: 0.8;
}
.cmbpriceCb .cmbprc {
    font-weight: 600;
    font-size: 20px;
    line-height: 100%;
    color: #333333;
    letter-spacing: 0;
}
/* media css start here */

@media (min-width: 750px) {
.ArticlesPodcastEpisodeEach>a:hover {
    box-shadow: 4px 4px 13px rgb(0 0 0 / 25%);
}
}
@media (max-width: 1279px) {
.cmbpriceCb .cmbprc {
    font-size: 14px;
}
.cmbpriceCb .cmbcpprc {
    margin-right: 4px;
    font-size: 14px;
}
.ContentBlockWrapperPodcast h2 {
    font-size: 34px;
}
}
@media (max-width: 1023px) {
.rqPodcstViewMoreBtn a {
    font-size: 14px;
}
.RqNextListVwMre {
    margin: 0 0 16px;
}
.TileEpisodeart {
    font-size: 20px;
    margin: 0 0 10px;
}
.Exceptarticleep p, .ContentBlockWrapperPodcast p {
    font-size: 14px;
}
footer.mnFooterExutionWp, .RelatedProductsWrapper, .RQ-MnlistPodCastWp {
    margin-top: 64px;
}
.ContentBlockWrapperPodcast h2, .hdrel, .Episodehading {
    font-size: 28px;
}
} 

@media (max-width: 749px) {
.rqPodcstViewMoreBtn a {
    font-size: 12px;
    letter-spacing: 0;
}
.ArticleImgWoEspidodePfd img {
    height: 67px;
    object-fit: cover;
}
.breadcrumbs__list {
    margin: 12px 0 24px;
}
.article-template__content.ContentBlockWrapperPodcast {
    padding: 0;
}
.ContentBlockWrapperPodcast iframe {
    margin-bottom: 13px;
    height: 215px;
}
.ContentBlockWrapperPodcast h2 {
    font-size: 20px;
    margin: 0 0 8px;
    padding: 0 24px;
}
.ContentBlockWrapperPodcast p {
    padding: 0 24px;
}
.ArticlesPodcastEpisodeEach>a {
    padding: 0;
}
.iconplayepiside svg {
    width: 40px;
    height: 40px;
}
.iconplayepiside svg path {
    fill: #fff;
    fill-opacity: 1;
}
.iconplayepiside {
    opacity: 1;
}
.ArticleImgWoEspidodePfd {
    flex: 0 0 120px;
    margin-right: 8px;
}
.TileEpisodeart {
    font-weight: 400;
    font-size: 12px;
    color: #333333;
    margin: 0 0 12px;
}
.Episodehading {
    font-size: 20px;
}
.RelatedProductsWrapper {
    padding-right: 0;
}
.hdrel {
    font-size: 20px;
    margin: 0 0 14px;
}
.CollectionRqDataInner spd-img {
    margin: 0 0 12px;
    display: block;
}
.CmbbtRqDt {
    padding: 10px 8px 10px 10px;
    display: block;
}
.RQ-fdc-bk-title {
    font-size: 12px;
    line-height: 18px;
    min-height: 38px;
    margin: 0 0 5px;
}
.RQ-fdc-bk-btn a {
    display: flex;
    line-height: normal;
    height: 38px;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    font-size: 12px;
} 
.PaginationWithFractionRecomm {
    max-width: 100%;
    margin: 12px auto auto;
    padding-right: 24px;
}
.PrevButtonSlideShowfd, .NextButtonSlideshowfd {
    display: none !important;
}
.swiper-pagination .swiper-pagination-bullet.swiper-pagination-bullet-active {
    background: #27235E !important;
}
.swiper-pagination .swiper-pagination-bullet {
    background: #D9D9D9 !important;
    opacity: 1;
    width: 6px;
    height: 6px;
    margin: 0 3px !important;
    outline: none;
    box-shadow: none;
}
.RqArticleCardInfo {
    line-height: 1;
}  
.RqArticleCardInfo span {
    font-size: 12px;
    line-height: 140%;
    color: #333333;
    opacity: .8;
    display: inline-block;
}
.RqArticleCardInfo .circle-divider {
    padding-left: 17px;
    display: none;
}
.RqArticleCardInfo time {
    position: relative;
}
.RqArticleCardInfo time:before {
    content: '';
    background: #333333;
    opacity: .8;
    width: 5px;
    height: 5px;
    border-radius: 100px;
    display: inline-block;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    left: -13px;
}
}
@media (max-width: 400px) {
.ContentBlockWrapperPodcast iframe {
    height: 222px;
}
}
@media (max-width: 375px) {
.ContentBlockWrapperPodcast iframe {
    height: 211px;
}
}

{%- endstyle -%}