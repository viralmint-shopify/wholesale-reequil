<script>
        function getCookie(cname) {
    var name = cname + "=";
    var ca = document.cookie.split(';');
    for (var i = 0; i < ca.length; i++) {
      var c = ca[i];
      while (c.charAt(0) == ' ') {
        c = c.substring(1);
      }
      if (c.indexOf(name) == 0) {
        return c.substring(name.length, c.length);
      }
    }
    return "";
  }

    setTimeout(function() {
 if( getCookie('webinar popup') == 'Popup_cookie'){
     $("body").removeClass("webinarPopup");
 }else{
    $("body").addClass("webinarPopup ");
 }
  
 },3000);
  $(".webinar-image_popup_main .popup__image_inner_main .cross_icon, .webinar-image-text-wrapper").click(function() {
  const d = new Date();
 d.setHours(d.getHours() + 3);
cookievalue = escape("Popup_cookie") + ";"
document.cookie="webinar popup=" + cookievalue;
document.cookie = "expires=" + d + ";"
   $("body").removeClass("webinarPopup ");
});
</script>
    
