{% schema %}
{"name":"Guide Main Blog","tag":"div","class":"RQ-blog-guide","settings":[
    {"type": "text","id": "cta_text","label": "Button"}
]}
{% endschema %}
{%- capture RQBlogGuideArticlesMain -%}{%- liquid
    assign bArsSt = section.settings   
    assign bAr = blog.articles
    assign button = bArsSt.cta_text
    assign loadMode = "jsLazy"
   -%}
<div class="RQ-guideMainSectionWrapper" section="RQ-blog-guide">   
  <div class="RQguideExWP">
    {%- for gud in bAr limit: 1 -%}
    {%- liquid
        assign article_image = gud.image   
        assign title = gud.title
        assign url = gud.url
       -%}      
      <div class="BlogArticlesMainWp">
        {%- if article_image != blank -%}<div class="ArtcileGuideMg">
          <spd-img class="cdv-element show_all" data-imglink="{{ imgLink | default: 0 }}" data-load-mode="{{ loadMode }}">
            <div class="spd-img-wrapper">
            {%- liquid 
              if article_image != blank 
              assign imgWidth = "800" | abs
              assign image = article_image
              assign classes = 'img-primary img-all'
              assign baseSrc = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E" 
              if imgWidth == blank
              assign imgWidth = image.width
              endif
              assign imgUrl = image | image_url: width: imgWidth
              assign imgFit = "contain" | prepend: 'fit-'
              assign imgFitM = bSt.imgFitM | default: 'contain' | prepend: 'fitM-' 
              endif
          -%}
            <img {% if loadMode == 'speedLoad' -%}src="{{ imgUrl }}" {%- else %} src="{{ baseSrc }}" data-src="{{ imgUrl }}" {% endif -%}height="{{ image.height }}" width="{{ image.width }}" class="spd-img-{{ secId }}{{ loopId }}-{% increment imageId %} {{ classes }} {{ loadMode }} {{ imgFit }} {{ imgFitM | default: 'fitM-contain' }}" {{ attributes }} alt=""> 
            </div>
          </spd-img>    
        </div>{%- endif -%}
        {%- if title != blank -%}<div class="AtitleWpgd">{{ title }}</div>{%- endif -%}
        {%- if button != blank -%}<div class="AtitleWpgdButton"><a href="{{ url }}">{{ button }}</a></div>{%- endif -%}
      </div>
    {%- endfor -%}  
  </div>
</div>{%- endcapture -%}{{ RQBlogGuideArticlesMain | strip_newlines }}