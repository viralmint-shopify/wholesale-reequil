  </div>
</div>
 {% endif %}
{% schema %}
  {
    "name": "Chat Box Content",
    "settings": [
              {
          "type": "textarea",
          "id": "heading2",
          "label": "Heading"
        },
              {
          "type": "text",
          "id": "ph_number",
          "label": "Contact Number"
        },
                    {
          "type": "text",
          "id": "sp_text",
          "label": "Second popup Bottom"
        }
    ],
      "blocks": [
    {
      "type": "chatpopup",
      "name": "Chat Box Content",
      "settings": [
                {
          "type": "text",
          "id": "custom_class",
          "label": "Custom Class"
        },
        {
          "type": "image_picker",
          "id": "chat_box_icon",
          "label": "Chat Box Content Icon"
        },
        {
          "type": "text",
          "id": "chat_box_text",
          "label": "Chat Box Content"
        },
                {
          "type": "url",
          "id": "chat_box_text_url",
          "label": "Chat Box Content URL"
        }
      ]
    }
  ]
  }
{% endschema %}