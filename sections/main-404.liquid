{% schema %}
{"name": "RQ 404 Banner","tag":"div","class":"main-404","settings": [
    {"type":"header","content":"Heading"},
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"text","id":"heading","label":"Heading"},
        {"type":"textarea","id":"description","label":"Description"},
    {"type":"header","content":"CTA Button"},
        {"type":"text","id":"cta_button","label":"CTA Button"},
        {"type":"url","id":"cta_link","label":"CTA Link"}
]}
{% endschema %}
{%- liquid
    assign sEs = section.settings
    assign loadMode = "jsLazy"
    assign image = sEs.image
    assign heading = sEs.heading
    assign description = sEs.description
    assign cta_text = sEs.cta_button
    assign cta_link = sEs.cta_link
    %}
{% capture MainErrorContentInt %}<div class="RQErrorMainBannerWrapper" section="main-404">
  <div class="RqErrorInnerWrap">
    <div class="RqErrorBannerMg">
      <spd-img class="cdv-element" data-imglink="{{ imgLink | default: 0 }}" data-load-mode="{{ loadMode }}">
        <div class="spd-img-wrapper">
        {%- liquid 
          if image != blank
          assign imgWidth = "500" | abs
          assign image = image
          assign classes = 'img-primary img-all'
          assign baseSrc = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E" 
          if imgWidth == blank
          assign imgWidth = image.width
          endif
          assign imgUrl = image | image_url: width: imgWidth
          assign imgFit = "contain" | prepend: 'fit-'
          assign imgFitM = bSt.imgFitM | default: 'contain' | prepend: 'fitM-' 
          endif
      -%}
        <img {% if loadMode == 'speedLoad' -%}src="{{ imgUrl }}" {%- else %} src="{{ baseSrc }}" data-src="{{ imgUrl }}" {% endif -%}height="{{ image.height }}" width="{{ image.width }}" class="spd-img-{{ secId }}{{ loopId }}-{% increment imageId %} {{ classes }} {{ loadMode }} {{ imgFit }} {{ imgFitM | default: 'fitM-contain' }}" {{ attributes }} alt=""> 
        </div>
      </spd-img>
    </div>
    <div class="MainContentErrorPage">{% if heading != blank %}<div class="RqErrorHeading">{{ heading }}</div>{% endif %}
    {% if description != blank %}<div class="RqErorrDescrition">{{ description }}</div>{% endif %}
    {% if cta_text != blank %}<div class="RqErrorCtaText"><a href="{{ cta_link | default:'/' }}">{{ cta_text }}</a></div>{% endif %}</div>
  </div>
</div>{% endcapture %}{{ MainErrorContentInt }}