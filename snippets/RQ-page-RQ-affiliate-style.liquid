{%- style -%}
.RQAffiliateWP {
    padding: 40px 24px 0px;
    max-width: 1112px;
    margin: auto;
    position: relative;
}
.Wpsdhd {
    text-align: center;
    margin: 0 0 30px;
    font-size: 48px;
    color: #27235e;
}
.swiper-pagination.paginationSlideshowbanner {
    font-size: 0;
    margin: 24px auto 0;
    bottom: auto;
}
.swiper-pagination .swiper-pagination-bullet.swiper-pagination-bullet-active {
    background: #27235E !important;
}
.swiper-pagination .swiper-pagination-bullet {
    background: #D9D9D9 !important;
    opacity: 1;
    width: 6px;
    height: 6px;
    margin: 0 3px !important;
    outline: none;
    box-shadow: none;
}
.swiper-button-next.arrsdnxt {
    display: block;
    width: 32px;
    height: 32px;
    background-image: url(https://cdn.shopify.com/s/files/1/0306/6262/3364/files/arrow-right.png?v=1673261335);
    right: -30px;
    background-repeat: no-repeat;
}
.swiper-button-prev.arrsdprev {
    display: block;
    width: 32px;
    height: 32px;
    background-image: url(https://cdn.shopify.com/s/files/1/0306/6262/3364/files/arrow-left.png?v=1673261335);
    left: -30px;
    background-repeat: no-repeat;
}
.swiper-button-prev.arrsdprev:after, .swiper-button-next.arrsdnxt:after {
    display: none !important;
}
.mySwiper {
    position: static;
}
.RQAffiliateiconBkWP {
    padding: 50px 24px 12px;
    max-width: 1112px;
    margin: auto;
    position: relative;
}
.RQ-affiliateContentSectionWrapper {
    max-width: 1112px;
    margin: auto;
    position: relative;
    padding: 64px 24px 0;
}
.RQAffiliateContentWP {
    text-align: center;
}
.RQaffconhd {
    font-size: 52px;
    color: #333;
    line-height: 64px;
    margin: 0 0 15px;
}
.RQaffconshd {
    color: #828282;
    font-size: 16px;
}
.ButtonAffwp {
    text-align: center;
}
.WpSlideImageEx {
    position: relative;
}
.CoverMg .spd-img-wrapper {
    height: 100%;
    width: 100%;
    display: flex;
    padding-bottom: 46%;
    overflow: hidden;
}
.CoverMg {
    display: block;
    overflow: hidden;
    position: relative;
}
.CoverMg img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
}
.PlayIconVd {
    display: flex;
    align-items: center;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    left: 0;
    right: 0;
    margin: auto;
    text-align: center;
    justify-content: center;
    cursor: pointer;
}
.WpSlideImageEx .js-product-video {
    position: absolute;
    background: #fff;
    display: none;
}
.WpSlideImageEx .js-product-video.active {
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    display: flex;
}
.RQaffconBtn a, .ButtonAffwp a {
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    display: inline-block;
    text-transform: uppercase;
    color: #FFFFFF;
    background: #27235E;
    padding: 13px 5px;
    width: 100%;
    max-width: 198px;
    margin-top: 30px;
    text-align: center;
    box-sizing: border-box;
}
.RQaffconBtn a:hover, .ButtonAffwp a:hover {
    background: #524f7e;
}
.RQafficbhd {
    color: #27235e;
    text-align: center;
    font-size: 32px;
    text-transform: capitalize;
    margin: 0 0 8px;
}
.RQafficbshd {
    text-align: center;
    color: #828282;
    font-size: 16px;
}
.BlockMainContainerAffiliateIbk {
    margin: 40px 0 0 -30px;
    display: flex;
    flex-wrap: wrap;
}
.IConTextBlokhng {
    width: 33.33%;
    padding: 0 0 30px 30px;
}
.IconBlockWpMn {
    height: 100%;
    border: 2px solid rgba(39,35,94,.1);
    padding: 35px 25px;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    min-height: 350px;
}
.IconmmgAft {
    width: 60px;
    height: 60px;
    background-color: #ececec;
    border-radius: 50%;
    padding: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 10px;
}
.IconmmgAft img {
    width: 36px;
}
.RQafficontxthd {
    color: #27235e;
    font-size: 28px;
    margin: 0 0 20px;
    line-height: 33.6px;
    width: 100%;
    text-align: center;
}
.RQafficontxtshd p {
    text-align: center;
    margin: 0 0 10px;
    color: #828282;
    font-size: 16px;
    letter-spacing: 0.2px;
    line-height: 24px;
}
.RQafficontxtBtn {
    text-align: center;
    width: 100%;
    margin-top: 2px;
}
.RQafficontxtBtn a {
    color: #27235e;
    text-transform: capitalize;
    text-decoration: underline;
}

/* media css start here */
@media (max-width: 1350px) {
.Wpsdhd {
    font-size: 40px;
}
.RQaffconhd {
    font-size: 44px;
    line-height: 54px;
}
}
@media (max-width: 1279px) {
.RQAffiliateWP {
    max-width: 950px;
}
.swiper-button-next.arrsdnxt {
    right: -20px;
}
.swiper-button-prev.arrsdprev {
    left: -20px;
}
}
@media (max-width: 1023px) {
.RQAffiliateWP {
    max-width: 730px;
}
.swiper-button-next.arrsdnxt {
    right: -10px;
}
.swiper-button-prev.arrsdprev {
    left: -10px;
}
.Wpsdhd {
    font-size: 30px;
}
}
@media (max-width: 991px) {
.RQAffiliateiconBkWP {
    padding: 50px 20px 0px;
}
.RQafficbshd {
    font-size: 14px;
}
.IConTextBlokhng {
    width: 50%;
}
.IConTextBlokhng:last-child {
    width: 100%;
}
.RQafficontxtshd p {
    font-size: 14px;
    line-height: 21px;
}
.RQafficontxtBtn a {
    font-size: 14px;
} 
}
@media (max-width: 749px) {
.CoverMg .spd-img-wrapper {
    padding-bottom: 125%;
}
.IConTextBlokhng {
    width: 100%;
    padding-left: 0;
    padding-bottom: 40px;
}
footer.mnFooterExutionWp {
    margin-top: 12px;
}
.RQAffiliateiconBkWP {
    padding: 40px 20px 0px;
}
.RQafficbhd {
    font-size: 24px;
}
.BlockMainContainerAffiliateIbk {
    margin: 20px 0 0px;
}
.breadcrumbs__list {
    margin: 12px 0;
    padding: 0;
}
.swiper-button-next.arrsdnxt {
    right: 10px;
}
.swiper-button-prev.arrsdprev {
    left: 10px;
}
.RQAffiliateWP {
    padding: 0px 0 0;
}
.Wpsdhd {
    font-size: 24px;
    padding: 0 20px;
    margin-bottom: 15px;
}
.ButtonAffwp a {
    margin-top: 15px;
}
.RQ-affiliateContentSectionWrapper {
    padding: 44px 20px 0;
}
.RQaffconhd {
    font-size: 28px;
    line-height: 33px;
    margin: 0 0 11px;
}
.RQaffconshd {
    max-width: 270px;
    margin: auto;
    font-size: 14px;
}
.RQaffconBtn a, .ButtonAffwp a {
    max-width: 178px;
    margin-top: 20px;
}
}
  
{%- endstyle -%}