{%- liquid
  if sSt.contentHeader
    assign head_content = content_for_header | remove_first: '<' | replace: ' < ', ' -psoc-%3C ' | replace: '</', '-psoc-%3C/' | split: '<'
    for tag in head_content
      if tag contains 'script ' and tag contains ' src=' and tag contains 'shopifycloud/shopify/'
        echo tag | remove_first: 'script ' | remove: '>-psoc-%3C/script>' | replace: "'", "'" | strip | prepend: "<script>extArr.push('" | append: "');</script>"
      elsif tag contains 'BarInjector'
        echo tag | replace_first: ')', 'pso-)' | split: 'pso-)' | last | split: ');-psoc-%3C/script>' | first | strip | prepend: '<script> let shopBarLoad=()=>' | append: '; barArr.push(shopBarLoad);</script>'
      elsif tag contains 'asyncLoad' and sSt.debug
        echo '<!-- asyncLoad disabled -->'
      elsif tag contains 'asyncLoad'
        assign asyncScripts = tag | replace_first: '["', 'pso-["' | replace: '"]', '"pso-]' | split: 'pso-[' | last | split: 'pso-]' | first | split: ',' | uniq
        assign scripExcludes = sSt.scr_excl | split: ','
        for txf in asyncScripts
         assign afPush = txf | strip | prepend: '<script>afUrls.push(' | append: ');</script>'
          for exc in scripExcludes
            if txf contains exc
              assign afPush = ''
              endif
          endfor
          echo afPush
        endfor
      else
        echo tag | replace: '-psoc-%3C', '<' | prepend: '<'
      endif  
    endfor
  else 
  echo content_for_header
  endif 
  if sSt.favicon != blank
    echo sSt.favicon | image_url: width: 32, height: 32 | prepend: '<link rel="icon" type="image/png" href="' | append: '">'
  endif
-%}

