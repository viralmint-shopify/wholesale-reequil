{% schema %}
{"name": "RQ Podcast Listing","tag":"div","class":"RqProdcastListingTemplate","settings": [
    {"type":"header","content":"Heading"},
        {"type":"text","id":"heading","label":"Heading"},
        {"type":"liquid","id":"title","label":"Title"},
        {"type":"liquid","id":"descripiton","label":"Descripiton"},
        {"type":"liquid","id":"featured_month_podcast","label":"Featured Podcast"},
    {"type":"text","id":"All_espisode_heading","label":"Articles main heading"}
]}
{% endschema %}
{%- capture MainPodCastListingTemplate-%}{%- liquid
    assign sabts = section.settings
    assign heading = sabts.heading
    assign title = sabts.title
    assign description = sabts.descripiton
    assign featured_podcast = sabts.featured_month_podcast
    assign EpisodeHeading = sabts.All_espisode_heading
    assign loadMode = "jsLazy"
    %}
<div class="RQ-MainListingpodcastTemWp" section="RQ-podcast-listing"> 
  <div class="RQ-MnlistPodCastWp">     
    <div class="MainHeaderPodcastLster">
      <div class="CombinedetailOfPodcast">{%- if heading != blank -%}<div class="subheadingpodcast">{{ heading }}</div>{%- endif -%}
      {%- if title != blank -%}<div class="headingpodcast">{{ title }}</div>{%- endif -%}
      {%- if description != blank -%}<div class="Descriptionpodcast show_des">{{ description }}</div>{%- endif -%}</div>
      {%- if featured_podcast != blank -%}<div class="IframePodcastFeatured">{{ featured_podcast }}</div>{%- endif -%}
      <div class="CombinedetailOfPodcast mbdatre">{%- if description != blank -%}<div class="Descriptionpodcast show_mb">{{ description }}</div>{%- endif -%}</div>
    </div>
    <div class="EpisodesPodcastListArticalWp">
      {%- paginate blog.articles by 6 -%}      
      <div class="ExecuteMainPodcastWrapperWxt">
        {%- if EpisodeHeading != blank -%}<div class="Episodehading">{{ EpisodeHeading }}</div>{%- endif -%}
        <div class="AllEpisodeEachMainWp">
          {%- for article in blog.articles -%}
            <div class="ArticlesPodcastEpisodeEach">
              <a href="{{ article.url }}">
                <div class="ArticleImgWoEspidodePfd">
                  <spd-img class="cdv-element show_all" data-imglink="{{ imgLink | default: 0 }}" data-load-mode="{{ loadMode }}">
                  <div class="spd-img-wrapper">
                  {%- liquid 
                    if article.image != blank
                    assign imgWidth = "800" | abs
                    assign image = article.image
                    assign classes = 'img-primary img-all'
                    assign baseSrc = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E" 
                    if imgWidth == blank
                    assign imgWidth = image.width
                    endif
                    assign imgUrl = image | image_url: width: imgWidth
                    assign imgFit = "contain" | prepend: 'fit-'
                    assign imgFitM = bSt.imgFitM | default: 'contain' | prepend: 'fitM-' 
                    endif
                  -%}
                  <img {% if loadMode == 'speedLoad' -%}src="{{ imgUrl }}" {%- else %} src="{{ baseSrc }}" data-src="{{ imgUrl }}" {% endif -%}height="{{ image.height }}" width="{{ image.width }}" class="spd-img-{{ secId }}{{ loopId }}-{% increment imageId %} {{ classes }} {{ loadMode }} {{ imgFit }} {{ imgFitM | default: 'fitM-contain' }}" {{ attributes }} alt=""> 
                  </div>
                 </spd-img>
                </div>
                <div class="MainConeEpisode">
                  <div class="TileEpisodeart">{{ article.title }}</div>
                  <div class="RqArticleCardInfo show_mb">
                      <span class="RqArticleDate">{{ article.published_at | date: "%d. %m. %Y" }}</span>
                      <span class="circle-divider">
                      {%- assign words = article.content | strip_html | split:' ' -%}
                      {%- assign readtime = words.size | divided_by: 180 | round | at_least: 1 -%}
                      {%- if words < 360 -%}
                        <time>1 Min</time>
                      {%- else -%} 
                        <time>{{ readtime }} Mins</time>
                      {%- endif -%}  
                      </span>
                  </div>                  
                  {%- if article.excerpt.size > 0 or article.content.size > 0 -%}<div class="Exceptarticleep">
                    <p>
                      {%- if article.excerpt.size > 0 -%}
                        {{ article.excerpt | strip_html | truncatewords: 30 }}
                      {%- else -%}
                        {{ article.content | strip_html | truncatewords: 30 }}
                      {%- endif -%}
                    </p>
                  </div>{%- endif -%}
                  <div class="iconplayepiside"><svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M18 36C27.9411 36 36 27.9411 36 18C36 8.05887 27.9411 0 18 0C8.05887 0 0 8.05887 0 18C0 27.9411 8.05887 36 18 36ZM13.6731 25.2411L25.6154 18.3462L13.6731 11.4513L13.6731 25.2411Z" fill="#27235E"/></svg></div>
                </div>
              </a>
            </div>
          {%- endfor -%}
        </div>
      {%- if paginate.pages > 1 -%}
      {%- render 'article-pagination', paginate: paginate -%}
      {%- endif -%}                     
      </div>
    {%- endpaginate -%}                       
    </div>
  </div>
</div>{%- endcapture -%}{{ MainPodCastListingTemplate | strip_newlines }}