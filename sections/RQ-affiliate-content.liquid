{% schema %}
{"name": "RQ affiliate content","tag":"div","class":"RQ-affiliate-content","settings": [
    {"type":"header","content":"Heading"},
        {"type":"text","id":"heading","label":"Heading"},
        {"type":"textarea","id":"sub_heading","label":"Sub heading"},
        {"type":"text","id":"cta_text","label":"Button"},
        {"type":"url","id":"cta_link","label":"Link"}
],"presets":[{"name":"RQ affiliate content"}],"templates":["page"]}
{% endschema %}
{%- capture MainAffiliateContentSection -%}{%- liquid
    assign SafCtSt = section.settings 
    assign heading = SafCtSt.heading
    assign sub_heading = SafCtSt.sub_heading
    assign cta_text = SafCtSt.cta_text
    assign cta_link = SafCtSt.cta_link
   -%}
<div class="RQ-affiliateContentSectionWrapper" section="RQ-affiliate-content">   
  <div class="RQAffiliateContentWP">
    {%- if heading != blank -%}<div class="RQaffconhd">{{ heading }}</div>{%- endif -%}
    {%- if sub_heading != blank -%}<div class="RQaffconshd">{{ sub_heading }}</div>{%- endif -%}
    {%- if cta_text != blank -%}<div class="RQaffconBtn"><a href="{{ cta_link | default:'#' }}">{{ cta_text }}</a></div>{%- endif -%}
  </div>
</div>{%- endcapture -%}{{ MainAffiliateContentSection | strip_newlines }}