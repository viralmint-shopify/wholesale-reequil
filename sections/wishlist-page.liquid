<div class="WrapperPageDefaultLayout">

  <div class="ContentPageDefault">
    {{ page.content }}
     <div id="wishlist-items-container"></div>
    <div class="wishlist_blank_message" style="display:none;">
      <div class="bag_svg_image">
        <svg width="200" height="200" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
<circle cx="100" cy="100" r="100" fill="#F5F5F5"/>
<rect x="45.5" y="35" width="110.575" height="110.575" fill="url(#pattern0)"/>
<defs>
<pattern id="pattern0" patternContentUnits="objectBoundingBox" width="1" height="1">
<use xlink:href="#image0_3806_5711" transform="scale(0.00195312)"/>
</pattern>
<image id="image0_3806_5711" width="512" height="512" xlink:href="data:image/png;base64,"/>
</defs>
</svg>
      </div>
  <div class="blank_message">
    <h2>Your Wishlist is Empty !</h2>
    <p>Tap the heart icon to save your favourite products for later.</p>
  </div>
  <div class="explore_more_btn">
    <a  class="button button--full-width button--secondary" href="/collections/all">Explore Now</a>
  </div>
    </div>
  </div>
</div>
<!-- Swym Wishlist render JS + CSS -->
<script src="{{ 'swym-custom-wishlist.js' | asset_url }}" async="async"></script>
