/* christmas banner css start */
.home_ani_inner_wrapp {
    margin: 0 0 40px;
}
.ani_heading_wrapp {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding: 0 16px;
    text-align: left;
    width: 86.5%;
    margin: auto;
}
.image_anima_text img {
    width: 100%;
    display: block;
}
.image_anima_text {
    position: relative;
} 
.ani_heading_wrapp .animated_banner_heading {
    color: #27235e;
    font-size: 52px;
    font-weight: 600;
    line-height: 120%;
    letter-spacing: -1.04px;
    margin: 10% 0 0;
    display: inline-block;
    animation-name: blinkerText;
    animation-duration: 3s;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    background: url(https://cdn.shopify.com/s/files/1/0306/6262/3364/files/hpnTextbg.jpg?v=1703660820), gray 50% / cover no-repeat;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: #fff;
} 
@keyframes blinkerText {
0% {
    -webkit-text-fill-color: transparent;
    background: url(https://cdn.shopify.com/s/files/1/0306/6262/3364/files/hpnTextbg.jpg?v=1703660820), gray 50% / cover no-repeat;
    background-clip: text;
    -webkit-background-clip: text;
}
50% {
    -webkit-text-fill-color: transparent;
    background: url(https://cdn.shopify.com/s/files/1/0306/6262/3364/files/hpnTextbg2.jpg?v=1703660820), gray 50% / cover no-repeat;
    background-clip: text;
    -webkit-background-clip: text;
}
 100% {
    -webkit-text-fill-color: transparent;
    background: url(https://cdn.shopify.com/s/files/1/0306/6262/3364/files/hpnTextbg.jpg?v=1703660820), gray 50% / cover no-repeat;
    background-clip: text;
    -webkit-background-clip: text;
}
}
/* christmas banner css end */
