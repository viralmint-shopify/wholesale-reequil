{%- style -%}
.RQ-collectionfqMnWrapper {
    padding: 26px 20px 0px;
    max-width: 1104px;
    margin: auto;
    position: relative;
}
.RQ-pds-hd {
    font-size: 32px;
    line-height: 38px;
    color: #27235e;
    margin: 0 0 10px;
}
.RQ-pds-ds {
    color: #333;
    font-size: 16px;
}
.RQ-pds-ds a {
    color: #27235e;
}
.RQ-pds-bk-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20.5px 18px 20.5px 0px;
    position: relative;
    transition: all .6s;
    cursor: pointer;
    color: #27235E;
    font-weight: 600;
    font-size: 18px;
}
.RQ-sdBlockEachQ {
    border-bottom: 0.5px solid #E0E0E0;
}
.RQ-sdBlockEachQ:first-child {
    border-top: 0.5px solid #E0E0E0;
}
.minusicon, .RQ-sdBlockEachQ.active .addicon {
    display: none;
}
.addicon, .RQ-sdBlockEachQ.active .minusicon {
    display: flex;
    align-items: center;
}
.RQ-sd-hd-dsQ {
    margin: 0 0 40px;
}
.RQ-pds-bk-dsc {
    padding: 0 0px 20px;
}
.RQ-pds-bk-dsc p {
    color: #333;
    font-size: 16px;
    letter-spacing: 0.2px;
    line-height: 24px;
    margin: 0 0 16px;
    word-wrap: break-word;
}
.RQ-pds-bk-dsc p:last-child {
    margin: 0px;
}
.RqProductWrappedscfq {
    display: none;
}
.RQ-sdBlockEachQ.active .RqProductWrappedscfq {
    display: block;
}

/* media css start here */

@media (max-width: 749px) {
.RQ-pds-bk-dsc {
    padding: 4px 0px 20px;
}
.RQ-pds-bk-dsc p {
    font-size: 14px;
}
.RQ-pds-bk-title {
    padding: 15px 10px 15px 0px;
    font-size: 14px;
}
.RQ-pds-bk-title svg {
    width: 24px;
    height: 24px;
}
.RQ-sd-hd-dsQ {
    margin: 0 0 24px;
    text-align: center;
}
.RQ-pds-hd {
    font-size: 24px;
    line-height: 28px;
}
.RQ-pds-ds {
    font-size: 14px;
}
}

  
{%- endstyle -%}